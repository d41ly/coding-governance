   "draft": "# tools/run-gates/proctable.py -- the one normalized view of the live process table.\nimport datetime, json, os, shutil, subprocess\n\nREAD_TIMEOUT = 120      # owner: profile_bar.check_quiet's CIM call; bind it, do not invent another\nWALK_DEPTH = 8          # owner: run-gates.sh scan_descendants\n_CIM = (\"Get-CimInstance Win32_Process | Select-Object ProcessId,ParentProcessId,Name,\"\n        \"CommandLine,CreationDate,KernelModeTime,UserModeTime | ConvertTo-Json -Compress\")\n\n\ndef _num(s):\n    return s.isdigit()  # a fragment of a raw multi-line argv fails this; same rule as the awk guard\n\n\ndef _run(runner, argv):\n    return runner(argv, capture_output=True, text=True, timeout=READ_TIMEOUT,\n                  encoding=\"utf-8\", errors=\"replace\")\n\n\ndef _win_rows(runner):\n    ps = shutil.which(\"powershell\") or shutil.which(\"pwsh\")\n    if not ps:\n        return None, \"no powershell on PATH, cannot read the Windows table\"\n    out = _run(runner, [ps, \"-NoProfile\", \"-NonInteractive\", \"-Command\", _CIM])\n    if out.returncode != 0:\n        return None, \"CIM query exited %s\" % out.returncode\n    data = json.loads(out.stdout or \"[]\")\n    return (data if isinstance(data, list) else [data]), \"\"\n\n\ndef _cyg_rows(runner, bash):\n    # ps -W: PID PPID PGID WINPID TTY UID STIME COMMAND\n    out = _run(runner, [bash, \"-c\", \"ps -W\"])\n    rows = {}\n    for line in (out.stdout or \"\").splitlines()[1:]:\n        f = line.split(None, 7)\n        if len(f) < 4 or not all(_num(x) for x in f[:4]):\n            continue  # not a whole process: a continuation line or a header\n        rows[int(f[3])] = {\"cyg_pid\": int(f[0]), \"cyg_ppid\": int(f[1])}\n    return rows\n\n\ndef snapshot(bash=\"\", _runner=None, _now=None):\n    \"\"\"Returns (state, detail, rows). state in true|unverified. Never raises.\n    `_runner` is the subprocess seam for the self-test, not a knob.\"\"\"\n    runner = _runner or subprocess.run\n    now = _now or datetime.datetime.now(datetime.timezone.utc)\n    try:\n        win, why = _win_rows(runner)\n        if win is None:\n            return \"unverified\", why, []\n        cyg = _cyg_rows(runner, bash) if bash else {}\n    except Exception as exc:\n        return \"unverified\", \"process read failed: %s\" % exc, []\n    rows = []\n    for w in win:\n        pid, ppid = w.get(\"ProcessId\"), w.get(\"ParentProcessId\")\n        if not isinstance(pid, int) or not isinstance(ppid, int):\n            continue\n        c = cyg.get(pid, {})\n        rows.append({\"pid\": pid, \"ppid\": ppid, \"cyg_pid\": c.get(\"cyg_pid\"),\n                     \"cyg_ppid\": c.get(\"cyg_ppid\"),\n                     \"namespaces\": \"win+cyg\" if c else \"win\",\n                     \"name\": w.get(\"Name\") or \"\", \"cmd\": w.get(\"CommandLine\") or \"\",\n                     \"age_s\": _age(w.get(\"CreationDate\"), now),\n                     \"cpu_s\": ((w.get(\"KernelModeTime\") or 0) + (w.get(\"UserModeTime\") or 0)) / 1e7})\n    mine = [r for r in rows if r[\"pid\"] == os.getpid()]\n    if not mine or not mine[0][\"cmd\"].strip():\n        return \"unverified\", \"read %d row(s) but not this process's own command line\" % len(rows), rows\n    return \"true\", \"read %d row(s), %d joined to a cygwin pid\" % (len(rows), len(cyg)), rows\n\n\ndef descendants(rows, root, key=\"ppid\", id_key=\"pid\"):\n    out, frontier = {root}, {root}\n    for _ in range(WALK_DEPTH):\n        frontier = {r[id_key] for r in rows if r.get(key) in frontier and r[id_key] not in out}\n        if not frontier:\n            break\n        out |= frontier\n    return out\n",
