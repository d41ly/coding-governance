   "draft": "# ---- the declaration, read once, BEFORE the width split, so the outer pool can be clamped to it\nPOP=$(read_population)\nNROWS=$(printf '%s' \"$POP\" | grep -c . || true)\n\nW=$(bash \"$HERE/run-gates.sh\" --print-profile 2>/dev/null | awk -F'\\t' '$1==\"width\"{print $2}')\ncase \"${W:-}\" in ''|*[!0-9]*) W=2 ;; esac\n# THE COMPOSITE BOUND, re-divided now that the loop is concurrent: outer x inner <= W.\nOUTER=$W; [ \"$OUTER\" -le \"${NROWS:-0}\" ] || OUTER=$NROWS; [ \"$OUTER\" -ge 1 ] || OUTER=1\nexport SELFTEST_INNER_WIDTH=$(( W / OUTER )); [ \"$SELFTEST_INNER_WIDTH\" -ge 1 ] || SELFTEST_INNER_WIDTH=1\n\n# ... --check / --list / liveness unchanged ...\n\nstates=(); names=(); budgets=(); argvs=()\nwhile IFS=$'\\t' read -r state name budget argv; do\n  [ -n \"${name:-}\" ] || continue\n  states+=(\"$state\"); names+=(\"$name\"); budgets+=(\"$budget\"); argvs+=(\"$argv\")\ndone <<EOF\n$POP\nEOF\nn=${#names[@]}\nWORK=$(mktemp -d) || { echo \"run-selftests: cannot create a scratch dir\" >&2; exit 2; }\ntrap 'rm -rf \"$WORK\"' EXIT\n# wait -n returns the REAPED job's status, so availability is probed once (lib-selftest.sh _st_waitn)\nwaitn=0; ( : & wait -n ) >/dev/null 2>&1 && waitn=1\n\nrun_one() {   # index -> $WORK/<i>.out, then ATOMICALLY $WORK/<i>.done = \"rc<TAB>secs\"\n  local i=$1 s=$EPOCHSECONDS rc\n  eval \"${argvs[$i]}\" </dev/null >\"$WORK/$i.out\" 2>&1; rc=$?\n  printf '%s\\t%s\\n' \"$rc\" \"$(( EPOCHSECONDS - s ))\" > \"$WORK/$i.done.tmp\" \\\n    && mv -f \"$WORK/$i.done.tmp\" \"$WORK/$i.done\"\n}\n\nst=0; ran=0; over=0\nreport() {\n  local i=$1 rc took\n  if [ \"${states[$i]}\" != ok ]; then\n    st=1\n    printf 'FAIL  %-46s        (%s: this row could not be resolved into a runnable suite)\\n' \"${names[$i]}\" \"${states[$i]}\"\n    return\n  fi\n  ran=$((ran + 1))\n  IFS=$'\\t' read -r rc took < \"$WORK/$i.done\"\n  if [ \"$rc\" -eq 0 ]; then printf 'ok    %-46s %5ss\\n' \"${names[$i]}\" \"$took\"\n  else\n    st=1\n    printf 'FAIL  %-46s %5ss  (exit %s)\\n' \"${names[$i]}\" \"$took\" \"$rc\"\n    grep -E '^(FAIL|nope|.*FAILED)' \"$WORK/$i.out\" | head -4 | sed 's/^/        /'\n  fi\n  if [ \"$took\" -gt \"${budgets[$i]}\" ]; then\n    st=1; over=$((over + 1))\n    printf '      OVER BUDGET  %s took %ss against a declared %ss — fix it, or re-declare it with a reason beside the number\\n' \"${names[$i]}\" \"$took\" \"${budgets[$i]}\"\n  fi\n}\nflush() {     # report every leading index that has a result, in DECLARATION order\n  while [ \"$next\" -lt \"$n\" ] && { [ \"${states[$next]}\" != ok ] || [ -f \"$WORK/$next.done\" ]; }; do\n    report \"$next\"; next=$((next + 1))\n  done\n}\n\necho \"run-selftests: $NROWS suite(s), declared total $(( (TOTAL + 59) / 60 )) minutes, width $W (outer $OUTER, inner $SELFTEST_INNER_WIDTH)\"\ni=0; live=0; next=0\nwhile [ \"$i\" -lt \"$n\" ]; do\n  if [ \"${states[$i]}\" = ok ]; then run_one \"$i\" & live=$((live + 1)); fi\n  i=$((i + 1))\n  if [ \"$live\" -ge \"$OUTER\" ]; then\n    if [ \"$waitn\" = 1 ]; then wait -n; live=$((live - 1)); else wait; live=0; fi\n  fi\n  flush\ndone\nwait\nflush\n\n# run-selftests.test.sh, fixture lines (W falls back to 2 in the fixture: no run-gates.sh is copied)\n#   printf 'slow one\\t60\\tbash tools/suite-slow.sh\\tmeasured 3s on node t 2026-10-18, x1.5\\n' (inserted FIRST)\n#   arm \"a slow FIRST row is still reported first, whatever finished before it\" 0 \"ok    slow one\" ...\n#   arm \"the header names the outer pool the run used\" 0 \"(outer 2, inner 1)\" 'true' \"$R\"",
