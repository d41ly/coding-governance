\": [  # terminal arms, lifted verbatim from quiz-intake descriptors.json:24619-24790\n            {\"node\": \"when\", \"test\": \"remote.checkout_url\", \"op\": \"not_empty\", \"children\": [\n                {\"node\": \"Stack\", \"props\": {\"gap\": 4}, \"children\": [\n                    {\"node\": \"primitive\", \"name\": \"Chip\", \"props\": {\"tone\": \"neutral\", \"dot\": True},\n                     \"children\": [_text(\"Taking you to checkout\")]},\n                    {\"node\": \"primitive\", \"name\": \"Text\", \"props\": {\"size\": \"sm\", \"tone\": \"muted\"},\n                     \"children\": [_text(\"Taking you to our payment provider to finish securely.\")]}]}],\n             \"else\": [\"...plan-updated / could-not-start arms, copied once into this builder...\"]},\n        ],\n    }\n\ndef build_account_arm():\n    # replaces the choosePlan link card in account-area's `is_customer eq false` arm\n    return {\"node\": \"when\", \"test\": \"remote.is_customer\", \"op\": \"eq\", \"value\": \"false\", \"children\": [\n        {\"node\": \"Stack\", \"props\": {\"gap\": 2}, \"part\": \"nc-acct-medinvite\", \"children\": [\n            {\"node\": \"primitive\", \"name\": \"Heading\", \"props\": {\"level\": \"h2\", \"size\": \"card\"},\n             \"children\": [_text({\"path\": \"choosePlanTitle\"})]},\n            {\"node\": \"primitive\", \"name\": \"Text\", \"props\": {\"size\": \"xs\", \"tone\": \"muted\"},\n             \"children\": [_text({\"path\": \"choosePlanSettlingLine\"})]},\n            # check 17: needs a bare-truthy ancestor on remote.data.is_eligible -- NO such read exists in session\n            {\"node\": \"when\", \"test\": \"remote.data.is_eligible\", \"children\": [build_checkout(\"card\")]},\n        ]}]}\n\ndef main(check):\n    ds = json.loads(DESCRIPTORS.read_text(encoding=\"utf-8\"))\n    # find exactly one remoteForm on ROUTE per slug, compare to build_checkout(), write or FAIL (gen_product_card._find_each / _floor shape)\n    ...\n\n# tests/test_v3_account_entitlement.py -- AC2 inverts once the owner supersedes PKG-bGildedVestibule-2\ndef test_ac2_the_lead_arm_sells_only_behind_eligibility(account_area):\n    arm = json.dumps(account_area[\"tree\"])\n    assert '\"/create_subscription\"' in arm\n    assert '\"test\": \"remote.data.is_eligible\"' in arm\n\n# scripts/check_package_refs.py REDIRECT_HOSTS (check 16, exact equality both ways)\n#   (\"account-area\", \"patient\", \"/create_subscription\"): (\"checkout.stripe.com\", \"Stripe hosted checkout\"),\n",
