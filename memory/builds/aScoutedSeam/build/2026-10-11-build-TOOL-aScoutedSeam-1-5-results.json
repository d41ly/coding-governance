   "draft": "#!/usr/bin/env bash\n# Runnable check for the portable agent-cap.js Workflow fan-out guard.\nset -u\nHOOK=\"$(cd \"$(dirname \"$0\")\" && pwd)/agent-cap.js\"\nROOT=\"$(cd \"$(dirname \"$0\")/../..\" && pwd)\"\nTMP=$(mktemp -d); trap 'rm -rf \"$TMP\"' EXIT\npass=0; fail=0\n\n# existing arms keep their shape; stderr goes to the scratch dir, not a shared /tmp file\ncheck() { # name expected_exit json\n  printf '%s' \"$3\" | node \"$HOOK\" >/dev/null 2>\"$TMP/err\"; local got=$?\n  if [ \"$got\" = \"$2\" ]; then echo \"ok   $1 (exit $got)\"; pass=$((pass+1))\n  else echo \"FAIL $1 (exit $got, want $2)\"; cat \"$TMP/err\"; fail=$((fail+1)); fi\n}\n\n# wf <script-file>: the Workflow tool-call payload the harness sends, built by node so newlines\n# and quotes in the script never need hand-escaping\nwf() { node -e 'process.stdout.write(JSON.stringify({tool_name:\"Workflow\",tool_input:{script:require(\"fs\").readFileSync(0,\"utf8\")}}))' <\"$1\"; }\n\n# arm <label> <expected-exit> <expected-stderr-substring|-> <script-file>\narm() {\n  local out rc; out=$(wf \"$4\" | node \"$HOOK\" 2>&1 >/dev/null); rc=$?\n  if [ \"$rc\" = \"$2\" ] && { [ \"$3\" = - ] && [ -z \"$out\" ] || case \"$out\" in *\"$3\"*) true;; *) false;; esac; }; then\n    echo \"ok   $1\"; pass=$((pass+1))\n  else echo \"FAIL $1 (exit $rc, want $2; want text: $3)\"; printf '%s\\n' \"$out\" | sed 's/^/      /'; fail=$((fail+1)); fi\n}\n\n# ... the nine existing check lines, unchanged ...\n\ncat >\"$TMP/capped-verify.js\" <<'EOF'\nexport const meta = { name: 'capped', description: 'd', phases: [] }\nasync function boundedParallel(thunks, cap = 6) {\n  const out = []\n  for (let i = 0; i < thunks.length; i += cap)\n    out.push(...(await parallel(thunks.slice(i, i + cap)))) // gov:bounded-fanout\n  return out\n}\nfunction chunk(a, n) { const o = []; for (let i = 0; i < a.length; i += n) o.push(a.slice(i, i + n)); return o }\nconst MAX_VERIFIERS = 5\nconst batches = chunk(found, Math.ceil(found.length / MAX_VERIFIERS))\nawait boundedParallel(batches.map((b) => () => agent(String(b))))\nEOF\ncat >\"$TMP/fixed-batch-verify.js\" <<'EOF'\nexport const meta = { name: 'uncapped', description: 'd', phases: [] }\nconst BATCH = 5\nconst batches = chunk(found, BATCH)\nawait boundedParallel(batches.map((b) => () => agent(String(b))))\nEOF\ncat >\"$TMP/raw-verify.js\" <<'EOF'\nconst v = await parallel(found.map((f) => () => agent(f)))\nEOF\n\narm \"verify stage capped on TOTAL agents -> allow\" 0 - \"$TMP/capped-verify.js\"\narm \"raw parallel in a verify stage -> deny, names the rule\" 2 \"BLOCKED by agent-cap\" \"$TMP/raw-verify.js\"\n# the verify-stage rule's arm asserts ITS OWN message, which the spec fixes:\n# arm \"fixed-size skeptic batches -> deny\" 2 \"<verify-stage message>\" \"$TMP/fixed-batch-verify.js\"\n\n# every shipped workflow script (population = the export-const-meta marker) passes the hook\nfor f in $(git -C \"$ROOT\" ls-files --cached --others --exclude-standard -- 'tools/*.js'); do\n  grep -qE '^[[:space:]]*export[[:space:]]+const[[:space:]]+meta[[:space:]]*=' \"$ROOT/$f\" || continue\n  arm \"shipped $f -> allow\" 0 - \"$ROOT/$f\"\ndone\n\necho \"---- $pass passed, $fail failed ----\"\n[ \"$fail\" = 0 ]\n",
