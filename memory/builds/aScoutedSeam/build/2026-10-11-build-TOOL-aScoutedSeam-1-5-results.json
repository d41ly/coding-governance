   "draft": "// packages/blocks/src/dsl/designKey.ts  (NO 'use client': cms.tsx calls it server-side)\nexport const PLUGIN_DESIGN_PREFIX = \"plugin:\";\nexport function parsePluginDesignKey(raw: unknown): { pluginSlug: string; designSlug: string } | null {\n  if (typeof raw !== \"string\" || !raw.startsWith(PLUGIN_DESIGN_PREFIX)) return null;\n  const parts = raw.split(\":\");\n  return parts.length === 3 && parts[1] && parts[2] ? { pluginSlug: parts[1], designSlug: parts[2] } : null;\n}\n\n// packages/blocks/src/dsl/descriptorCache.ts  (extend; second slot beside _slot)\nexport interface RawEnabledSectionDesign { plugin_slug: string; section_type: string; design_slug: string; node_vocab: number; label: string; icon?: string | null; payload: { propsSchema?: unknown; tree?: unknown } }\nexport interface CachedSectionDesign { pluginSlug: string; sectionType: string; designSlug: string; label: string; descriptor: Descriptor }\nconst SECTION_DESIGNS_PATH = \"/plugin-designs/enabled\";\nconst _designSlot: CacheSlot<CachedSectionDesign[]> = { current: null };\nexport function mapEnabledSectionDesigns(raw: RawEnabledSectionDesign[] | null | undefined): CachedSectionDesign[] {\n  if (!Array.isArray(raw)) return [];\n  return raw.filter((d) => d && d.plugin_slug && d.section_type && d.design_slug).map((d) => ({\n    pluginSlug: d.plugin_slug, sectionType: d.section_type, designSlug: d.design_slug, label: d.label || d.design_slug,\n    descriptor: { nodeVocab: typeof d.node_vocab === \"number\" ? d.node_vocab : 1,\n      propsSchema: Array.isArray(d.payload?.propsSchema) ? (d.payload.propsSchema as PropSpec[]) : [],\n      tree: (d.payload?.tree as DslNode) ?? { node: \"text\", value: \"\" }, label: d.label },\n  }));\n}\nexport function loadEnabledSectionDesigns(): Promise<CachedSectionDesign[] | null> {\n  return cachedLoad(_designSlot, () => adminGetSafe<RawEnabledSectionDesign[] | null>(SECTION_DESIGNS_PATH, null)\n    .then((raw) => (raw === null ? null : mapEnabledSectionDesigns(raw))));\n}\n// resetDescriptorCache(): also `_designSlot.current = null;`\n\n// packages/blocks/src/dsl/editorFields.ts  (pure, gated)\nexport function pluginDesignOptions(list: CachedSectionDesign[] | null | undefined, sectionType: string) {\n  return (list ?? []).filter((d) => d.sectionType === sectionType)\n    .map((d) => ({ label: `${d.label} (plugin: ${d.pluginSlug})`, value: `plugin:${d.pluginSlug}:${d.designSlug}` }));\n}\nexport function designDataField(cached: Descriptor | undefined): Record<string, PuckLikeField> {\n  const inner = descriptorInspectorFields(cached?.propsSchema);\n  return Object.keys(inner).length ? { designData: { type: \"object\", label: \"Design fields\", objectFields: inner } } : {};\n}\n\n// apps/web/components/admin/editor/pluginBlockFields.tsx\nexport function sectionPluginDesignResolveFields(sectionType: string, inner: ResolveFn | undefined) {\n  return async (data: { props?: Record<string, unknown> }, params: ResolveParams) => {\n    const narrowed = (inner ? await inner(data, params) : params.lastFields ?? {}) as Record<string, Field>;\n    const list = await loadEnabledSectionDesigns();\n    if (list === null) return params.lastFields ?? narrowed; // R12: degraded keeps prior\n    const sel = narrowed.design as { options?: { label: string; value: unknown }[] } | undefined;\n    const out: Record<string, Field> = { ...narrowed };\n    if (sel?.options) out.design = { ...sel, options: [...sel.options, ...pluginDesignOptions(list, sectionType)] } as Field;\n    const key = parsePluginDesignKey(data.props?.design);\n    if (key) {\n      const hit = list.find((d) => d.sectionType === sectionType && d.pluginSlug === key.pluginSlug && d.designSlug === key.designSlug);\n      Object.assign(out, toPuckFields(designDataField(hit?.descriptor)));\n    }\n    return out;\n  };\n}\n\n// apps/web/app/admin/pages/[id]/edit/page.tsx  (inside the editorConfig memo, beside the PluginBlock clone)\nfor (const b of ALL_BLOCKS) {\n  if (!b.isSection || !components[b.type]) continue;\n  components = { ...components, [b.type]: { ...components[b.type],\n    resolveFields: sectionPluginDesignResolveFields(b.type, components[b.type].resolveFields as never) as never } };\n}\n\n# services/api/app/services/plugin_design_service.py\ndef dsl_surface_on(settings) -> bool:\n    return feature_flags.is_enabled(settings, \"plugins_enabled\") and feature_flags.is_enabled(settings, \"block_dsl_enabled\")\n\n# services/api/app/mcp/tools/plugin_designs.py\n@mcp.tool(name=\"incms_list_plugin_designs\", annotations={\"title\": \"List plugin designs\", **registry.READ_ONLY})\nasync def list_plugin_designs() -> str:\n    \"\"\"Enabled plugin Block-DSL blocks + per-section plugin designs (identity + propsSchema SHAPE).\n    Set a section's design to `plugin:<plugin_slug>:<slug>`; author values go in props.designData.\"\"\"\n    async with registry.SessionLocal() as db:\n        settings = await settings_service.get_settings_cached(db)\n        if not plugin_design_service.dsl_surface_on(settings):\n            return registry._json({\"blocks\": [], \"designs\": []})\n        blocks = await plugin_block_service.list_enabled_descriptors(db, limit=200)\n        designs = await plugin_design_service.list_enabled_designs(db, limit=200)\n        shape = lambda r: (r.get(\"payload\") or {}).get(\"propsSchema\") or []\n        return registry._json({\n            \"blocks\": [{\"plugin_slug\": r[\"plugin_slug\"], \"slug\": r[\"descriptor_slug\"], \"label\": r[\"label\"], \"node_vocab\": r[\"node_vocab\"], \"props_schema\": shape(r)} for r in blocks],\n            \"designs\": [{\"plugin_slug\": r[\"plugin_slug\"], \"slug\": r[\"design_slug\"], \"section_type\": r[\"section_type\"], \"label\": r[\"label\"], \"node_vocab\": r[\"node_vocab\"], \"props_schema\": shape(r)} for r in designs],\n        })\n",
