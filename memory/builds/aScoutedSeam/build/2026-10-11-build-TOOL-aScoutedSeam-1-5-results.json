   "draft": "# tools/lib/runlog-append.sh — the ONE shell runlog writer; copy-installed kits carry it inline, gated by PARITY_ROWS\n# >>> runlog_append — canonical copy: runlog-append.sh in gov's lib dir (byte-identical; gated)\nrunlog_append() { # journal file · key value [key value ...] -> one grammar line appended; rc 0 always\n  [ \"${GOV_RUNLOG:-}\" != 0 ] || return 0\n  local LC_ALL=C _ra_f=$1 _ra_bs='\\' _ra_tab=$'\\t' _ra_line=\"\" _ra_v _ra_i _ra_size=0\n  local -a _ra_key=() _ra_val=()\n  shift\n  while [ \"$#\" -ge 2 ]; do\n    _ra_v=${2//\"$_ra_bs\"/\"$_ra_bs$_ra_bs\"}; _ra_v=${_ra_v//$'\\t'/'\\t'}\n    _ra_v=${_ra_v//$'\\n'/'\\n'}; _ra_v=${_ra_v//$'\\r'/'\\r'}\n    _ra_key+=(\"$1\"); _ra_val+=(\"$_ra_v\"); shift 2\n  done\n  # ... STEP ONE and STEP TWO truncation, moved VERBATIM from .githooks/pre-push write_push_line ...\n  for _ra_i in \"${!_ra_key[@]}\"; do\n    _ra_line+=\"${_ra_line:+$_ra_tab}${_ra_key[_ra_i]}=${_ra_val[_ra_i]}\"\n  done\n  [ -d \"${_ra_f%/*}\" ] || mkdir -p \"${_ra_f%/*}\" 2>/dev/null\n  { printf '%s\\n' \"$_ra_line\" >> \"$_ra_f\"; } 2>/dev/null && return 0\n  printf 'run log — cannot append to %s; the caller'\"'\"'s output and exit code are unaffected\\n' \"$_ra_f\" >&2\n  return 0\n}\n# <<< runlog_append\n\n# check-wiring.sh (and run-gates.sh with c=$TS_COMMON): one heal = one line\nhealth_heal() { # kind · act -> one ev=once line in <common>/runlog/health.log\n  local t c\n  if [ -n \"${EPOCHREALTIME:-}\" ]; then t=${EPOCHREALTIME/,/.}; else printf -v t '%(%s)T' -1; fi\n  c=$(git rev-parse --path-format=absolute --git-common-dir 2>/dev/null) || return 0\n  runlog_append \"$c/runlog/health.log\" v 1 t \"$t\" p health ev once kind \"$1\" by \"${0##*/}\" act \"$2\"\n}\n# check_hooks, line 505:\n#   git config core.hooksPath .githooks && { echo \"FIXED    hooks     — set core.hooksPath -> .githooks\"; health_heal hooks 'set core.hooksPath'; }\n# check_merge_rows, line 1092: ... && { echo \"FIXED    merge     — set merge.rows.driver\"; health_heal merge-driver 'set merge.rows.driver'; }\n# run-gates ts_try_reap 895/901: health_heal turnstile-beacon \"reaped dead holder pid $hpid\"\n# run-gates ts_sweep_queue 960/965: health_heal turnstile-ticket \"swept ticket pid $pid\"\n\n# skills/session-kickoff/manifest-check.sh\nHEALTH_WINDOW_S=86400   # the card's health window: 24 h\nderive_health_cell() { # -> one 'health —' line; CARD_DIR is <common>/orientation\n  local f=\"${CARD_DIR%/*}/runlog/health.log\" now\n  [ -f \"$f\" ] || { printf 'health — skipped: no runlog/health.log in the common dir\\n'; return 0; }\n  printf -v now '%(%s)T' -1\n  awk -F'\\t' -v cut=\"$((now - HEALTH_WINDOW_S))\" '\n    { sub(/\\r$/, \"\"); t = \"\"; k = \"\"; once = 0\n      for (i = 1; i <= NF; i++) {\n        if ($i ~ /^t=/) t = substr($i, 3)\n        else if ($i ~ /^kind=/) k = substr($i, 6)\n        else if ($i == \"ev=once\") once = 1 }\n      if (!once || t == \"\" || t + 0 < cut) next\n      n++; if (!(k in c)) order[++m] = k; c[k]++ }\n    END { if (!n) { print \"health — 0 self-heals in the last 24h\"; exit }\n          s = \"\"; for (j = 1; j <= m; j++) s = s \" · \" order[j] \" \" c[order[j]]\n          print \"health — \" n \" self-heal(s) in the last 24h\" s }' \"$f\"\n}\n# render_card: after printf '%s\\n' \"$live\" ->  derive_health_cell\n# print_replay: after the now — line ->  derive_health_cell   (recomputed, never stored twice)\n\n# test fixture (manifest-check.test.sh)\n# printf 'v=1\\tt=%s\\tp=health\\tev=once\\tkind=hooks\\tby=check-wiring.sh\\tact=x\\n' \"$(( $(date +%s) - 60 ))\" >  \"$GCD/runlog/health.log\"\n# printf 'v=1\\tt=%s\\tp=health\\tev=once\\tkind=hooks\\tby=check-wiring.sh\\tact=x\\n' \"$(( $(date +%s) - 90000 ))\" >> \"$GCD/runlog/health.log\"\n# expect: 'health — 1 self-heal(s) in the last 24h · hooks 1'\n",
