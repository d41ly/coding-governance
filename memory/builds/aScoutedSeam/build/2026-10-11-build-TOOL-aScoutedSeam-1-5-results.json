nk-only)\")\n\n# do_measure():\n    dup = {i for (p, i), (n, _) in w[\"rows\"].items() if n > 1}\n    print(f'ID_ROW_DUP_PIN=\"{len(dup)}\"')\n\n# do_selftest():\n        t9 = os.path.join(base, \"rowdup\"); os.makedirs(t9)\n        c9 = _scratch(t9, extra={\"memory/DECISIONS.md\": \"# d\\n\\n- ARCH-tOne-1 · a\\n- ARCH-tOne-1 · b\\n\"})\n        c9[\"ID_ROW_DUP_PIN\"] = \"0\"\n        arm(\"check 20 catches one id leading two rows\", \"leads 2 rows in one document\",\n            lambda: \"\\n\".join(checks(walk(t9, c9))))\n        _w(t9, \"memory/project/id-row-duplicate-waiver.txt\", \"ARCH-tOne-1\\n\")\n        run(\"git\", \"add\", \"-A\", cwd=t9); run(\"git\", \"commit\", \"-q\", \"-m\", \"w\", \"--no-verify\", cwd=t9)\n        arm(\"check 20 pin can only go down\", \"pinned at 0 (shrink-only)\", lambda: \"\\n\".join(checks(walk(t9, c9))))\n        c9b = dict(c9); c9b[\"ID_ROW_DUP_PIN\"] = \"1\"\n        arm(\"a waived row duplicate passes\", None, lambda: checks(walk(t9, c9b)))\n        # + backlog-shard fixture memory/backlog/ARCH.md with '- ARCH-tOne-1 · OPEN · x' twice\n        # + stale-waiver fixture (waiver names an id with one row)\n\n# .memory-tree.conf (measured 2026-10-18: TOOL-aUnmannedHelm-5, -6 in memory/DECISIONS.md)\n# ID_ROW_DUP_PIN=\"2\"\n# memory/project/id-row-duplicate-waiver.txt:\n#   TOOL-aUnmannedHelm-5\n#   TOOL-aUnmannedHelm-6\n",
