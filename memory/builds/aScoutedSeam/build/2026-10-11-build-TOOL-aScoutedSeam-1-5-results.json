   "draft": "// agent-cap.js — next to readSpecAuditDefault\nconst DATE_RE = /^\\d{4}-\\d{2}-\\d{2}$/\nconst GIT_READ_MS = 10000 // ponytail: local git reads only; raise if a cold pack makes rev-parse slow\n// The driver's fail-22 set, in its order (unattended.sh:1567).\nconst GIT_ENV_LEVERS = ['GIT_CONFIG_COUNT', 'GIT_CONFIG_PARAMETERS', 'GIT_CONFIG_GLOBAL', 'GIT_CONFIG_SYSTEM',\n  'GIT_DIR', 'GIT_COMMON_DIR', 'GIT_OBJECT_DIRECTORY', 'GIT_ALTERNATE_OBJECT_DIRECTORIES', 'GIT_NAMESPACE']\n\n// The BASE both declarations are read at: merge-base(HEAD, the default branch the remote-tracking\n// HEAD names). The driver OBSERVES that tip from the remote; this reads the local ref, so a run that\n// rewrites refs/remotes/<r>/HEAD can still move it. That limit is stated in the header.\n// Returns { base, runGit } or { why }.\nfunction resolveSpecAuditBase(root) {\n  const injected = GIT_ENV_LEVERS.filter((k) => process.env[k])\n  if (injected.length) return { why: `git configuration is supplied through the environment (${injected.join(' ')}), and a base read under a config the caller injected is the caller's answer.` }\n  const { spawnSync } = require('child_process')\n  const runGit = (args) => spawnSync('git', ['--no-replace-objects', ...args], { cwd: root, encoding: 'utf8', timeout: GIT_READ_MS })\n  const rems = (runGit(['remote']).stdout || '').split(/\\r?\\n/).filter(Boolean)\n  if (rems.length !== 1) return { why: `${root} declares ${rems.length} remotes, and the base is the one default branch a single remote names.` }\n  const sym = runGit(['symbolic-ref', '--quiet', `refs/remotes/${rems[0]}/HEAD`])\n  const ref = sym.status === 0 ? sym.stdout.trim() : ''\n  if (!ref) return { why: `refs/remotes/${rems[0]}/HEAD names no default branch here; run git remote set-head ${rems[0]} --auto.` }\n  const envd = process.env.GOV_DEFAULT_BRANCH\n  if (envd && ref !== `refs/remotes/${rems[0]}/${envd}`) return { why: `GOV_DEFAULT_BRANCH (${envd}) is not the default branch ${ref} names.` }\n  const mb = runGit(['merge-base', ref, 'HEAD'])\n  if (mb.status !== 0 || !mb.stdout.trim()) return { why: `HEAD shares no history with ${ref}, so there is no base to read a declaration at.` }\n  return { base: mb.stdout.trim(), runGit }\n}\n\n// Bytes of <base>:<rel>, or null when the path is absent at base; throws on any other git failure,\n// which the caller's catch turns into the fail-closed deny.\nfunction readBlobAt(runGit, base, rel) {\n  if (runGit(['cat-file', '-e', `${base}:${rel}`]).status !== 0) return null\n  const r = runGit(['show', `${base}:${rel}`])\n  if (r.status !== 0 || r.error) throw new Error(`git show ${base.slice(0, 8)}:${rel} failed: ${(r.error && r.error.code) || r.stderr.trim()}`)\n  return r.stdout\n}\n\n// inside checkSpecAuditDeclared, replacing lines 1911-1930:\n    const root = path.resolve(data.cwd || process.cwd(), repo)\n    const rel = [...dir, 'README.md'].join('/')\n    readme = `${root.split(path.sep).join('/')}/${rel}`\n    const b = resolveSpecAuditBase(root)\n    if (b.why) return renderDeny(b.why)\n    const bytes = readBlobAt(b.runGit, b.base, rel)\n    if (bytes === null) return renderDeny(`no build README at BASE ${b.base.slice(0, 8)}:${rel}; a key the run wrote on its own branch or in its working copy opts nothing in.`)\n    const { readFrontMatterKey } = require(path.join(__dirname, 'scratch-guard.js'))\n    const v = readFrontMatterKey(bytes, 'spec-audit')\n    if (v !== null && DATE_RE.test(v)) return null\n    if (v === null) {\n      const cbytes = readBlobAt(b.runGit, b.base, '.unattended.conf')\n      const d = cbytes === null ? null : readSpecAuditDefault(cbytes)\n      if (d !== null && d !== '') {\n        if (DATE_RE.test(d)) return null\n        return renderDeny(`${readme} declares no \\`spec-audit:\\` key at BASE, and .unattended.conf at BASE declares \\`SPEC_AUDIT_DEFAULT=\"${d}\"\\`, which is not a date.`)\n      }\n    }\n\n# agent-cap.test.sh — the fixture (scratch-guard.test.sh:503 idiom)\