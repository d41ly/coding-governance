   "draft": "// fieldRules.ts\nexport const REMOTE_CONTROLS = [\n  \"input\", \"checkbox\", \"checkboxes\", \"radio\", \"select\", \"textarea\",\n  \"notice\", \"hidden\", \"typeahead\", \"remoteOptions\",\n  \"file\", // v23: a visitor-attached file; forces a multipart submit\n] as const;\n\n// RemoteMount.tsx\nconst NO_DEFAULT = new Set([\"notice\", \"typeahead\", \"remoteOptions\", \"file\"]);\n\n/** A value counts as answered: a File only when it carries bytes (an empty file input still puts a\n *  zero-size File into FormData, and String(file) is \"[object File]\"). */\nfunction answered(v: FormDataEntryValue): boolean {\n  return typeof v === \"string\" ? v.trim() !== \"\" : v.size > 0;\n}\n\n/** The wired JSON body plus the declared file inputs, as multipart. Order follows `norm`. */\nexport function toMultipart(\n  body: Record<string, unknown>,\n  data: FormData,\n  fields: NormField[],\n): FormData {\n  const out = new FormData();\n  for (const f of fields) {\n    if (f.control === \"file\") {\n      for (const v of data.getAll(f.name)) if (typeof v !== \"string\" && v.size > 0) out.append(f.name, v);\n      continue;\n    }\n    const v = body[f.name];\n    if (v === undefined) continue;\n    if (Array.isArray(v)) for (const x of v) out.append(f.name, String(x));\n    else out.append(f.name, typeof v === \"boolean\" ? String(v) : String(v));\n  }\n  return out;\n}\n\n// call(): the one fetch site\nconst headers: Record<string, string> = { accept: \"application/json\" };\nconst multipart = body instanceof FormData;\n// No content-type for FormData: the browser writes it WITH the boundary the gateway relays verbatim.\nif (body !== undefined && !multipart) headers[\"content-type\"] = \"application/json\";\n...\nbody: body === undefined ? undefined : multipart ? (body as FormData) : JSON.stringify(body),\n\n// submit(): required check\nconst vals = data.getAll(f.name).filter(answered);\n// final submit\nconst wired = applyPostAndWire(activeValues(activeFields, base), norm, submitDerived);\nconst hasFile = norm.some((f) => f.control === \"file\" && activeByName.has(f.name));\nconst r = await call(service, path, auth, \"POST\", hasFile ? toMultipart(wired, data, norm) : wired, next.signal);\n\n// RemoteFieldInput arm\nif (field.control === \"file\") {\n  return (\n    <label className=\"block\">\n      <span data-part=\"core-field-label\" className=\"block text-sm\">{field.label}</span>\n      <input type=\"file\" name={field.name} required={field.required || undefined}\n        aria-describedby={errorId} className=\"w-full\" />\n      {errorNode}\n    </label>\n  );\n}\n\n# dsl_validator.py\n_REMOTE_CONTROLS = frozenset({..., \"remoteOptions\", \"file\"})\n# in the unsendable loop:\nif f.get(\"control\") in (\"notice\", \"file\") or (...):\n    unsendable.add(f[\"name\"])\n# persist:\nfile_names = {f[\"name\"] for f in fields if isinstance(f, dict) and f.get(\"control\") == \"file\"}\nif persist and file_names & set(persist):\n    raise ValueError(f\"remoteForm.persist names file field(s), which cannot be stored: {sorted(file_names & set(persist))}\")\n\n# test fixture line (vitest)\nconst file = new File([new Uint8Array([1, 2, 3])], \"id.png\", { type: \"image/png\" });\nexpect((init.headers as Record<string,string>)[\"content-type\"]).toBeUndefined();\nexpect(init.body).toBeInstanceOf(FormData);",
