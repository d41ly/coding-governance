      # PLAY-dOrderedCharter-17: the lexicon kit is a declared slot, its state named on one line
      echo "pre-push: slot point.flow.leg-pack · not-installed: no merge in this push is graded — the lexicon kit is installed neither under '$top' nor beside this hook (refs/heads/$def)."
    else
      _ml_out=$(cd "$top" && "$_ml_py" "$_ml_module" --merge-losses "$main_remote..$main_local" 2>&1); _ml_rc=$?
      if [ "$_ml_rc" = 0 ]; then
        printf '%s\n' "$_ml_out" | sed 's/^/pre-push: /'
        echo "pre-push: slot point.flow.leg-pack · searched-empty"
      elif [ "$_ml_rc" = 2 ]; then
        echo "pre-push: DEAD PROBE — the merge-loss check could not answer for refs/heads/$def, so this push is ALLOWED on a signal that did not measure:"
        printf '%s\n' "$_ml_out" | sed 's/^/  /'
      else
        why="pre-push: REFUSING — a merge in this push loses a definition one of its parents carried (TOOL-aMendedFleet-3)."
        echo "pre-push: slot point.flow.leg-pack · filled" >&2
        echo "$why" >&2
        printf '%s\n' "$_ml_out" | sed 's/^/  /' >&2
        echo "  Deliberate override, as always: git push --no-verify" >&2
        write_refusal merge-loss "$why"; RUNLOG_CLEAN=1; exit 1
      fi
    fi
  fi
fi

# ---- THE POLICY FILE'S PUSH ARM — TOOL-dDeclaredLoop-2 S6 -------------------------------------
# Beside the merge-loss block and under its two conditions: the loop kit's `guard.py --push-range`
# grades the pushed default-branch range, and its push arm's docstring is the one statement of which
# commits, merges included, owe a `Gov-Policy:` trailer and a change record. The kit is resolved as the merge-loss
# block resolves its own, over the pushing tree and this hook's parent, and a copy under the pushing
# tree is vetted by check_reviewed_file before it runs. Exit 1 refuses as `policy-unrecorded`, a
# token no run-log decision pairs with; exit 2 refuses naming the reason, deny by default; no launcher
# or no loop kit prints one line naming the miss, never silence.
# WHAT THIS DOES NOT SEE: a change to the list file of guarded paths, which carries its change record
# alone; history already on the remote; a push with --no-verify.
if [ -z "$DECIDE" ] && [ -n "${main_local//0/}" ] && [ -n "${main_remote//0/}" ]; then
  _pg_py=$(resolve_python 2>/dev/null || true)
  _pg_rel=""; _pg_tree=""
  if [ -n "$_pg_py" ]; then
    for _pg_tree in "$top" "$(cd "${0%/*}/.." && pwd)"; do
      if _pg_dir=$(resolve_kit_dir "$_pg_py" loop guard.py "$_pg_tree/${GOV_KITROOT:-.}" 2>/dev/null); then
        _pg_rel="${_pg_dir%$'\r'}/guard.py"; break
      fi
    done
  fi
  if [ -z "$_pg_py" ]; then
    echo "pre-push: the policy push arm did NOT run over refs/heads/$def — no usable python launcher resolved, so no Gov-Policy trailer in this push was graded."
  elif [ -z "$_pg_rel" ]; then
    echo "pre-push: the policy push arm did NOT run over refs/heads/$def — the loop kit's guard.py is installed neither under '$top' nor beside this hook."
  else
    [ "$_pg_tree" != "$top" ] || check_reviewed_file "$_pg_rel" "$main_local" "runs as the policy push arm"
    _pg_out=$(cd "$top" && "$_pg_py" "$_pg_tree/$_pg_rel" --push-range "$main_remote..$main_local" 2>&1); _pg_rc=$?
    if [ "$_pg_rc" = 0 ]; then
      printf 'pre-push: %s\n' "${_pg_out//$'\n'/$'\n'pre-push: }"
    else
      if [ "$_pg_rc" = 1 ]; then
        why="pre-push: REFUSING — a commit in this push changes the policy file without its Gov-Policy trailer or its change record (TOOL-dDeclaredLoop-2)."
      else
        why="pre-push: REFUSING — the policy push arm could not judge this push (exit $_pg_rc), and an unjudged policy change does not land."
      fi
      echo "$why" >&2
      printf '  %s\n' "${_pg_out//$'\n'/$'\n'  }" >&2
      echo "  Write a policy change through the loop kit's policy_edit.py, which stages its record and prints its trailer." >&2
      write_refusal policy-unrecorded "$why"; RUNLOG_CLEAN=1; exit 1
    fi
  fi
fi

# ---- WHICH BAR RUNS, and has this repository ever seen it? — TOOL-aRepatriatedFork-5 ----------
# The bar used to be resolved on the line that ran it, out of an environment variable nothing checked.
# Reproduced 2026-09-23 in a scratch repo with the default bar stubbed RED: with no override the push
# was refused at rc 1 and the remote stayed put; with GOV_GATE_CMD=true the SAME commit landed at rc 0
# under a BYTE-IDENTICAL "FULL gate … no recorded full green" line, a run-log END reading
# `decision=full rc=0`, and push-main's lander marker. The evidence an unattended run is read for
# could not tell a whole bar from `true`. Adopter nc found and fixed it first (PKG-dCandidLodestar-5);
# this is its rev-3 guard, taken without change but for the run-log decision it writes. Since
# TOOL-aRepatriatedFork-8 it is a function, because the branch bar is vetted by the same rule.
#
# So a bar command gets the treatment GOV_DEFAULT_BRANCH got above: the environment may REFUSE,
# never SELECT. There is no observed counterpart to prefer here, so the cross-check takes the other
# available form — the command must name a file THIS REPOSITORY TRACKS. That single property
# separates a reviewed bar script from `true`, from `bash /tmp/anything.sh`, and from anything a
# local untracked .githooks/gate-env.sh could set.
#
# TRACKED AT THE SHA THE CALLER NAMES. For the merge bar that is the pushed default-branch sha, never
# HEAD: a bar script that lands in this very push exists only on the branch being pushed, and the
# equality check below has already established that sha IS this working tree. A branch bar runs from
# the working tree whatever is being pushed, so it is vetted at HEAD.
#
# WHAT THIS DOES NOT CLOSE. `--no-verify` and a redirected `core.hooksPath` skip this file whole, and
# `BASH_ENV` runs an actor's own file inside this hook's interpreter before its first line; each needs
# an act of its own, and the unattended protocol lists that class as open. What this closes is the
# case where no such act is needed: the knob this hook documents, set to a four-letter word.
# The bar still INHERITS every other variable (TOOL-aRepatriatedFork-49 names what it clears): `PATH`,
# which chooses every launcher that is a bare word; the language runtimes' own variables, such as
# `PYTHONPATH`, `PYTHONHOME` and `NODE_OPTIONS`, which can load code into any leg; and the leg-level
# knobs an adopter's own legs read. Clearing the runtimes' variables would change the environment
# every adopter's legs receive from a hook that ships verbatim, and `PATH` stays inherited either
# way, so that class is open and is the owner's to decide.
bar_class=""
check_bar_command() { # knob name · command · sha its scripts must be tracked at · [declared] -> rc 0 with bar_class, bar_path and bar_blob, or rc 1 printed with its headline in `why`
  local knob=$1 cmd=$2 at=$3 _n=0
  bar_path=""; bar_blob=""
  if [ -n "${GOV_GATE_CMD_TEST:-}" ]; then
    # THE DECLARED ESCAPE, and it declares ITSELF: in the decision line, in the run log's `bar=stub`,
    # and by the lander marker push-main withholds. Every hook harness stubs the bar with an mktemp
    # script that is untracked by construction, so with no escape this hook could not be tested at
    # all. A SILENT waiver would be the defect wearing a test's name.
    bar_class=stub; return 0
  fi
  # EVERY path-shaped token has to be tracked, not merely the last one: "last token wins" accepts
  # `bash /tmp/evil.sh <tracked>`, because the tracked name trails the one that actually runs.
  #
  # AND THE EVERY-TOKEN RULE STILL DOES NOT CONSTRAIN WHAT RUNS. `gatepayload <tracked>` and
  # `bash -c gatepayload <tracked>` both landed over a RED bar at adopter nc: `gatepayload` is a PATH
  # command, it holds no `/` and does not end `.sh`, so no arm looked at it while the shell ran it.
  # So the word that EXECUTES is constrained by its POSITION: word 1, or word 2 when word 1 is one
  # of the two interpreters, and it has to be path-shaped, which routes it through the tracked and
  # working-copy checks below. Nothing else may sit between the interpreter and the script: an option
  # (`-c` turns the next word into the program and the tracked name into `$0`) or a bare word.
  # The first cut constrained only word 1 and enumerated dangerous SHAPES for the rest, so
  # `bash gatepayload <tracked>` passed as `bar=tracked` and bash ran `gatepayload` off PATH over a
  # RED bar (closing review round 1 B1): a shape list misses the shape nobody listed, and a
  # position does not.
  #
  # AND THE CONTENT, NOT ONLY THE NAME. `bash <tracked>` with that file rewritten in the working
  # tree also landed: the blob at the pushed tip is what the name check reads and the working copy
  # is what runs. push-main.sh refuses a dirty tree, but the boundary may not rest on a check one
  # layer up that a different lander need not make.
  #
  # AND THE VALUE, NOT ONLY ITS SCRIPT (closing review round 1 M1). Every check above passes any
  # tracked, clean script, and a library under the kit root that only defines a function is one: it
  # exits 0, so it is `true` with extra steps. With `declared`, the value has to be this kit's own runner or
  # the `GATE_CMD` that `.unattended.conf` declares AT `$at`, read in a subshell the way the unattended
  # driver sources that file, with an inherited `GATE_CMD` unset first so the environment cannot
  # declare its own bar. A branch bar passes no `declared`: it can only add a refusal.
  #
  # `.githooks/pre_push_bar_selftest.py` disables the program, option, working-copy and declared
  # arms in a copy of this file on every run and observes the evasions land. Its anchor is the
  # `set +f` line below, spelled exactly once in this file.
  _bar_tok=""; _bar_bad=""; _bar_first=""; _bar_opt=""; _bar_seen=""; _bar_dirty=""; _bar_prog=""
  _bar_decl=$cmd
  # THE ADVICE a refusal prints is a value this check ADMITS (closing review round 2 L2): the
  # declared GATE_CMD when there is one, else the kit's own runner. The self-test pushes it back.
  _bar_ok="bash ${GATE_RUNNER:-<the kit runner, once the kit root resolves>}"
  if [ "${4-}" = declared ] && { [ -z "$GATE_RUNNER" ] || [ "$cmd" != "bash $GATE_RUNNER" ]; }; then
    _bar_decl=$(unset GATE_CMD; eval "$(git show "$at:.unattended.conf" 2>/dev/null)" >/dev/null 2>&1 </dev/null; printf '%s' "${GATE_CMD-}")
    [ -n "$_bar_decl" ] && _bar_ok=$_bar_decl
  fi
  set -f                       # the value is a command line; glob-expanding it is never wanted
  for _w in $cmd; do
    _n=$((_n + 1))
    [ -z "$_bar_first" ] && _bar_first=$_w
    case "$_n:$_bar_first" in 1:*|2:bash|2:sh) _bar_prog=$_w ;; esac
    case "$_w" in
      */*|*.sh)
        _bar_tok=$_w; _bar_seen=1
        if [ -z "$_bar_bad" ] && ! git cat-file -e "$at:$_w" 2>/dev/null; then
          _bar_bad=$_w
        elif [ -z "$_bar_bad" ] && [ -z "$_bar_dirty" ]; then
          _wt=$(git hash-object -- "$_w" 2>/dev/null || true)
          _bl=$(git rev-parse "$at:$_w" 2>/dev/null || true)
          [ "$_wt" != "$_bl" ] && _bar_dirty=$_w
        fi
        ;;
      -*)
        # An option word BEFORE the script decides what the interpreter runs; after it, it is the
        # script's own argument and none of this hook's business.
        [ -z "$_bar_seen" ] && [ -z "$_bar_opt" ] && _bar_opt=$_w
        ;;
    esac
  done
  set +f
  if [ -z "$_bar_tok" ]; then
    why="pre-push: REFUSING - $knob names no script at all, so nothing here can tell the"
    echo "$why" >&2
    echo "  merge bar from a no-op: '$cmd'. A push gated by 'true' prints the same decision line" >&2
    echo "  as a push gated by every leg. Name a tracked script, or use --no-verify - which at" >&2
    echo "  least leaves no gate line behind for a later reader to misread as evidence." >&2
    return 1
  fi
  if [ -n "$_bar_opt" ]; then
    why="pre-push: REFUSING - $knob passes '$_bar_opt' to the interpreter before naming a"
    echo "$why" >&2
    echo "  script, so the tracked name need not be what runs at all ('-c' makes the next word the" >&2
    echo "  program and the script name its \$0). Full value: '$cmd'" >&2
    echo "  Name the script with no interpreter options. Sanctioned use: $knob='$_bar_ok'." >&2
    return 1
  fi
  case "$_bar_prog" in
    */*|*.sh) : ;;
    *)
      why="pre-push: REFUSING - $knob would RUN '$_bar_prog', which is not a script path this"
      echo "$why" >&2
      echo "  repository could track. The program that runs has to be a tracked, unmodified script at" >&2
      echo "  word 1, or at word 2 after bash or sh, with nothing between them: a tracked name later in" >&2
      echo "  the value does not make the executed word safe. Full value: '$cmd'" >&2
      echo "  Sanctioned use: $knob='$_bar_ok'. To test this hook," >&2
      echo "  export GOV_GATE_CMD_TEST=1, which waives this and marks the decision line 'bar: STUB'." >&2
      return 1
      ;;
  esac
  if [ -n "$_bar_bad" ]; then
    why="pre-push: REFUSING - $knob names '$_bar_bad', which this repository does not track"
    echo "$why" >&2
    echo "  at ${at:0:8}. The merge bar has to be a script the repo reviews;" >&2
    echo "  an untracked one is a bar nobody has read. Full value: '$cmd'" >&2
    echo "  Sanctioned use: $knob='$_bar_ok'. To test this hook," >&2
    echo "  export GOV_GATE_CMD_TEST=1, which waives this and marks the decision line 'bar: STUB'." >&2
    return 1
  fi
  if [ -n "$_bar_dirty" ]; then
    why="pre-push: REFUSING - $knob names '$_bar_dirty', which IS tracked at"
    echo "$why" >&2
    echo "  ${at:0:8} but whose working copy differs from it. The reviewed blob is what this" >&2
    echo "  check can vouch for and the working copy is what would run, so the two have to agree." >&2
    echo "  Commit the edit and push that, or point $knob at a bar you have not modified." >&2
    return 1
  fi
  if [ "$cmd" != "$_bar_decl" ]; then
    why="pre-push: REFUSING - $knob is '$cmd', which is neither this kit's own runner nor the"
    echo "$why" >&2
    echo "  GATE_CMD .unattended.conf declares at ${at:0:8} ('$_bar_decl'). Every tracked script that" >&2
    echo "  exits 0 passes the checks above, so an undeclared one is a bar nobody chose." >&2
    echo "  Declare it: GATE_CMD=\"$cmd\" in .unattended.conf, committed, then push that." >&2
    return 1
  fi
  bar_class=tracked; bar_path=$_bar_prog
  bar_blob=$(git rev-parse -q --verify "$at:$_bar_prog" 2>/dev/null || true)
}

# ---- THE BRANCH BAR — TOOL-aRepatriatedFork-8 S5 ------------------------------------------------
# A push that does not touch the default branch is ungated UNLESS the repository declares a branch
# bar, `GOV_BRANCH_GATE_CMD`, in its `.githooks/gate-env.sh`. It is the seam for an adopter policy that
# is not generic (adopter ic runs its docs hygiene on a branch push that moved `memory/`). Unset, nothing
# changes. Set, it is vetted by the rule above, at HEAD, and run with git's own ref lines on its
# stdin, since a branch push can carry several refs and one base sha cannot describe them; so
# `GATE_PUSH_BASE` is unset for it rather than inherited. A branch bar can only ADD a refusal to a
# push that is ungated without it.
if [ -z "$main_local" ] && [ -n "${GOV_BRANCH_GATE_CMD:-}" ]; then
  if ! check_bar_command GOV_BRANCH_GATE_CMD "$GOV_BRANCH_GATE_CMD" "$(git rev-parse HEAD 2>/dev/null)"; then
    write_refusal bar-refused "$why"; RUNLOG_CLEAN=1; exit 1
  fi
  RUNLOG_BAR=$bar_class; RUNLOG_DECISION=branch-gated
  bar_label=$GOV_BRANCH_GATE_CMD; [ "$bar_class" = stub ] && bar_label="STUB $bar_label"
  echo "pre-push: branch bar on a non-default push — bar: $bar_label"
  unset GATE_PUSH_BASE
  # RUN AS VETTED, with globbing off (closing review round 1 B1): the vetting split this value under
  # `set -f`, so a glob word expanding here would run words nobody vetted.
  set -o noglob
  printf '%s' "$push_refs" | $GOV_BRANCH_GATE_CMD
  rc=$?
  if [ "$rc" -ne 0 ]; then
    why="pre-push: branch bar RED — push blocked (fix, or 'git push --no-verify' to override deliberately)."
    echo "$why"
    write_refusal gate-red "$why"
  fi
  RUNLOG_CLEAN=1; exit "$rc"
fi

[ -z "$main_local" ] && { RUNLOG_DECISION=skip-nondefault; RUNLOG_CLEAN=1; exit 0; }   # no push to the default branch → nothing to gate
[ -z "${main_local//0/}" ] && { RUNLOG_DECISION=skip-delete; RUNLOG_CLEAN=1; exit 0; }   # all-zero local sha = a delete → nothing to gate

# THE RECEIPT AND THE RUNNER IT NAMES, VETTED BEFORE ANYTHING READS THE KIT ROOT (closing review
# round 1 B1, TOOL-aRepatriatedFork-24 S2c). The ladder above took the kit root, and the resolver the
# runner, from `.governance/install.json`, and neither had to be tracked: an ignored receipt naming
# a runner under `.git/`, beside a planted manifest, ran that runner over a RED tracked bar and
# landed with `git status` empty. Here, and not beside the ladder, because only a default-branch
# push reads what the ladder found; a feature push is not refused over a receipt it never uses.
# The runner is vetted for the DEFAULT bar only: a declared bar is vetted by `check_bar_command`.
[ -f "$top/.governance/install.json" ] \
  && check_reviewed_file .governance/install.json "$main_local" "names this hook's kit root and its default bar"
[ -z "${GOV_GATE_CMD:-}" ] && [ -n "$GATE_RUNNER" ] \
  && check_reviewed_file "$GATE_RUNNER" "$main_local" "is the default bar this hook would run"

# MOVED BELOW THE "NOTHING TO GATE" EXITS, and the move is the whole fix. This refusal used to
# sit beside the kit-root probe, ABOVE every question about which ref is being pushed — so an
# adopter installed at a third prefix (govkit accepts any, via `demand_safe_token`) had EVERY
# push refused, feature branches included, on a hook whose own header says "Other pushes do
# nothing". Reproduced by the closing review on a scratch remote: a `vendor/gov/` install
# refused `git push origin feature` with a message about forcing predicates and a green earned
# on a different leg set, neither of which applies to a push this hook never gates. There was no
# escape hatch either, so such an adopter had to hand-edit the hook or pass --no-verify on every
# branch push. The environment still cannot set `GOV_KITROOT`; the vetted `gate-env.sh` can.
#
# On a DEFAULT-BRANCH push the refusal is still exactly right, and that is where it now lives:
# their bar genuinely cannot run, and saying so at the one boundary that reads the manifest is
# the point. Ordering, not content.
# A PATH THAT RESOLVES TO NOTHING IS A REFUSAL, NEVER A NON-MATCH — but only where the tree actually
# HAS a manifest to find. Those two cases look identical from the outside and that is precisely what
# made the original failure silent: `git diff -- <unresolvable>` reports "no change here" and the
# push sails through. A repo with no manifest anywhere is a different and legitimate case (a fresh
# adopter, a project not using run-gates, this hook's own fixtures), and it is left alone.
# A LADDER MISS is the same case from the other side: nothing resolved, so nothing can be read.
if [ -z "$KITROOT_FROM" ] || [ ! -f "$top/${KP}gate-legs.json" ]; then
  _elsewhere=$(git ls-files --cached -- '*gate-legs.json' 2>/dev/null | head -1)
  if [ -n "$_elsewhere" ]; then
    why="pre-push: REFUSING — this tree tracks a leg manifest at '$_elsewhere', but this hook"
    echo "$why" >&2
    if [ -n "$KITROOT_FROM" ]; then
      echo "  resolved its kit root to '${GOV_KITROOT:-the repo root}' from $KITROOT_FROM and looked for '${KP}gate-legs.json'." >&2
    else
      echo "  resolved its kit root nowhere: $(print_kitroot_miss)." >&2
    fi
    echo "  Left alone, the two forcing predicates that read that path would match NOTHING and the" >&2
    echo "  push would be scoped against a green earned on a different leg set." >&2
    echo "  Deliberate override, as always: git push --no-verify" >&2
    write_refusal manifest "$why"; RUNLOG_CLEAN=1; exit 1
  fi
fi


# TOOL-aLeasedGauntlet-1: a default-branch push must go through <prefix>/push-main.sh, which reconciles
# origin BEFORE this full gate so it never runs on a stale tree. The lander sets this marker; a raw
# push lacks it and is refused (--no-verify bypasses). The kit hook has no code/docs split, so EVERY
# unmarked default-branch push is refused.
if [ -z "$DECIDE" ] && [ ! -f "$(git rev-parse --git-dir)/push-main-active" ]; then   # --decide: no lander is pushing
  why="pre-push: refusing a raw push to $def — land via ${KP}push-main.sh (it reconciles before the gate), or --no-verify to bypass."
  echo "$why" >&2
  write_refusal raw-push "$why"; RUNLOG_CLEAN=1; exit 1
fi

# The tree the hook validates must BE the pushed default-branch tip, else the gate certifies content
# that isn't what lands (a push issued from a feature worktree, or `git push <sha>:main`).
head=$(git rev-parse HEAD 2>/dev/null || true)
if [ "$main_local" != "$head" ]; then
  why="pre-push: refusing — pushing $def @ ${main_local:0:8} but this working tree is at ${head:0:8}."
  echo "$why"
  echo "  Push $def from the primary tree checked out at the pushed tip (charter [isolate]), or --no-verify."
  write_refusal head-mismatch "$why"; RUNLOG_CLEAN=1; exit 1
fi

# ---- THE TREE THE BAR CERTIFIES — TOOL-aRepatriatedFork-8 S3, from adopter ic's ARCH-dWaryGatepost-1 ----
# The bar reads the WORKING TREE and the push carries the COMMIT, so a dirty tree is a tree the green
# does not describe. ONE definition of dirty, spelled identically in push-main.sh:
# `--ignore-submodules=untracked` refuses an untracked superproject file, a moved submodule pointer
# and a tracked edit inside a submodule, and ignores a submodule's own untracked files, which no
# commit here can carry. `-uno`, push-main's old spelling, missed a brand-new source file; plain
# `--porcelain` refused a submodule holding a stranger's scratch file. MEASURED HERE, REFUSED BELOW:
# the refusal sits after the bar command is vetted, so a rewritten bar script is still named by the
# vetting's own sharper message; `.githooks/pre_push_bar_selftest.py` clears this value in its
# mutation too. A tree whose status cannot be read is refused as dirty, never passed as clean.
_tree_dirty=$(git status --porcelain --ignore-submodules=untracked 2>/dev/null) || _tree_dirty="(git status failed, so this tree's state is unknown)"

# ---- the boundary DECIDES, and the obligation it replaces is bounded rather than deleted --------
# This hook used to export GATE_FULL=1 unconditionally, which made every landing pay the whole bar
# — a records-only landing included. What that bought was a real property: a guard could only ever
# narrow a run that was not the deciding one, so a too-narrow guard cost an early signal rather than
# a wrong merge verdict. Deleting the force deletes that property, so it is REPLACED by a bounded,
# RECORDED obligation: the full bar still runs, just not on every push, and the record says when it
# last did. (The retired sentence is deliberately not quoted verbatim anywhere: a criterion greps the
# tracked tree for it, and a historical mention is indistinguishable from a live claim to a probe.)
#
# EVERY PREDICATE BELOW FORCES. There is no predicate that makes a run smaller — the decision is
# "is a scoped run good enough this time", and every way of not knowing the answer is a force. That
# asymmetry is the whole safety argument: this block can be wrong in one direction only.

# A SOURCE CONSTANT with its reasoning beside it, not an environment knob. How stale a recorded
# green may be before the boundary stops trusting it is a policy decision about this repository,
# and a policy that an environment variable can change at the moment it binds is not a policy.
# TEN: this repo took 13 commits between origin/main and the tip inside a single build, so 10
# forces roughly one full bar per build rather than one per push. The design pass recommended 1 —
# behaviourally today's bar — and that was refused on the record: the owner's stated goal is to
# stop paying the full bar per landing, and 1 defers essentially all of the saving. Lowering it
# later needs no code.
# COUNTED IN FIRST-PARENT LANDINGS (TOOL-aFrugalTurnstile-1 S1, design D1), the unit the runner's
# INHERITED_RED_MAX_AGE already counts in. Counting every commit charged a green earned on a branch
# tip for every commit each other build's landing carried in while that branch was open, so a
# multi-commit landing fell past the bound and paid a full bar at the push boundary.
# WHAT THE FIRST-PARENT COUNT DOES NOT CHECK: how many commits a landing's side branch carried. It
# trusts the recorded sha to speak for them, which predicates 2 and 5 constrain and the count does
# not; under a doc-only push, where predicate 5 is waived, a long doc branch now counts as one landing.
GATE_FULL_MAX_LAG=10

# ---- WHICH RED BLOCKS, READ AT R AND NEVER FROM THE PUSHED TREE — TOOL-dWitnessedBar-3, -dDerivedDocket-24
# The policy key `verdict.blocks` decides whether a push may land over a red bar: the runner joins each
# red's attribution class to `block` or `pass` under it (`lib-verdict.sh` in its kit), and a red bar
# lands only when every attribution row reads `pass`. It is read through the policy kit's own reader,
# `policy.py get verdict.blocks --rev <R>`, at the remote sha git fed this hook — R, the landing base,
# which only a gated push can move — so a branch that loosens its own policy file enables nothing.
# The kit is found by `resolve_kit_dir`, a copy under the pushing tree vetted by `check_reviewed_file`
# first, as the floor reader below finds the loop kit. NO POLICY KIT reads the catalogue default
# `own-only`, said on the policy line; a reader that exits non-zero or answers outside `own-only
# own-mixed-contended every-red` reads `every-red`, because a typo must not land a red, and so does a
# remote with no tip, where nothing can read INHERITED.
#
# THE AGE BOUND STAYS IN THE GATE FILE: `INHERITED_RED_MAX_AGE=<n>`, counted in first-parent landings,
# is PARSED out of that file as committed at R and never executed: one anchored match, a trailing
# comment and one pair of quotes stripped, then validated as a positive integer. It decides no landing —
# it escalates the ask the unattended driver files.
#
# THE RELATIVE PATH IS DERIVED from the one the source reads, so this hook spells the file once. The
# names are cleared so neither a sourced assignment nor the caller's environment reaches the
# runner under a name only this block may set. `read_policy_key` below is byte-identical to the
# unattended driver's copy: this hook ships verbatim and sources no kit, so the one parse of this
# file is spelled twice, and the two readers must never disagree about a line.
# `GATE_POST_MERGE` is cleared with them (TOOL-aFrugalTurnstile-7 S1): only R declares it, as `PM_DECL`.
_gate_env_rel=${_gate_env#"$(git rev-parse --show-toplevel 2>/dev/null)"/}
unset INHERITED_RED_MAX_AGE GATE_VERDICT_BLOCKS GATE_INHERITED_RED_MAX_AGE GATE_POST_MERGE

read_policy_key() { # file text · key -> the LAST `<key>=` line's value, cleaned; nothing when none assigns it
  local line v="" hit=""
  while IFS= read -r line || [ -n "$line" ]; do
    line=${line%$'\r'}
    case "$line" in "$2="*) v=${line#"$2="}; hit=1 ;; esac
  done <<< "$1"
  [ -n "$hit" ] || return 0
  v=${v%%[[:space:]]#*}
  while [ "${v% }" != "$v" ] || [ "${v%$'\t'}" != "$v" ]; do v=${v%?}; done
  while [ "${v# }" != "$v" ]; do v=${v# }; done
  case "$v" in
    \"*\") v=${v#\"}; v=${v%\"} ;;
    \'*\') v=${v#\'}; v=${v%\'} ;;
  esac
  printf '%s' "$v"
}

PP_READ_AT=""; PP_HELD=on-demand; PP_BYPASS=allowed; PP_BYPASS_WHY=""
read_policy_at() { # sha -> PP_POLICY (own-only|own-mixed-contended|every-red), PP_MAX_AGE (the positive bound declared, or empty), PP_WHY, PP_HELD (verdict.held), PP_BYPASS and PP_BYPASS_WHY (hooks.bypass)
  local sha=$1 blob age="" bnd py dir="" rel tree val rc
  # READ ONCE PER SHA: the doc class and the policy line ask for the same R.
  [ -n "$sha" ] && [ "$sha" = "$PP_READ_AT" ] && return 0
  PP_POLICY=every-red; PP_MAX_AGE=""; PP_WHY=""; PP_HELD=on-demand; PP_BYPASS=allowed; PP_BYPASS_WHY=""
  if [ -z "$sha" ] || [ -z "${sha//0/}" ]; then
    PP_WHY="the remote holds no tip for $def yet, so there is no R to read a policy at"; return 0
  fi
  PP_READ_AT=$sha
  if blob=$(git show "$sha:$_gate_env_rel" 2>/dev/null); then
    age=$(read_policy_key "$blob" INHERITED_RED_MAX_AGE)
    case "$age" in ''|0*|*[!0-9]*) age="" ;; esac
  fi
  if [ -n "$age" ]; then bnd="an age bound of $age first-parent landings from $_gate_env_rel there, which escalates an aged leg's ask"
  else bnd="no age bound in $_gate_env_rel there, so no leg is aged"; fi
  if py=$(resolve_python 2>/dev/null); then
    for tree in "$top" "$(cd "${0%/*}/.." && pwd)"; do
      dir=$(resolve_kit_dir "$py" policy policy.py "$tree/${GOV_KITROOT:-.}" 2>/dev/null) || { dir=""; continue; }
      rel="${dir%$'\r'}/policy.py"
      [ "$tree" != "$top" ] || [ -z "$main_local" ] || check_reviewed_file "$rel" "$main_local" "is read for verdict.blocks"
      rc=0; val=$(cd "$top" && "$py" "$tree/$rel" get verdict.blocks --rev "$sha" 2>/dev/null) || rc=$?
      val=${val%$'\r'}
      # `verdict.held` at the same R (TOOL-dWitnessedBar-5 S6): an answer outside its three values, or
      # none, reads as the catalogue default `on-demand`, which exports nothing.
      PP_HELD=$(cd "$top" && "$py" "$tree/$rel" get verdict.held --rev "$sha" 2>/dev/null) || PP_HELD=""
      PP_HELD=${PP_HELD%$'\r'}
      case "$PP_HELD" in peer-or-cadence|push-selected|on-demand) ;; *) PP_HELD=on-demand ;; esac
      # `hooks.bypass` at the same R (TOOL-dWitnessedBar-2 S1): an answer outside its two values, or
      # none, reads as the catalogue default `allowed`, and PP_BYPASS_WHY says so.
      PP_BYPASS=$(cd "$top" && "$py" "$tree/${dir%$'\r'}/policy.py" get hooks.bypass --rev "$sha" 2>/dev/null) || PP_BYPASS=""
      PP_BYPASS=${PP_BYPASS%$'\r'}
      case "$PP_BYPASS" in
        allowed|refused) ;;
        *) PP_BYPASS_WHY="the reader, policy.py get, answered '${PP_BYPASS:-nothing}' at ${sha:0:8}, so hooks.bypass reads its catalogue default, allowed"
           PP_BYPASS=allowed ;;
      esac
      break
    done
  fi
  if [ -z "$dir" ]; then
    PP_POLICY=own-only; PP_MAX_AGE=$age
    PP_WHY="no policy kit resolves, so the catalogue default own-only applies, with $bnd"; return 0
  fi
  case "$rc:$val" in
    0:own-only|0:own-mixed-contended|0:every-red)
      PP_POLICY=$val; PP_MAX_AGE=$age; PP_WHY="read by policy.py get, with $bnd" ;;
    *) PP_MAX_AGE=$age
       PP_WHY="policy.py get verdict.blocks exited $rc answering '$val', outside 'own-only own-mixed-contended every-red', which reads every-red" ;;
  esac
}

gd=$(git rev-parse --git-dir 2>/dev/null)
kitfp=""; [ -n "$GATE_RUNNER" ] && kitfp="$top/${GATE_RUNNER%/*}/gate-fingerprint.sh"
force=""; lag=0
rec_sha=""; rec_fp=""; rec_blob=""; rec_man=""; rec_st=""; rec_reused=""; rec_reused_cache=""
read_green_file() { # path -> rec_sha rec_fp rec_blob rec_man rec_st rec_reused rec_reused_cache, each empty when absent
  local _rg_l="" _rg_k="" _rg_v=""
  rec_sha=""; rec_fp=""; rec_blob=""; rec_man=""; rec_st=""; rec_reused=""; rec_reused_cache=""
  [ -f "$1" ] || return 0
  # Each key as the runner's `read_record_keys` and `read_tag_lines` read it: each line is read WHOLE,
  # so its CR reaches the strip; a line with no TAB is no key (TOOL-dWitnessedBar-63 S19); the value is
  # everything after the first TAB (-62 S24); one trailing CR is stripped and the last line of a
  # repeated key wins (-65 S15, -69 S1). An unreadable file leaves every variable empty.
  while IFS= read -r _rg_l || [ -n "$_rg_l" ]; do
    case "$_rg_l" in
      *$'\t'*) ;;
      *) _rg_l=""; continue ;;
    esac
    _rg_k=${_rg_l%%$'\t'*}; _rg_v=${_rg_l#*$'\t'}
    _rg_v=${_rg_v%$'\r'}
    case "$_rg_k" in
      sha) rec_sha=$_rg_v ;;
      fingerprint) rec_fp=$_rg_v ;;
      manifest_blob) rec_blob=$_rg_v ;;
      # WHICH MANIFEST THE BLOB BELONGS TO (TOOL-aFrugalTurnstile-1 S4). Absent reads as the kit sibling,
      # in check_green_record, because that is what every stamp written before the key existed ran.
      manifest) rec_man=$_rg_v ;;
      # WHAT THE RECORDED GREEN COVERED. Absent reads as OFF, and that default is the migration: every
      # stamp written before TOOL-dUnstalledConvoy-26 lacks this key, and defaulting the missing case to
      # "covered everything" would make each of them certify legs it never ran.
      selftests) rec_st=$_rg_v ;;
      # HOW MANY LEGS THE RUN REUSED, and how many of them from the cache (TOOL-aSparedSpawn-13 S8, -32
      # S8), the pair predicate 9 reads. Each is empty when absent; what an absent one means is
      # predicate 9's to say.
      reused) rec_reused=$_rg_v ;;
      reused_cache) rec_reused_cache=$_rg_v ;;
    esac
    _rg_l=""
  done 2>/dev/null < "$1"
}

# THE CANDIDATE STAMPS (TOOL-dThriftyLanding-2). `--git-dir` is per WORKTREE, so a full green earned in
# a run's own worktree was invisible to the primary tree's push, which paid the whole bar again. The
# stamp is self-validating — predicates 2 to 9 check that its sha is an ancestor of the pushed tip,
# that its tree fingerprint reproduces AT that sha, and that the manifest it names is this one — so
# WHERE it was written does not change what it proves. Three candidates, in this order, each path once:
# this git dir's own stamp; the common dir's own, which is the primary tree's; and the common dir's
# `gate-full-green.shared`, which the runner writes from a LINKED worktree and never into the primary's
# file. The first that passes is adopted. ORDER is what keeps this strictly additive: a candidate is
# read only when every one before it would have forced the full bar, so sharing can turn a FULL
# decision scoped and can never turn a scoped one FULL.
_gcd=$(git rev-parse --git-common-dir 2>/dev/null) || _gcd=""
_gd_abs=$(cd "$gd" 2>/dev/null && pwd -P) || _gd_abs=""
_gcd_abs=""; [ -n "$_gcd" ] && _gcd_abs=$(cd "$_gcd" 2>/dev/null && pwd -P)
green_candidates=("$gd/gate-full-green")
if [ -n "$_gcd_abs" ]; then
  [ "$_gcd_abs" != "$_gd_abs" ] && green_candidates+=("$_gcd_abs/gate-full-green")
  green_candidates+=("$_gcd_abs/gate-full-green.shared")
fi
green_label() { # candidate index -> how the decision line names it
  case "$1" in
    0) printf 'this git dir' ;;
    *) case "${green_candidates[$1]}" in *.shared) printf "the common dir's gate-full-green.shared" ;;
                                          *) printf "the common dir's gate-full-green" ;; esac ;;
  esac
}
rec_from=""; rec_word="full green"; rec_base=""

# THE RUNNER'S VERDICT PER TREE (TOOL-dWitnessedBar-4 S3). The runner writes what its latest bar said
# about a tree into the common dir, `gate-verdict/<tree hash>` for a full run and `.scoped` for a scoped
# one (two slots, so a scoped run never overwrites the full record its base rests on), GREEN or not. The
# PUSHED tree's two files are the candidates here, the full one first; one is adopted only when it reads
# `verdict GREEN` and passes the predicates a runner stamp passes, and only for the runner's own bar: a
# wrapper bar finds no record for its own command and runs, which costs a saving, never a verdict.
# `verdict_path <tree>` is the full slot's path, and `check_bar_base` asks it for a base's tree.
verdict_path() { printf '%s/gate-verdict/%s' "$_gcd_abs" "$1"; }
bar_candidates=(); _tip_tree=""
[ -n "$main_local" ] && _tip_tree=$(git rev-parse -q --verify "$main_local^{tree}" 2>/dev/null)
if [ -n "$_gcd_abs" ] && [ -n "$_tip_tree" ]; then
  bar_candidates=("$(verdict_path "$_tip_tree")" "$(verdict_path "$_tip_tree").scoped")
fi
# read_bar_file <path> — every key a per-tree verdict or a runner stamp carries, by builtins alone, so
# a candidate costs no process. Each is empty when the file or the key is absent. `bg_sel_rows` holds
# each `selection.<n>` value at index <n> (TOOL-dWitnessedBar-41 S2), an index of up to six digits.
read_bar_file() {
  local _rb_l="" _rb_k="" _rb_v="" _rb_n=""
  bg_sha=""; bg_tree=""; bg_kind=""; bg_base=""; bg_st=""; bg_run=""; bg_by=""
  bg_fp=""; bg_blob=""; bg_man=""; bg_verdict=""; bg_reused=""; bg_reused_cache=""
  bg_age=""; bg_blocks=""; bg_sel=""; bg_sel_rows=()
  [ -f "$1" ] || return 0
  # One read rule for every green record, `read_green_file`'s (TOOL-dWitnessedBar-69 S1, -78 S7): each
  # line is read WHOLE, an unterminated last one included; a line with no TAB is no key (-63 S19), so a
  # bare `selection.<n>` never reads its own key as its value; the value is everything after the first
  # TAB, byte for byte, so a `selection.<n>` row keeps an empty last field's TAB (-56 S1); one trailing
  # CR is stripped, as `read_tag_lines` strips it from every value; the last line of a repeated key wins.
  while IFS= read -r _rb_l || [ -n "$_rb_l" ]; do
    case "$_rb_l" in
      *$'\t'*) ;;
      *) _rb_l=""; continue ;;
    esac
    _rb_k=${_rb_l%%$'\t'*}; _rb_v=${_rb_l#*$'\t'}
    _rb_v=${_rb_v%$'\r'}
    case "$_rb_k" in
      sha) bg_sha=$_rb_v ;;
      tree) bg_tree=$_rb_v ;;
      kind) bg_kind=$_rb_v ;;
      base) bg_base=$_rb_v ;;
      selftests) bg_st=$_rb_v ;;
      run_id) bg_run=$_rb_v ;;
      by) bg_by=$_rb_v ;;
      verdict) bg_verdict=$_rb_v ;;
      fingerprint) bg_fp=$_rb_v ;;
      manifest_blob) bg_blob=$_rb_v ;;
      manifest) bg_man=$_rb_v ;;
      reused) bg_reused=$_rb_v ;;
      reused_cache) bg_reused_cache=$_rb_v ;;
      max_age) bg_age=$_rb_v ;;
      blocks) bg_blocks=$_rb_v ;;
      selection) bg_sel=$_rb_v ;;
      selection.[1-9]*)
        _rb_n=${_rb_k#selection.}
        case "$_rb_n" in *[!0-9]*|???????*) ;; *) bg_sel_rows[$_rb_n]=$_rb_v ;; esac ;;
    esac
    _rb_l=""
  done 2>/dev/null < "$1"
}

# read_inherited_green <path> — the ten `ig_*` keys of `gate-inherited-green`, read through
# `read_bar_file` (TOOL-dWitnessedBar-78 S8) under `bg_*` locals, so a caller's record is kept.
read_inherited_green() {
  local bg_sha bg_tree bg_kind bg_base bg_st bg_run bg_by bg_fp bg_blob bg_man bg_verdict bg_reused bg_reused_cache bg_age bg_blocks bg_sel bg_sel_rows
  read_bar_file "$1"
  ig_sha=$bg_sha; ig_fp=$bg_fp; ig_blob=$bg_blob; ig_man=$bg_man; ig_st=$bg_st
  ig_base=$bg_base; ig_age=$bg_age; ig_blocks=$bg_blocks; ig_reused=$bg_reused; ig_reused_cache=$bg_reused_cache
}

# check_green_manifest <manifest path> <label> — TOOL-aFrugalTurnstile-1's manifest rule, one copy
# for predicate 7 and the cover pass. Sets `force`, empty when the record ran this kit's manifest.
check_green_manifest() {
  force=""
  [ "${1:-${KP}gate-legs.json}" = "${KP}gate-legs.json" ] && return 0
  force="the recorded $2 was earned on the leg manifest $1, and the bar this push runs reads ${KP}gate-legs.json"
}

# PREDICATES 2 TO 8, ONE FUNCTION, TWO RECORDS (TOOL-dDerivedDocket-24), and 9 in `check_green_reuse`
# below, which only a runner stamp's two callers run. They were inline and read
# the full green's fields; the inherited green below must pass exactly the same seven, so the seven
# became one function over a record's five fields rather than a second copy of them. The label is the
# only thing that differs, and it is spelled `full green` for the full green, so every message that
# record printed before is byte-identical. Sets `force` to the first predicate the record fails, or
# empty, and `lag` to its distance behind the tip.
# The runner's per-tree verdict passes the same function with its own five fields (TOOL-dWitnessedBar-4
# S3), so it is held to exactly what a runner stamp is held to.
check_green_record() { # sha · fingerprint · manifest blob · manifest path · selftests · label
  local r_sha=$1 r_fp=$2 r_blob=$3 r_man=${4:-${KP}gate-legs.json} r_st=$5 label=$6 p2 fresh now_blob
  force=""; lag=0
  # 2. the recorded green is not an ancestor of what is being pushed, so it describes another line of
  #    history entirely.
  if ! git merge-base --is-ancestor "$r_sha" "$main_local" 2>/dev/null; then
    force="the recorded $label ${r_sha:0:8} is not an ancestor of the pushed tip"; return 0
  fi
  # 3. the recorded green is further behind the tip than the bound allows, in first-parent landings.
  lag=$(git rev-list --first-parent --count "$r_sha..$main_local" 2>/dev/null || echo 0)
  if [ "${lag:-0}" -gt "$GATE_FULL_MAX_LAG" ]; then
    force="the recorded $label is $lag first-parent landings behind the tip (bound $GATE_FULL_MAX_LAG)"; return 0
  fi
  # 4. the record's TREE fingerprint does not reproduce AT THE SHA IT NAMES.
  #    AT THE RECORDED SHA, never at the tip. The digest is taken over the committed tree object, so
  #    it moves on every commit; joining it against a fresh fingerprint of the PUSHED TIP would fire
  #    on every push whose tree had moved, which is exactly the population predicates 2 and 3 already
  #    admit — it would force full forever while reading as caution. The helper is CALLED, never
  #    reimplemented: two implementations of one digest disagree silently and then force forever.
  if [ -n "$r_fp" ] && [ -x "$kitfp" ]; then
    fresh=$(bash "$kitfp" "$r_sha" 2>/dev/null)
    if [ -n "$fresh" ] && [ "$fresh" != "$r_fp" ]; then
      force="the recorded tree fingerprint does not reproduce at ${r_sha:0:8}"; return 0
    fi
  fi
  # 5. the pushed tip is a MERGE whose second parent the record cannot speak for. Every build lands
  #    on the default branch here as a merge commit, so this row fires on any first-attempt landing
  #    whose recorded green was not earned on that exact second parent — not only on a retry. Kept at
  #    that width deliberately: a merge tip the record does not cover is precisely the case the record
  #    cannot speak for.
  #    WAIVED ON A DOC-ONLY PUSH (TOOL-dThriftyLanding-3). What the record cannot speak for here is
  #    the CODE the second parent brings in; on a doc-only push nothing outside the doc class moved,
  #    and every leg reading a doc that did move still runs. Predicates 2 to 4 and 6 to 8, the lag
  #    bound among them, still force.
  p2=$(git rev-parse -q --verify "$main_local^2" 2>/dev/null || true)
  if [ -z "$DOCS_ONLY" ] && [ -n "$p2" ] && ! git merge-base --is-ancestor "$p2" "$r_sha" 2>/dev/null; then
    force="the pushed tip is a merge whose second parent ${p2:0:8} the recorded green does not cover"; return 0
  fi
  # 6. the diff touches the LEG MANIFEST, so the scoping decision itself has changed. A guard added,
  #    widened or removed in this very push cannot be trusted to scope this very push.
  if ! git diff --quiet "$r_sha" "$main_local" -- "${KP}gate-legs.json" 2>/dev/null; then
    force="the pushed diff touches the leg manifest, so the scoping rules themselves moved"; return 0
  fi
  # 7. the recorded manifest blob differs from the one this tree holds — the same concern as 6, from
  #    the record's side, and it catches an uncommitted or differently-resolved manifest that a diff
  #    between two commits cannot see.
  #    A record earned on ANOTHER manifest is refused first (TOOL-aFrugalTurnstile-1 S5): a nested
  #    runner inside a wrapper bar stamps a green of its own subset, and only the blob kept it out.
  #    WHAT THE MANIFEST PATH DOES NOT CHECK: that the recorded path held these bytes when the stamp was
  #    written. The blob compare below checks that; the path only says which manifest the blob belongs to.
  check_green_manifest "$r_man" "$label"; [ -n "$force" ] && return 0
  if [ -n "$r_blob" ]; then
    now_blob=$(git hash-object -- "${KP}gate-legs.json" 2>/dev/null)
    if [ -n "$now_blob" ] && [ "$now_blob" != "$r_blob" ]; then
      force="the leg manifest differs from the one the recorded green was earned on"; return 0
    fi
  fi
  # 8. the recorded green was earned with the KIT-SUBJECT legs HELD, and this push would run them.
  #    COVERAGE, not equality. A record earned with the self-tests ON is strictly stronger evidence
  #    than a switch-off push needs, so it satisfies one — forcing there would cost every adopter the
  #    whole saving TOOL-dUnstalledConvoy-26 exists to give, at the one boundary it was measured for.
  #    The relation only bites in the other direction: a weaker record offered for a stronger push.
  #    Without this predicate the `selftests` field the stamp writes is a byte nobody consults, and
  #    the boundary trusts a partial bar as a whole one. TOOL-dUnstalledConvoy-27.
  if [ -n "${GATE_SELFTESTS:-}" ] && [ "$r_st" != "1" ]; then
    force="this push runs the kit self-tests and the recorded $label was earned with them HELD"; return 0
  fi
  return 0
}

# check_green_reuse <label> <reused> <reused_cache> — predicate 9, read only from a runner stamp, after
# predicates 2 to 8 pass. Its own function since the reconcile of TOOL-aSparedSpawn-32: the record
# signature above gained the manifest path and the bar pair on one side, and this pair on the other.
# 9. the record says its run reused a leg FROM THE CACHE (TOOL-aSparedSpawn-13 S8, composed by -32 S8).
#    The runner never stamps one, so a record that says so was written some other way, and a cached
#    verdict is copied rather than earned: it can never satisfy the full-green predicate. A non-zero
#    `reused_cache` forces. A record with NO `reused_cache` and a non-zero `reused` forces too, because
#    it was written before the field existed and cannot say which kind it reused, so it is read as the
#    cache. A `reused` above 0 beside `reused_cache 0` is a lineage stamp, whose reuses full runs
#    earned (TOOL-aFrugalTurnstile-4 S3), and it does not force.
check_green_reuse() {
  local label=$1 r_reused=${2:-} r_cache=${3:-}
  force=""
  if [ -n "$r_cache" ] && [ "$r_cache" != 0 ]; then
    force="the recorded $label says its run reused $r_cache leg(s) from the cache, and a reused verdict proves nothing whole"; return 0
  fi
  if [ -z "$r_cache" ] && [ -n "$r_reused" ] && [ "$r_reused" != 0 ]; then
    force="the recorded $label says its run reused $r_reused leg(s), and a reused verdict proves nothing whole"; return 0
  fi
  return 0
}

# check_tree_verdict <label> — whether the per-tree verdict read_bar_file last read is adoptable: it
# reads `verdict GREEN`, names a sha, and passes predicates 2 to 9 as a runner stamp does
# (TOOL-dWitnessedBar-4 S3). Sets `force` to its first failure or empty, and `lag`.
check_tree_verdict() {
  force=""; lag=0
  if [ "$bg_verdict" != GREEN ]; then force="it reads verdict '${bg_verdict:-none}', not GREEN"; return 0; fi
  if [ -z "$bg_sha" ]; then force="it names no sha"; return 0; fi
  check_green_record "$bg_sha" "$bg_fp" "$bg_blob" "$bg_man" "$bg_st" "$1"
  [ -z "$force" ] && check_tree_reuse "$1"
  [ -z "$force" ] && check_tree_selection "$1"
  return 0
}

# check_selection_at_r <--run|--selection> <path> — whether R derives the selection a bar held legs by,
# through the pushed tree's own `verdict_flow.py select --check` (TOOL-dWitnessedBar-5 S7), for the
# run record of the bar this hook ran (`--run`) and a per-tree verdict's rebuilt rows (`--selection`,
# TOOL-dWitnessedBar-41 S2). Sets SEL_NOT empty, or to the reason. The checker is vetted as the bar is:
# a refusal of `check_reviewed_file` exits the hook.
check_selection_at_r() {
  local rel py out
  SEL_NOT=""; rel="${GATE_RUNNER%/*}/verdict_flow.py"
  if [ -z "$GATE_RUNNER" ]; then
    SEL_NOT="the bar held legs by a selection and no run-gates kit resolves to re-derive it at R"
  elif [ -z "${main_remote//0/}" ]; then
    SEL_NOT="the bar held legs by a selection and the remote holds no tip, so there is no R to re-derive it at"
  elif ! py=$(resolve_python 2>/dev/null); then
    SEL_NOT="the bar held legs by a selection and no usable python can re-derive it at R"
  elif check_reviewed_file "$rel" "$main_local" "is run to re-derive the bar's selection at R" \
       && ! out=$(cd "$top" && "$py" "$rel" select --check "$1" "$2" --rev "$main_remote" 2>&1); then
    SEL_NOT="the bar's selection is not what ${main_remote:0:8} derives: $(printf '%s' "$out" | tr '\n' ' ')"
  fi
  return 0
}

# check_tree_selection <label> — whether the selection the per-tree verdict read_bar_file last read
# names is one R derives, for both of its readers (TOOL-dWitnessedBar-41 S2, S3). No `selection` key
# refuses, since the record cannot say whether its bar held legs; `none` passes; a hash is checked
# against the rows rebuilt from `selection.1` upward, each `held` and a TAB before the value as written,
# whose TABs the runner keeps (TOOL-dWitnessedBar-56 S1), so a ` · ` inside a note round-trips, then
# `select --check --selection` runs over them at R. SEL_SEEN keeps one
# `<hash>TAB<force>` line per hash checked, so a push runs that check at most once per hash. Sets
# `force` to the failure or empty.
SEL_SEEN=""
check_tree_selection() {
  local i rows f h seen
  force=""
  if [ -z "$bg_sel" ]; then
    force="the recorded $1 carries no selection, so it cannot say whether its bar held legs"; return 0
  fi
  [ "$bg_sel" = none ] && return 0
  rows=""; i=1
  while [ -n "${bg_sel_rows[$i]+x}" ]; do rows+="held"$'\t'"${bg_sel_rows[$i]}"$'\n'; i=$((i + 1)); done
  if ! f=$(mktemp 2>/dev/null) || [ -z "$f" ]; then
    force="the recorded $1's selection could not be rebuilt: no scratch file could be made"; return 0
  fi
  printf '%s' "$rows" > "$f"
  h=$(git hash-object --stdin < "$f" 2>/dev/null)
  if [ -z "$h" ] || [ "$h" != "$bg_sel" ]; then
    rm -f "$f"; force="the recorded $1's selection rows do not hash to ${bg_sel:0:8}, so a row was edited or lost"; return 0
  fi
  while IFS=$'\t' read -r h seen; do
    [ "$h" = "$bg_sel" ] || continue
    rm -f "$f"; force=$seen; return 0
  done <<<"$SEL_SEEN"
  check_selection_at_r --selection "$f"
  rm -f "$f"
  force=$SEL_NOT
  SEL_SEEN+="$bg_sel"$'\t'"$force"$'\n'
  return 0
}

# check_tree_reuse <label> — predicate 9 over the per-tree verdict read_bar_file last read, for both of
# its readers, `check_tree_verdict` and the cover pass (TOOL-dWitnessedBar-40 S4). A runner stamp with
# neither reuse key forces nothing, which older stamps rely on; a per-tree verdict carrying neither
# cannot say whether its run reused a leg, so it forces. Sets `force` to the failure or empty.
check_tree_reuse() {
  force=""
  if [ -z "$bg_reused" ] && [ -z "$bg_reused_cache" ]; then
    force="the recorded $1 carries neither reused nor reused_cache, so it cannot say whether its run reused a leg"; return 0
  fi
  check_green_reuse "$1" "$bg_reused" "$bg_reused_cache"
}

# check_bar_record <path> — whether the pushed tree's per-tree verdict is adoptable as this push's
# scoped base (TOOL-aFrugalTurnstile-2 S3b, TOOL-dWitnessedBar-4 S3). Sets `force` to its first failure
# or empty, `lag`, and bg_* to that record. A `kind scoped` record at M is adoptable only on a base B
# that is itself a full green this push would adopt, and `lag` is then B's: M's own lag is checked too,
# which can only refuse more, so a chain of scoped records never stands further from a full green than
# the bound.
check_bar_record() {
  read_bar_file "$1"
  case "$bg_kind" in
    full|scoped) ;;
    *) force="its kind reads '${bg_kind:-none}', neither full nor scoped"; lag=0; return 0 ;;
  esac
  check_tree_verdict "$bg_kind tree verdict"
  [ -z "$force" ] && [ "$bg_kind" = scoped ] && check_bar_base "$bg_base"
  return 0
}

# check_bar_base <sha> — `force` empty, and `lag` counted from <sha>, when a runner stamp or the full
# per-tree verdict of <sha>'s tree names exactly that sha and passes predicates 2 to 9. The readers
# write LOCAL copies here, so the caller's record is kept.
check_bar_base() {
  local want=$1 f found="" bt
  local bg_sha bg_tree bg_kind bg_base bg_st bg_run bg_by bg_fp bg_blob bg_man bg_verdict bg_reused bg_reused_cache bg_age bg_blocks bg_sel bg_sel_rows
  if [ -z "$want" ]; then force="it is a scoped green that names no base"; return 0; fi
  for f in "${green_candidates[@]}"; do
    read_bar_file "$f"
    [ "$bg_sha" = "$want" ] || continue
    check_green_record "$bg_sha" "$bg_fp" "$bg_blob" "$bg_man" "$bg_st" "full green"
    [ -z "$force" ] && return 0
    found=$force
  done
  bt=$(git rev-parse -q --verify "$want^{tree}" 2>/dev/null)
  if [ -n "$bt" ] && [ -n "$_gcd_abs" ]; then
    read_bar_file "$(verdict_path "$bt")"
    if [ "$bg_kind" = full ] && [ "$bg_sha" = "$want" ]; then
      check_tree_verdict "full tree verdict"
      [ -z "$force" ] && return 0
      found=$force
    fi
  fi
  force="its base ${want:0:8} is no full green this push can adopt${found:+: $found}"
}

# ---- THE DOC CLASS, READ AT R — TOOL-dThriftyLanding-3 -----------------------------------------
# Whether this push changes only non-code paths. Which paths are non-code is a per-repository answer,
# so it is DECLARED: `GATE_DOC_PATHS` in the gate-env file, a space-separated list of repo paths, each a
# file or a directory ending in `/`. It is PARSED at R exactly as the inherited-red keys are, and never
# read from the pushed tree, which could otherwise classify its own code as a doc. The push is doc-only
# when R is an ancestor of the pushed tip, something differs between them, and no path outside the class
# appears in their net diff OR in any commit between them: a code file added and removed again inside
# the range is still code a leg should have seen. That read is `--full-history` (TOOL-dThriftyLanding-9):
# git's default simplification drops a `--no-ff` merge's side branch that nets to nothing on the paths
# asked about, and every landing here is such a merge. Every failure, and every element that is not a plain
# repo path, reads as NOT doc-only, which is the decision this hook made before the class existed.
# The same blob carries the post-merge declaration (TOOL-aFrugalTurnstile-7 S1), so it is read here, at no
# extra spawn, before the doc class can return early; an absent R or file leaves it undeclared.
DOCS_ONLY=""; DOCS_N=0; DOCS_WHY=""; PM_DECL=""
classify_docs() {
  local blob spec all nd nl
  local -a specs=() excl=()
  [ -n "$main_remote" ] && [ -n "${main_remote//0/}" ] && [ -n "$main_local" ] || return 0
  blob=$(git show "$main_remote:$_gate_env_rel" 2>/dev/null) || return 0
  PM_DECL=$(read_policy_key "$blob" GATE_POST_MERGE)
  read -ra specs <<<"$(read_policy_key "$blob" GATE_DOC_PATHS)"
  [ "${#specs[@]}" -gt 0 ] || return 0
  for spec in "${specs[@]}"; do
    case "$spec" in
      :*|/*|*'*'*|*'?'*|*'['*|..|../*|*/..|*/../*|.|./*)
        DOCS_WHY="GATE_DOC_PATHS at ${main_remote:0:8} holds '$spec', which is not a plain repo path, so no doc class applies"
        return 0 ;;
    esac
    excl+=(":(exclude,literal)$spec")
  done
  git merge-base --is-ancestor "$main_remote" "$main_local" 2>/dev/null || return 0
  all=$(git diff --no-renames --name-only "$main_remote" "$main_local" -- 2>/dev/null) || return 0
  [ -n "$all" ] || return 0
  nd=$(git diff --no-renames --name-only "$main_remote" "$main_local" -- . "${excl[@]}" 2>/dev/null) || return 0
  nl=$(git log --full-history --no-renames --format= --name-only "$main_remote..$main_local" -- . "${excl[@]}" 2>/dev/null) || return 0
  [ -z "$nd$nl" ] || return 0
  # NEVER UNDER `every-red` AT R (TOOL-dThriftyLanding-12, closing review M2; TOOL-dWitnessedBar-3 §8
  # F8). The docs mode grades against R while the record it scopes from may sit below R, so a leg
  # already red at an unproven R could be docskipped and a push land over it. Under every other value
  # that red lands anyway, as an INHERITED row reading `pass`; under `every-red` it must not, so an
  # every-red repository keeps today's decision for every push.
  read_policy_at "$main_remote"
  if [ "$PP_POLICY" = every-red ]; then
    DOCS_WHY="the push changes only GATE_DOC_PATHS, but verdict.blocks at ${main_remote:0:8} reads $PP_POLICY, so it is not scoped as doc-only"
    return 0
  fi
  DOCS_ONLY=1; DOCS_N=$(printf '%s\n' "$all" | grep -c .)
}
classify_docs
[ -n "$DOCS_WHY" ] && echo "pre-push: $DOCS_WHY" >&2
# Any value but `local` or `ci` is still read as declared: a typo must not land a red.
case "$PM_DECL" in
  ''|local|ci) ;;
  *) echo "pre-push: GATE_POST_MERGE at ${main_remote:0:8} is '$PM_DECL', outside 'local ci', and is read as declared" ;;
esac

# WHEN A HELD LEG RUNS AT THIS PUSH (TOOL-dWitnessedBar-5 S6): `verdict.held` read at R. Under
# `push-selected`, where the pusher set no `GATE_SELFTESTS`, this hook exports the `changed` selection
# for its bar, so the held legs whose kit the push moved run. Exported BEFORE the recorded greens are
# read, so predicate 8 asks of each the coverage this push's bar would have. `on-demand`, the default,
# exports nothing; `peer-or-cadence` holds them here, its runner elsewhere checked by
# `verdict_flow.py select`. The rule is `verdict_flow.py#derive_held_export`'s, spelled once more here.
read_policy_at "$main_remote"
if [ "$PP_HELD" = push-selected ] && [ -z "${GATE_SELFTESTS:-}" ]; then
  # One statement, so govkit 7h3 never reads this policy-derived export as a policy the hook ships.
  GATE_SELFTESTS=changed && export GATE_SELFTESTS \n    && echo "pre-push: verdict.held at ${main_remote:0:8} reads push-selected, so this bar runs the held legs the push moved (GATE_SELFTESTS=changed)"
fi

# ---- EACH HOOK BYPASS RECORDED, AND REFUSED UNDER `hooks.bypass = refused` — TOOL-dWitnessedBar-2 ----
# `hooks.bypass` is read at R by `read_policy_at` above, beside `verdict.held`, never from the pushed
# tree. S5: the pushed range R..tip is walked through the memory-tree kit's copy of the one trailer
# reader, its `unchecked` verb, which lists each non-merge commit whose `Pass:` trailer names a unit and
# that carries no `Commit-Checked:` value, the trailer the unattended commit check writes onto a pass
# commit it admitted: so each one listed was made past the commit hooks. Each is recorded through
# `write_bypass_line`, and under `allowed` the push proceeds. S6: under `refused` the run-gates kit's
# registry is asked, by its `off-node` verb, whether the `verdict` row is off-node, and every landing is
# refused while it is not, because a hook on this node cannot refuse its own bypass; then any
# unwitnessed commit refuses the push, naming each SHA. Both refusals are `bypass-refused`. A kit or a
# launcher that does not resolve prints one line, and under `refused` refuses: deny by default. The
# kits are found as the policy push arm finds its own, a copy under the pushing tree vetted first.
# WHAT THIS DOES NOT CATCH: a `--no-verify` push, which runs no hook, and which the off-node bar's
# pass-order arm reads from history instead; a typed `Commit-Checked:` line, which is text; a push to a
# remote with no tip yet, which has no R to read the policy at.
if [ -z "$DECIDE" ] && [ -n "${main_local//0/}" ] && [ -n "${main_remote//0/}" ]; then
  _bp_py=$(resolve_python 2>/dev/null || true)
  _bp_ct=""; _bp_vb=""; _bp_out=""; _bp_rc=0; _bp_shas=""; _bp_miss=""
  [ -z "$PP_BYPASS_WHY" ] || echo "pre-push: $PP_BYPASS_WHY"
  if [ -n "$_bp_py" ]; then
    for _bp_tree in "$top" "$(cd "${0%/*}/.." && pwd)"; do
      if [ -z "$_bp_ct" ] && _bp_dir=$(resolve_kit_dir "$_bp_py" memory-tree commit_trailers.py "$_bp_tree/${GOV_KITROOT:-.}" 2>/dev/null); then
        [ "$_bp_tree" != "$top" ] || check_reviewed_file "${_bp_dir%$'\r'}/commit_trailers.py" "$main_local" "runs as the hook-bypass walk"
        _bp_ct="$_bp_tree/${_bp_dir%$'\r'}/commit_trailers.py"
      fi
      if [ -z "$_bp_vb" ] && _bp_dir=$(resolve_kit_dir "$_bp_py" run-gates verdict_backends.py "$_bp_tree/${GOV_KITROOT:-.}" 2>/dev/null); then
        [ "$_bp_tree" != "$top" ] || check_reviewed_file "${_bp_dir%$'\r'}/verdict_backends.py" "$main_local" "is asked whether verdict is off-node"
        _bp_vb="$_bp_tree/${_bp_dir%$'\r'}/verdict_backends.py"
      fi
    done
  fi
  if [ -z "$_bp_py" ]; then
    _bp_miss="no usable python launcher resolved"
  elif [ -z "$_bp_ct" ]; then
    _bp_miss="the memory-tree kit's commit_trailers.py is installed neither under '$top' nor beside this hook"
  elif ! _bp_out=$(cd "$top" && "$_bp_py" "$_bp_ct" unchecked "$main_remote..$main_local" 2>&1); then
    _bp_miss="the trailer reader's unchecked verb refused: ${_bp_out//$'\n'/ · }"
  fi
  if [ -n "$_bp_miss" ]; then
    echo "pre-push: the hook-bypass walk did NOT run over refs/heads/$def — $_bp_miss, so no unwitnessed pass commit in this push was recorded."
  else
    while read -r _bp_sha _; do
      # A SHA LINE ONLY: the reader's own stderr note, merged into this capture, is no commit.
      case "${#_bp_sha}:$_bp_sha" in 40:*[!0-9a-f]*|64:*[!0-9a-f]*) continue ;; 40:*|64:*) ;; *) continue ;; esac
      write_bypass_line unwitnessed-commit "$_bp_sha" "$PP_BYPASS"
      _bp_shas="$_bp_shas ${_bp_sha:0:8}"
    done <<< "${_bp_out//$'\r'/}"
    [ -z "$_bp_shas" ] || [ "$PP_BYPASS" = refused ] \
      || echo "pre-push: hooks.bypass at ${main_remote:0:8} reads allowed, so the pass commit(s)$_bp_shas, made past the commit check, are recorded and the push proceeds"
  fi
  if [ "$PP_BYPASS" = refused ]; then
    if [ -z "$_bp_py" ] || [ -z "$_bp_vb" ]; then
      _bp_rc=2; _bp_out="no run-gates kit's verdict_backends.py resolves under '$top' or beside this hook${_bp_py:-, and no usable python launcher}"
    else
      _bp_out=$(cd "$top" && "$_bp_py" "$_bp_vb" off-node 2>&1); _bp_rc=$?
    fi
    if [ "$_bp_rc" != 0 ]; then
      why="pre-push: REFUSING — hooks.bypass at ${main_remote:0:8} is refused, and verdict names no off-node backend, so nothing lands: a hook on this node cannot refuse its own bypass, and only an off-node witness can (${_bp_out//$'\n'/ · })."
      echo "$why" >&2
      echo "  Set verdict to an off-node backend the registry names, or hooks.bypass to allowed." >&2
      write_refusal bypass-refused "$why"; RUNLOG_CLEAN=1; exit 1
    fi
    if [ -n "$_bp_miss" ] || [ -n "$_bp_shas" ]; then
      why="pre-push: REFUSING — hooks.bypass at ${main_remote:0:8} is refused, and ${_bp_shas:+the pass commit(s)$_bp_shas carry no Commit-Checked: trailer, so the commit check never saw them}${_bp_miss:+the hook-bypass walk did not run: $_bp_miss}."
      echo "$why" >&2
      echo "  Remake each named commit through the unattended commit check, which writes its trailer." >&2
      write_refusal bypass-refused "$why"; RUNLOG_CLEAN=1; exit 1
    fi
  fi
fi

# 1. no record at all — nothing has ever proven this bar here. Then predicates 2 to 9, per candidate
#    (TOOL-dThriftyLanding-2). The FIRST candidate's refusal keeps its exact wording, so a clone with
#    one git dir prints every message it printed before; a later candidate that EXISTS and is refused
#    appends its own, so no refusal is silent. A later candidate that is absent adds nothing.
_green_why=""
for _gi in "${!green_candidates[@]}"; do
  _gf=${green_candidates[$_gi]}
  [ "$_gi" -gt 0 ] && [ ! -f "$_gf" ] && continue
  read_green_file "$_gf"
  force=""
  [ -n "$rec_sha" ] || force="no recorded full green"
  [ -z "$force" ] && check_green_record "$rec_sha" "$rec_fp" "$rec_blob" "$rec_man" "$rec_st" "full green"
  [ -z "$force" ] && check_green_reuse "full green" "$rec_reused" "$rec_reused_cache"
  if [ -z "$force" ]; then
    [ "$_gi" -gt 0 ] && rec_from=$(green_label "$_gi")
    break
  fi
  if [ "$_gi" = 0 ]; then _green_why=$force; else _green_why="$_green_why; $(green_label "$_gi"): $force"; fi
done
[ -n "$force" ] && force=$_green_why

# THE POLICY AT R, announced on every gated push whatever it reads, because the difference between
# the values is which red lands.
read_policy_at "$main_remote"
echo "pre-push: verdict.blocks at ${main_remote:0:8} reads $PP_POLICY — $PP_WHY (read at that sha, never from the pushed tree)"

# THE INHERITED GREEN (KF2), looked for WHENEVER predicates 1 to 9 would force FULL: the full green
# absent, or present and refused by any of 2 to 9. Reading it only when the full green is ABSENT would
# force a FULL bar on every push from a git dir that ever earned a full green, for as long as the
# default branch holds an inherited red. It selects the scoped gate only when its `blocks` IS the
# `verdict.blocks` value read at R (TOOL-dWitnessedBar-3 §8 F8), its `base` IS the remote sha on this
# hook's stdin, its `max_age` IS the bound parsed at that sha, and its `sha` passes predicates 2 to 9
# exactly as a full green would. A stamp written before `blocks` existed names none and is refused. It never satisfies
# predicate 1 in the full green's place: it is a different file, read in a different branch, and a
# FULL force it does not lift still names why it was not used.
inh_sha=""; inh_why=""
if [ -n "$force" ] && [ -f "$gd/gate-inherited-green" ]; then
  read_inherited_green "$gd/gate-inherited-green"
  full_force=$force
  if [ "$ig_blocks" != "$PP_POLICY" ]; then
    inh_why="the inherited green was written under verdict.blocks ${ig_blocks:-none} and the value at ${main_remote:0:8} is $PP_POLICY"
  elif [ -z "$ig_sha" ] || [ "$ig_base" != "$main_remote" ]; then
    inh_why="the inherited green was earned against base ${ig_base:0:8} and the remote holds ${main_remote:0:8}"
  elif [ "$ig_age" != "$PP_MAX_AGE" ]; then
    inh_why="the inherited green was written under max_age ${ig_age:-none} and the bound at ${main_remote:0:8} is $PP_MAX_AGE"
  else
    check_green_record "$ig_sha" "$ig_fp" "$ig_blob" "$ig_man" "$ig_st" "inherited green"
    [ -z "$force" ] && check_green_reuse "inherited green" "$ig_reused" "$ig_reused_cache"
    if [ -z "$force" ]; then inh_sha=$ig_sha; else inh_why="the inherited green ${ig_sha:0:8} is refused too: $force"; fi
  fi
  [ -n "$inh_sha" ] || force=$full_force
fi

# ---- WHICH BAR RUNS: GOV_GATE_CMD, vetted by `check_bar_command` above, at the pushed tip -----
gate=${GOV_GATE_CMD:-bash $GATE_RUNNER}
bar_label="$gate"
# WHETHER THE BAR THAT RUNS WRITES A RUN RECORD, decided from WHAT RUNS and never from which knob named
# it (closing diff review round 1, F8). S6 below reads that record, and it used to be skipped whenever
# GOV_GATE_CMD was set. But the declared rule admits only this kit's runner or the committed GATE_CMD,
# and in this repository those are one script, so every admissible override IS the runner: exporting
# the very value the refusals above recommend switched the envelope off, which is the environment
# SELECTING. `runner` when the program is this kit's runner by path or by blob at the pushed sha;
# `other` for a declared GATE_CMD that names a different script; `stub` under the declared escape.
bar_record=runner
if [ -n "${GOV_GATE_CMD:-}" ]; then
  if ! check_bar_command GOV_GATE_CMD "$gate" "$main_local" declared; then
    write_refusal bar-refused "$why"; RUNLOG_CLEAN=1; exit 1
  fi
  RUNLOG_BAR=$bar_class
  [ "$bar_class" = stub ] && bar_label="STUB $gate"
  if [ "$bar_class" = stub ]; then
    bar_record=stub
  elif [ "${bar_path#./}" != "$GATE_RUNNER" ] &&
       [ "$bar_blob" != "$(git rev-parse -q --verify "$main_local:$GATE_RUNNER" 2>/dev/null || true)" ]; then
    bar_record=other
  fi
else
  bar_path=$GATE_RUNNER
  [ -n "$bar_path" ] && bar_blob=$(git rev-parse -q --verify "$main_local:$bar_path" 2>/dev/null || true)
fi
RUNLOG_BAR=${RUNLOG_BAR:-default}   # set only once the value is vetted, so a refusal records no bar
RUNLOG_BAR_PATH=$bar_path; RUNLOG_BAR_BLOB=$bar_blob

# NO RUNNER STAMP IS A CANDIDATE FOR A BAR THAT IS NOT THE RUNNER (TOOL-aFrugalTurnstile-1 S6, design
# D2). `gate-full-green` and `gate-inherited-green` prove the runner's legs; a declared GATE_CMD naming
# another script runs other legs, which no runner stamp has seen. Applied AFTER the candidate loop,
# whatever it concluded, because `bar_record` is only known here (spec F1 (a)); a `stub` bar keeps
# today's decision, since every decision arm of the hook's own suite runs under the declared stub.
if [ "$bar_record" = other ]; then
  force="the bar this push runs is not this kit's runner, so no runner stamp is a candidate (gate-full-green and gate-inherited-green prove the runner's legs, not this bar's)"
  inh_sha=""; inh_why=""
fi

# THE PER-TREE VERDICT IS A CANDIDATE FOR THE SCOPED PATH TOO (TOOL-aFrugalTurnstile-2 S3b, design §6
# rev D4/D11; TOOL-dWitnessedBar-4 S3). It can turn a FULL decision scoped and never the reverse, and
# it is read only here, once the bar is vetted, and only for the runner's own bar: the runner wrote it,
# so a wrapper bar or a STUB finds no record for its own command and keeps today's decision.
# NEAREST ADOPTABLE GREEN WINS: among every candidate that passes the predicates, the one whose own sha
# is fewest first-parent landings behind the tip is adopted, so a scoped green at the graded merge
# beats an older full green; this does not check that the two name the same base.
# (TOOL-aFrugalTurnstile-11 S3/S4.) The pass now runs after an adopted runner stamp too, which is the
# first candidate, and a tie keeps the earlier one: a runner stamp beats a per-tree verdict, a full
# record a scoped one. A scoped record's staleness bound is still counted from its base; only the PREFERENCE uses
# its own sha. It can only replace one adopted candidate with another, so it never turns scoped FULL.
if [ -z "$inh_sha" ] && [ "$bar_record" = runner ]; then
  _bar_force=$force; _bar_why=""; _bar_ok=""
  _sel_d=""; [ -z "$force" ] && _sel_d=$lag   # the adopted runner stamp's own distance
  _sel_sha=$rec_sha; _sel_from=$rec_from; _sel_word=$rec_word; _sel_base=$rec_base; _sel_lag=$lag
  for _bi in "${!bar_candidates[@]}"; do
    [ -f "${bar_candidates[$_bi]}" ] || continue
    check_bar_record "${bar_candidates[$_bi]}"
    if [ -n "$force" ]; then _bar_why="$_bar_why; ${bar_candidates[$_bi]}: $force"; continue; fi
    _bar_ok=1; _d=$lag
    [ "$bg_kind" = scoped ] && _d=$(git rev-list --first-parent --count "$bg_sha..$main_local" 2>/dev/null || echo "$lag")
    if [ -z "$_sel_d" ] || [ "$_d" -lt "$_sel_d" ]; then
      _sel_d=$_d; _sel_sha=$bg_sha; _sel_from=${bar_candidates[$_bi]}; _sel_word="$bg_kind tree verdict"; _sel_lag=$lag
      _sel_base=""; [ "$bg_kind" = scoped ] && _sel_base=$bg_base
    fi
  done
  if [ -n "$_sel_d" ]; then
    # A runner stamp that beat an adoptable per-tree verdict is named, so the line says which record won.
    [ -n "$_bar_ok" ] && [ -z "$_bar_force" ] && [ -z "$_sel_from" ] && _sel_from="this git dir's gate-full-green"
    force=""; rec_sha=$_sel_sha; rec_from=$_sel_from; rec_word=$_sel_word; rec_base=$_sel_base; lag=$_sel_lag
  else
    force=$_bar_force$_bar_why
  fi
fi

# THE DEFAULT BAR WITH NO KIT ROOT — TOOL-aRepatriatedFork-24 S2, the owner's F1 (c). A commit hook
# skips on a miss, because its legs are an early signal. This is the merge bar, so a push that cannot
# find it and passes is the silent skip the unit exists to remove. It used to name the runner under
# a guessed prefix and fail on "no such file", which reads as a red bar rather than as a hook that
# never found one. Recorded as the default bar first, so the run log says
# which bar was refused.
if [ -z "${GOV_GATE_CMD:-}" ] && [ -z "$KITROOT_FROM" ]; then
  why="pre-push: REFUSING — the default bar is this tree's kit runner, and the kit root resolved nowhere"
  echo "$why" >&2
  echo "  ($(print_kitroot_miss))." >&2
  echo "  Declare GOV_KITROOT=<the directory holding the run-gates kit> in .githooks/gate-env.sh and" >&2
  echo "  commit it, or name a bar with GOV_GATE_CMD. Deliberate override, as always: git push --no-verify" >&2
  write_refusal bar-refused "$why"; RUNLOG_CLEAN=1; exit 1
fi
# ...and a kit root that resolved while the runner inside it did not (TOOL-aRepatriatedFork-46). The
# refusal above keys on the root; this one keys on the runner, so neither miss reaches the bar line
# with an empty runner to run.
if [ -z "${GOV_GATE_CMD:-}" ] && [ -z "$GATE_RUNNER" ]; then
  why="pre-push: REFUSING — the default bar is this tree's kit runner, and it resolved nowhere under the kit root"
  echo "$why" >&2
  echo "  (the kit root is '${GOV_KITROOT:-the repo root}', from $KITROOT_FROM; ${RUNNER_MISS:-no run-gates.sh found})." >&2
  echo "  Install the run-gates kit there, or name a bar with GOV_GATE_CMD. Deliberate override, as always: git push --no-verify" >&2
  write_refusal bar-refused "$why"; RUNLOG_CLEAN=1; exit 1
fi

# ---- WHAT THE BAR READS, NOT ONLY WHICH BAR — closing review round 2 H1, TOOL-aRepatriatedFork-49 ----
# The runner takes its leg manifest from `GATE_LEGS` and reuses a cached green under `GATE_REUSE`, so
# either knob, exported, decided what a vetted runner checked: a manifest of one green leg outside the
# tree landed a RED tracked bar. They are cleared for every bar not labelled STUB. An authoritative run
# reuses only a `remote` or `history` leg, at the exact pushed sha and observed tip, and is then scoped:
# that is `GATE_REUSE_PUSH`, which this hook alone sets, below, on a scoped decision and on no other
# (TOOL-aSparedSpawn-13 S10, owner ruling F1 (b)); the environment's `GATE_REUSE` stays cleared here. The
# label is the key, never `GOV_GATE_CMD_TEST` itself, which does not mark the DEFAULT bar and would
# leave a planted manifest under a `default` label that earns the lander marker. A STUB keeps them,
# because the hook's own fixtures drive a runner copy over a fixture manifest.
# The manifest the runner then reads, the sibling of its kit directory, is vetted as the runner is:
# an ignored one was read like a tracked one, and `git status` never reports it.
# The three ARM SEAMS dDerivedDocket gave the runner (TOOL-dDerivedDocket-26 S6) join them at the
# reconcile with aRepatriatedFork: `GATE_SPAWN_CMD` names what the host probe times, `GATE_SPAWN_FLOOR`
# its floor file, `GATE_VERDICT_FAULT` a verdict write that fails. Each exists for the runner's own
# suite, which drives it directly, so no bar this hook runs has any use for one.
# `GATE_REGEN_CHECK` joins them (TOOL-aPrimedIndex-6): set to 0 it skips the runner's generated-output
# preflight, and a skip can let a stale output through a bar whose freshness leg a guard scoped out,
# so the push that lands may not choose it. memory/gotchas/a-runner-knob-owes-a-push-class.md.
BAR_SCRUBBED_KNOBS="GATE_LEGS GATE_REUSE GATE_SPAWN_CMD GATE_SPAWN_FLOOR GATE_VERDICT_FAULT GATE_REGEN_CHECK"
if [ "$bar_class" != stub ]; then
  for _k in $BAR_SCRUBBED_KNOBS; do
    [ -n "${!_k+x}" ] && ENV_CLEARED+=" $_k"
    unset "$_k"
  done
  if [ -n "$GATE_RUNNER" ]; then
    _legs=${GATE_RUNNER%/*}
    case "$_legs" in */*) _legs=${_legs%/*}/gate-legs.json ;; *) _legs=gate-legs.json ;; esac
    [ -f "$top/$_legs" ] && check_reviewed_file "$_legs" "$main_local" "is the leg manifest the bar's runner reads"
  fi
fi
# BAR_CLEARED_KNOBS ARE THIS HOOK'S ALONE, for every bar a STUB included, and each is set again only on
# a decision of its own (TOOL-dWitnessedBar-60 S1). Every bar caller that records a trusted green scrubs
# these and BAR_SCRUBBED_KNOBS too, `PM_SCRUB` in post-merge.sh and the driver's `_gknobs`; the gov
# canary's `check_bar_scrub_parity` reds when either lacks a name this hook holds.
# - `GATE_DOCS_BASE` (TOOL-dThriftyLanding-3) can only narrow a run, and the STUB exemption above exists
#   for fixture manifests, which it has no part in. It is set again below, on a doc-only decision alone.
# - `GATE_BASE_FROM` and `GATE_SELECTION` (TOOL-dWitnessedBar-56 S9, §8 F2): an inherited `GATE_BASE_FROM`
#   would decide whether a scoped bar writes its per-tree verdict, and an inherited `GATE_SELECTION` would
#   hold a push bar's leg by a pusher's file. `GATE_BASE_FROM` is set again below, in the inherited-green
#   branch alone; this hook sets `GATE_SELECTION` on no path today.
# - `GATE_REUSE_PUSH` and `GATE_REUSE_LINEAGE` (TOOL-aSparedSpawn-13 S10, -32 S6): an inherited value
#   would let the environment decide which legs a vetted runner spares. Each is set again below, on the
#   one decision that asks for it. `GATE_REUSE_DIGEST_ENV` (TOOL-aSparedSpawn-33) names the environment
#   the push digest reads, so an inherited one would let the caller hand the runner a key.
# - `GATE_REUSE_SAMPLE` and `GATE_REUSE_DAY` (TOOL-aSparedSpawn-16 S6): the first sets how often a reused
#   leg is re-executed and the second pins the day a `clock` leg is keyed on, so either, inherited,
#   decides what a push bar spares. The runner keeps reading both; they are its own suite's seams, and
#   that suite drives the runner directly.
BAR_CLEARED_KNOBS="GATE_DOCS_BASE GATE_BASE_FROM GATE_SELECTION GATE_REUSE_PUSH GATE_REUSE_LINEAGE GATE_REUSE_DIGEST_ENV GATE_REUSE_SAMPLE GATE_REUSE_DAY"
for _k in $BAR_CLEARED_KNOBS; do
  [ -n "${!_k+x}" ] && ENV_CLEARED+=" $_k"
  unset "$_k"
done
[ -n "$ENV_CLEARED" ] \
  && echo "pre-push: not honoured from the environment by this bar:$ENV_CLEARED" >&2

# S3's refusal, measured above the forcing predicates and refused here, once the bar is vetted.
if [ -n "$_tree_dirty" ]; then
  why="pre-push: refusing — the working tree is dirty, so the bar would certify files the push to $def does not carry."
  echo "$why" >&2
  while IFS= read -r _l; do echo "    $_l" >&2; done <<< "$_tree_dirty"
  echo "  Commit or remove them and land again, or --no-verify. A submodule's own untracked files are ignored; its moved pointer is not." >&2
  write_refusal dirty-tree "$why"; RUNLOG_CLEAN=1; exit 1
fi

# THE SCOPED BASE, RESOLVED ONCE (TOOL-aFrugalTurnstile-7 S6/S6b). `scoped_base` is the GATE_BASE a scoped
# decision exports: the inherited green when one was adopted, else the adopted record's sha, and empty
# while the decision is FULL. `scoped_full` is the FULL green that base rests on, which a scoped record
# this push writes must name: a `kind scoped` record's own base, else the adopted sha itself; over an
# inherited green no scoped record is written at all (TOOL-aFrugalTurnstile-16 S3). A scoped
# record naming a scoped sha as its base is one `check_bar_base` refuses, so the push after it fell back to
# an older full slot (found by TOOL-aFrugalTurnstile-11). The cover check, the GATE_BASE export, the
# `--decide` line and the record's base all read these two, so no two of them can name different bases.
resolve_scoped_base() { # -> scoped_base and scoped_full, both empty on a FULL decision
  scoped_base=""; scoped_full=""
  if [ -n "$inh_sha" ]; then scoped_base=$inh_sha; scoped_full=$inh_sha
  elif [ -z "$force" ]; then scoped_base=$rec_sha; scoped_full=${rec_base:-$rec_sha}
  fi
}

# print_decision <full|scoped|covered> <why|base|record> — the one `--decide` line, on the fd 3 the mode
# kept for stdout, and the mode's one exit: nothing after a decision runs under --decide (S6).
print_decision() {
  printf '%s %s\t%s\n' "$1" "$2" "$gate" >&3   # the bar decided for, after the LAST tab (TOOL-aFrugalTurnstile-13)
  RUNLOG_CLEAN=1; exit 0
}

# ---- THE POST-MERGE RED — TOOL-aFrugalTurnstile-7 S2/S3, design D8 ---------------------------------
# Where the gate-env file AT R declares `GATE_POST_MERGE` (`PM_DECL`, read in `classify_docs`), a full bar
# that went RED after a landing is published as `refs/gov/bar-red` on the remote (`post-merge.sh`), and
# it binds here through recorded state: present and an ancestor of the tip, it forces FULL until the
# FULL green the decision rests on STRICTLY descends from it. Unreadable under a declaration forces FULL too. Undeclared,
# nothing is read and no decision moves. It can only force, so the every-predicate-forces rule holds.
# read_post_merge_red <url> — ONE `git ls-remote --exit-code`, bounded as the unattended kit's
# `observe_remote` is (60 s wall clock, `-k 5s`, no terminal or credential prompt, ssh connect and batch
# bounds, the low-speed floor), captured to a file outside the git dir and never through a substitution
# (`bounded-through-a-pipe-is-unbounded`). Sets PM_STATE (present|absent|unreadable), PM_RED and PM_WHY.
# The URL is never printed: messages name the remote, or "the push URL".
PM_RED=""; PM_STATE=""; PM_WHY=""
read_post_merge_red() {
  local url=${1-} out rc k v
  PM_RED=""; PM_STATE=unreadable; PM_WHY=""
  if [ -z "$url" ]; then PM_WHY="this push names no URL to read"; return 0; fi
  if ! out=$(mktemp 2>/dev/null) || [ -z "$out" ]; then PM_WHY="no scratch file for the read could be made"; return 0; fi
  if timeout -k 1s 10 true >/dev/null 2>&1; then
    timeout -k 5s 60 env GIT_TERMINAL_PROMPT=0 "GIT_SSH_COMMAND=ssh -o ConnectTimeout=20 -o BatchMode=yes" \
      git -c credential.interactive=never -c http.lowSpeedLimit=1000 -c http.lowSpeedTime=60 \
      ls-remote --exit-code "$url" refs/gov/bar-red </dev/null >"$out" 2>/dev/null
    rc=$?
  else
    echo "pre-push: post-merge bar: this host has no working 'timeout -k', so the read's 60 s wall-clock bound is inert; its transport bounds still apply"
    env GIT_TERMINAL_PROMPT=0 "GIT_SSH_COMMAND=ssh -o ConnectTimeout=20 -o BatchMode=yes" \
      git -c credential.interactive=never -c http.lowSpeedLimit=1000 -c http.lowSpeedTime=60 \
      ls-remote --exit-code "$url" refs/gov/bar-red </dev/null >"$out" 2>/dev/null
    rc=$?
  fi
  while IFS=$'\t' read -r k v; do [ "$v" = refs/gov/bar-red ] && PM_RED=$k; done < "$out"
  rm -f "$out"
  case "$rc" in
    0) case "$PM_RED" in
         ""|*[!0-9a-f]*) PM_RED=""; PM_WHY="git ls-remote answered 0 with no sha for refs/gov/bar-red" ;;
         *) PM_STATE=present ;;
       esac ;;
    2) PM_STATE=absent ;;
    124) PM_WHY="the 60 s bound fired" ;;
    *) PM_WHY="git ls-remote exited $rc" ;;
  esac
}
# check_post_merge_red <adopted sha> — after read_post_merge_red. A force sets `force`, empties the
# inherited green and the covering record, so the decision block takes its FULL branch and names it.
check_post_merge_red() {
  local x=${1-} who=${push_remote:-the push URL} p8
  case "$PM_STATE" in
    absent)
      echo "pre-push: post-merge bar: no red on $who (GATE_POST_MERGE=$PM_DECL at ${main_remote:0:8})"; return 0 ;;
    present) ;;
    *)
      force="GATE_POST_MERGE is declared at ${main_remote:0:8} and refs/gov/bar-red on $who could not be read ($PM_WHY), so a post-merge red cannot be ruled out"
      inh_sha=""; _cov_from=""; return 0 ;;
  esac
  p8=${PM_RED:0:8}
  # A red absent from this clone is no ancestor of the tip: every ancestor of a local commit is local.
  if ! git merge-base --is-ancestor "$PM_RED" "$main_local" 2>/dev/null; then
    echo "pre-push: post-merge bar: red $p8 on $who is not an ancestor of the pushed tip, so it does not bind this push"; return 0
  fi
  if [ -n "$x" ] && [ "$x" != "$PM_RED" ] && git merge-base --is-ancestor "$PM_RED" "$x" 2>/dev/null; then
    echo "pre-push: post-merge bar: red $p8 on $who is cleared for this push — the adopted green ${x:0:8} descends from it"; return 0
  fi
  if [ -n "$x" ]; then
    force="a post-merge full bar is RED at $p8 (refs/gov/bar-red on $who) and the adopted green ${x:0:8} does not descend from it"
  else
    force="a post-merge full bar is RED at $p8 (refs/gov/bar-red on $who) and no adopted green descends from it"
  fi
  inh_sha=""; _cov_from=""
}

# ---- THE COVER PASS — TOOL-aFrugalTurnstile-2 S3/S4, design D4 -----------------------------------
# A push whose tip TREE is the tree a recorded green graded, under this same bar, runs no bar at all:
# every leg that bar ran read that tree, and the push carries it. After every refusal, so a dirty tree,
# a refused bar and a head mismatch still refuse first; before the decision line, so a covered push
# prints the covered line INSTEAD of a decision. Candidates, for the runner's bar only: the runner
# stamps, then the pushed tree's per-tree verdicts (TOOL-dWitnessedBar-4 S3). The first that covers wins. A scoped record
# covers only a scoped decision from its own base (rev-3: or from the base of the scoped record the
# decision adopted). WHAT IT DOES NOT CHECK is the header's COVERED paragraph: legs that read history.
# check_cover_record <runner|bar> <path> — `cover_why` empty when that record covers this push, else
# its first failure; bg_* hold the record, and `_tip_tree` the pushed tree once read.
_tip_fp=""
check_cover_record() {
  local tip_blob force=""   # a LOCAL force: check_green_manifest must not clear the decision's own
  read_bar_file "$2"
  cover_why=""
  [ -n "$_tip_tree" ] || _tip_tree=$(git rev-parse -q --verify "$main_local^{tree}" 2>/dev/null)
  if [ -z "$bg_sha" ] || ! git merge-base --is-ancestor "$bg_sha" "$main_local" 2>/dev/null; then
    cover_why="sha ${bg_sha:0:8} is not an ancestor of the pushed tip"; return 0
  fi
  if [ "$1" = bar ]; then
    if [ "$bg_verdict" != GREEN ]; then
      cover_why="it reads verdict '${bg_verdict:-none}', not GREEN"; return 0
    fi
    if [ -z "$bg_tree" ] || [ -z "$_tip_tree" ]; then
      cover_why="its tree or the pushed tip's could not be read"; return 0
    fi
    if [ "$bg_tree" != "$_tip_tree" ]; then
      cover_why="it graded tree ${bg_tree:0:8} and the pushed tip holds ${_tip_tree:0:8}"; return 0
    fi
    check_tree_reuse "$bg_kind tree verdict"
    if [ -n "$force" ]; then cover_why=$force; return 0; fi
    check_tree_selection "$bg_kind tree verdict"
    if [ -n "$force" ]; then cover_why=$force; return 0; fi
  else
    [ -n "$_tip_fp" ] || { [ -x "$kitfp" ] && _tip_fp=$(bash "$kitfp" "$main_local" 2>/dev/null); }
    if [ -z "$bg_fp" ] || [ -z "$_tip_fp" ]; then
      cover_why="its tree or the pushed tip's could not be read"; return 0
    fi
    if [ "$bg_fp" != "$_tip_fp" ]; then
      cover_why="it graded tree fingerprint ${bg_fp:0:8} and the pushed tip's is ${_tip_fp:0:8}"; return 0
    fi
  fi
  # The manifest it ran is this push's, path and blob, for a runner stamp and a per-tree verdict alike.
  if [ "$1" = bar ]; then check_green_manifest "$bg_man" "$bg_kind tree verdict"; else check_green_manifest "$bg_man" "full green"; fi
  if [ -n "$force" ]; then cover_why=$force; return 0; fi
  tip_blob=$(git rev-parse -q --verify "$main_local:${KP}gate-legs.json" 2>/dev/null)
  if [ -z "$bg_blob" ] || [ "$bg_blob" != "$tip_blob" ]; then
    cover_why="its leg manifest blob ${bg_blob:0:8} is not the pushed tip's ${tip_blob:0:8}"; return 0
  fi
  if [ -n "${GATE_SELFTESTS:-}" ] && [ "$bg_st" != 1 ]; then
    cover_why="it was earned with the kit self-tests HELD and this push runs them"; return 0
  fi
  [ "$1" = bar ] && [ "$bg_kind" != full ] || return 0
  if [ "$bg_kind" != scoped ]; then
    cover_why="its kind reads '${bg_kind:-none}', neither full nor scoped"
  elif [ -z "$scoped_base" ]; then
    cover_why="it is a scoped green against base ${bg_base:0:8} and this push is FULL"
  elif [ "$bg_base" != "$scoped_base" ] && [ "$bg_base" != "$scoped_full" ]; then
    cover_why="it is a scoped green against base ${bg_base:0:8} and this push scopes from ${scoped_base:0:8}"
  fi
  return 0
}
resolve_scoped_base
_cov_from=""; _cov_why=""; _cov_bars=""; _cov_path=""
if [ "$bar_record" = runner ]; then
  for _gi in "${!green_candidates[@]}"; do
    [ -f "${green_candidates[$_gi]}" ] || continue
    check_cover_record runner "${green_candidates[$_gi]}"
    if [ -z "$cover_why" ]; then
      _cov_from=$(green_label "$_gi"); _cov_path=${green_candidates[$_gi]}; bg_kind=full; bg_by=run-gates; break
    fi
    _cov_why="$_cov_why; $(green_label "$_gi"): $cover_why"
  done
fi
if [ -z "$_cov_from" ] && [ "$bar_record" = runner ]; then
  for _bi in "${!bar_candidates[@]}"; do
    [ -f "${bar_candidates[$_bi]}" ] || continue
    _cov_bars=1
    check_cover_record bar "${bar_candidates[$_bi]}"
    if [ -z "$cover_why" ]; then _cov_from=${bar_candidates[$_bi]}; _cov_path=${bar_candidates[$_bi]}; break; fi
    _cov_why="$_cov_why; ${bar_candidates[$_bi]}: $cover_why"
  done
fi
# THE POST-MERGE RED, once the adopted record is known (S3): the covering record when the cover pass found
# one, else the inherited green, else the record the decision adopted. A FULL push with no cover does not
# pay the network read, and says so; a refused push never reached here.
if [ -n "$PM_DECL" ]; then
  if [ -z "$_cov_from" ] && [ -n "$force" ]; then
    echo "pre-push: post-merge bar: not read — this push is already FULL"
  else
    read_post_merge_red "${2-}"
    # The FULL green the decision rests on, never a scoped record's own sha (TOOL-aFrugalTurnstile-15,
    # design rev D8): `scoped_full` when adopted; for a cover, a scoped record's base, else its own sha.
    _pm_x=$scoped_full
    if [ -n "$_cov_from" ]; then _pm_x=$bg_sha; [ "$bg_kind" = scoped ] && _pm_x=$bg_base; fi
    check_post_merge_red "$_pm_x"
    resolve_scoped_base
  fi
fi
if [ -n "$_cov_from" ]; then
  echo "pre-push: covered on $def push (${main_local:0:8}) — tree ${_tip_tree:0:8} already carries a $bg_kind green: $_cov_from sha ${bg_sha:0:8} run ${bg_run:-none} by ${bg_by:-none} — bar: $bar_label — no bar runs"
  [ -z "$DECIDE" ] || print_decision covered "$_cov_path"
  [ -z "$PUSH_BAR" ] || { printf '%s\t%s\t%s\n' "$RUNLOG_BAR" "$bar_path" "$bar_blob" > "$PUSH_BAR"; } 2>/dev/null
  # A COVERED PUSH IS AN ALLOWED ONE (TOOL-aSignalledHook-1, closing review round 1): the tree already
  # carries a green, so the allow record is written here exactly as at the bar's success exit, naming
  # the run whose green covers it. Without it the lander reports every covered landing UNGATED.
  [ -z "$PUSH_ALLOW" ] || { printf '%s\t%s\n' "$main_local" "${bg_run:-covered}" > "$PUSH_ALLOW"; } 2>/dev/null
  RUNLOG_DECISION=covered; RUNLOG_CLEAN=1; exit 0
fi
[ -n "$_cov_bars" ] && [ -n "$_cov_why" ] && echo "pre-push: not covered — ${_cov_why#; }"

# THE TIP, PROBED FIRST (TOOL-aSparedSpawn-13 S9 S10), and only where the decision below is scoped: a
# FULL decision exports GATE_FULL, under which the runner reuses nothing, so a probe there buys
# nothing. One bounded `ls-remote --heads` against the URL git handed this hook, redirected to a file
# and read back, never captured through a pipe, so the bound holds the clock as well as the verdict.
# Reuse is OFFERED only when it answered and the default branch it advertises IS the remote sha git
# fed this hook on stdin; the digest of the whole advertisement rides with it, because a remote leg
# grades every advertised head, and the runner keys such a leg on exactly these bytes. A probe that
# fails, times out or disagrees offers nothing, and the decision line says which.
# AFTER the cover pass and the post-merge red (TOOL-aSparedSpawn-32): a covered push runs no bar and
# needs no probe, and a post-merge red can still turn the decision FULL; `--decide` runs no bar either.
REUSE_OFFER=""; _reuse_clause=""
if [ -z "$DECIDE" ] && { [ -z "$force" ] || [ -n "$inh_sha" ]; }; then
  _rp="$gd/gate-reuse-probe.$$"; _rp_tip=""; _rp_dig=""
  _rp_url=${RUNLOG_ARG2:-$RUNLOG_ARG1}
  if [ -n "$_rp_url" ] && timeout -k 5s 20 env GIT_TERMINAL_PROMPT=0 \
       "GIT_SSH_COMMAND=ssh -o ConnectTimeout=10 -o BatchMode=yes" \
       git -c credential.interactive=never ls-remote --heads "$_rp_url" > "$_rp" 2>/dev/null; then
    while IFS= read -r _l; do
      [ "${_l#*$'\t'}" = "refs/heads/$def" ] && _rp_tip=${_l%%$'\t'*}
    done < "$_rp"
    _rp_dig=$(git hash-object --stdin < "$_rp" 2>/dev/null) || _rp_dig=""
  fi
  [ -e "$_rp" ] && rm -f "$_rp" 2>/dev/null
  if [ -z "$_rp_tip" ] || [ -z "$_rp_dig" ]; then
    _reuse_clause="; reuse not offered: the ls-remote probe did not answer with the $def tip"
  elif [ "$_rp_tip" != "$main_remote" ]; then
    _reuse_clause="; reuse not offered: the ls-remote probe reads $def at ${_rp_tip:0:8}, and git handed this hook ${main_remote:0:8}"
  else
    REUSE_OFFER="$main_local $_rp_tip $_rp_dig"
    _reuse_clause="; reuse offered to remote and history legs at ${main_local:0:8}, tip ${_rp_tip:0:8}"
  fi
fi

# THE DECISION AND ITS REASON, on one line, always. A boundary that silently chooses the cheap path
# is indistinguishable from one that is broken, and this line is the only place the choice is
# visible to the person whose push it is.
_docs_clause=""
[ -n "$DOCS_ONLY" ] && _docs_clause=" docs-only: $DOCS_N path(s) in GATE_DOC_PATHS at ${main_remote:0:8};"
if [ -n "$inh_sha" ]; then
  [ -n "$DOCS_ONLY" ] && export GATE_DOCS_BASE="$main_remote"
  echo "pre-push: scoped gate on $def push (${main_local:0:8}) —$_docs_clause inherited green ${inh_sha:0:8} at base ${main_remote:0:8} is ${lag:-0} first-parent landing(s) back, within $GATE_FULL_MAX_LAG; the full green was not usable: $full_force$_reuse_clause — bar: $bar_label"
  export GATE_BASE="$scoped_base"
  # The runner cannot tell an inherited base from GATE_BASE, and writes no per-tree verdict on one
  # (TOOL-dWitnessedBar-40 S2).
  export GATE_BASE_FROM=inherited
  [ -n "$REUSE_OFFER" ] && export GATE_REUSE_PUSH="$REUSE_OFFER"
  RUNLOG_DECISION=scoped
elif [ -n "$force" ]; then
  # LINEAGE REUSE, on this decision and this bar only (TOOL-aFrugalTurnstile-4 S7, design D5): after
  # a red, the fix push re-runs the failed legs and the legs whose input key moved, and may still stamp.
  # Asked for by its own knob, `GATE_REUSE_LINEAGE` (TOOL-aSparedSpawn-32 S6), exported AFTER the scrub
  # above, so an inherited one is never honoured; a bar that is not this kit's runner gets nothing, and
  # the runner unsets it before any leg starts. The cache modes are the README's reuse section.
  _reuse_clause=""
  [ "$bar_record" = runner ] && { export GATE_REUSE_LINEAGE=1; _reuse_clause=" — reuse: lineage"; }
  echo "pre-push: FULL gate on $def push (${main_local:0:8}) — ${DOCS_ONLY:+doc-only, but }$force${inh_why:+; $inh_why} — bar: $bar_label$_reuse_clause"
  export GATE_FULL=1
  RUNLOG_DECISION=full
else
  [ -n "$DOCS_ONLY" ] && export GATE_DOCS_BASE="$main_remote"
  echo "pre-push: scoped gate on $def push (${main_local:0:8}) —$_docs_clause $rec_word ${rec_sha:0:8}${rec_from:+ from $rec_from}${rec_base:+, counted from its base ${rec_base:0:8},} is ${lag:-0} first-parent landing(s) back, within $GATE_FULL_MAX_LAG$_reuse_clause — bar: $bar_label"
  export GATE_BASE="$scoped_base"
  [ -n "$REUSE_OFFER" ] && export GATE_REUSE_PUSH="$REUSE_OFFER"
  RUNLOG_DECISION=scoped
fi
# THE CALLER'S ENVIRONMENT, FOR THE PUSH DIGEST ONLY (TOOL-aSparedSpawn-33, the owner's ruling on
# TOOL-aSparedSpawn-25). Where a scoped decision exported `GATE_REUSE_PUSH`, the runner keys every leg
# on an environment digest, and git started this hook with additions a direct bar never had, so a
# push never met an entry a direct bar earned. The rule: the DIGEST reads the caller's environment as
# it was before git, restored here, and the LEGS read this hook's, untouched. Restored from what is
# observable: `GIT_EXEC_PATH`, `GIT_PREFIX`, `GIT_DIR` and `GIT_CONFIG_PARAMETERS` absent; PATH's
# leading run of git's exec path stripped, matched verbatim or as its MSYS mount tail; and `LC_CTYPE`
# absent where it is Git for Windows' injection: `C.UTF-8` under a drive-letter exec path, with
# `LC_ALL` and `LANG` unset. A caller value indistinguishable from git's own is marked absent, which
# costs a saving and never a verdict. `compgen -e` lists the names into the view file and `mapfile`
# reads them back before the file is rewritten as the view, so no fork is spent and only an admitted
# name's value reaches the disk. It is removed once the bar returns, and by the signal handler: not by
# the EXIT trap, whose line the run-log suite pins. The name patterns copy the runner's digest.
PP_VIEW=""
if [ -n "${GATE_REUSE_PUSH:-}" ] && [ -n "$gd" ]; then
  PP_VIEW="$gd/gate-reuse-view.$$"
  case $PP_VIEW in /*|[A-Za-z]:*) ;; *) PP_VIEW="$top/$PP_VIEW" ;; esac
  _vrest=$PATH
  while [ -n "${GIT_EXEC_PATH:-}" ]; do
    _vc=${_vrest%%:*}
    case $_vc in */git-core) ;; *) break ;; esac
    case $GIT_EXEC_PATH in *"$_vc") ;; *) break ;; esac
    [ "$_vrest" = "$_vc" ] && { _vrest=""; break; }
    _vrest=${_vrest#*:}
  done
  _vctype=""
  case ${GIT_EXEC_PATH:-} in [A-Za-z]:[/\\]*)
    [ "${LC_CTYPE:-}" = C.UTF-8 ] && [ -z "${LC_ALL+x}" ] && [ -z "${LANG+x}" ] && _vctype=drop ;;
  esac
  if { compgen -e > "$PP_VIEW" && mapfile -t _vks < "$PP_VIEW"; } 2>/dev/null; then
    for _k in "${_vks[@]}"; do
      case $_k in GIT_EXEC_PATH|GIT_PREFIX|GIT_DIR|GIT_CONFIG_PARAMETERS) continue ;;
        LC_CTYPE) [ -n "$_vctype" ] && continue; _vv=$LC_CTYPE ;;
        PATH) _vv=$_vrest ;;
        GATE_*|GOV_*|*_PY|GIT_*|PYTHON*|LC_*|LANG|TZ) _vv=${!_k} ;; # digest-env-names
        *) continue ;;
      esac
      if [[ $_vv == *$'\n'* ]]; then printf 'env %s=%q\n' "$_k" "$_vv"; else printf 'env %s=%s\n' "$_k" "$_vv"; fi
    done > "$PP_VIEW" 2>/dev/null && export GATE_REUSE_DIGEST_ENV="$PP_VIEW"
  fi
fi
# --decide stops here, with the decision just announced: a doc-only one prints plain scoped (S6).
if [ -n "$DECIDE" ]; then
  if [ "$RUNLOG_DECISION" = full ]; then print_decision full "$force${inh_why:+; $inh_why}"; fi
  # Both shas, so the close's record names the FULL base the hook's would (TOOL-aFrugalTurnstile-16 S1),
  # and `-` over an inherited green, which `check_bar_base` never reads, so no record is written (S3).
  _dfull=$scoped_full; [ -n "$inh_sha" ] && _dfull=-
  print_decision scoped "$scoped_base $_dfull"
fi
# THE BAR'S RUN ID, pinned so this push's END joins the bar's own run-log line by id. Set BEFORE the
# bar, like the decision, so a push killed mid-bar still names the bar it was waiting on.
# UNPREDICTABLE AND CLEARED FIRST (TOOL-dDerivedDocket-24, in the spelling the honest-verdicts unit
# specifies for its own pin): the id carries `$$` and `$RANDOM`, and any directory of that name under
# the run root is removed before the bar starts, because this hook READS that run's record after the
# bar and a record the runner never wrote must not be mistaken for one it did. `$RANDOM` rides the
# digit run, so the id keeps the `push-<digits>-<pid>` shape the run log joins on.
# THE REMOVAL EXECS ONLY WHEN THERE IS SOMETHING TO REMOVE. The existence test is a builtin, and an
# unconditional `rm` spent one process on every gated push, on a line the run-log line's no-exec
# arm (`.githooks/pre-push.runlog.test.sh` AC7) owns because it carries the pin: measured, that arm
# redded `1 rm` at the build's first bar. `-L` as well, so a dangling link of that name still goes.
if [ -n "${EPOCHREALTIME:-}" ]; then RUNLOG_GATE_RUN="push-${EPOCHREALTIME//[!0-9]/}${RANDOM}-$$"
else printf -v RUNLOG_GATE_RUN 'push-%(%s)T%s-%s' -1 "$RANDOM" "$$"; fi
[ -n "$gd" ] && { [ -e "$gd/gate-run/$RUNLOG_GATE_RUN" ] || [ -L "$gd/gate-run/$RUNLOG_GATE_RUN" ]; } \
  && rm -rf "$gd/gate-run/$RUNLOG_GATE_RUN" 2>/dev/null
export GATE_RUN_ID="$RUNLOG_GATE_RUN"
# THE BAR'S CAUSE, the push and the sha it pushes (TOOL-dWitnessedBar-25 S2): the runner writes it into
# its verdict and removes it before any leg starts. Exported after the reuse view above, so no reuse key
# moves with it.
export GATE_CAUSE="push:$main_local"
# A RED AT THE PUSH BOUNDARY IS ATTRIBUTED against the sha the REMOTE holds for the default branch —
# the one git fed this hook on stdin, which is the landing base and never this clone's own tip, so a
# red is re-run against the tree the push would land on rather than against the tree that has it.
# An all-zero sha is a branch the remote does not have yet, so there is no base to name. A runner
# older than the attribution ignores the variable. TOOL-dDerivedDocket-23. The `verdict.blocks` value
# read at R rides with it as GATE_VERDICT_BLOCKS (TOOL-dWitnessedBar-3 S5), and the age bound under
# every value but `every-red`: under `every-red` nothing lands here, so the probe's extra leg runs
# would buy nothing.
if [ -n "$main_remote" ] && [ -n "${main_remote//0/}" ]; then
  export GATE_ATTRIBUTE="$main_remote"
  export GATE_VERDICT_BLOCKS="$PP_POLICY"
  [ "$PP_POLICY" != every-red ] && [ -n "$PP_MAX_AGE" ] && export GATE_INHERITED_RED_MAX_AGE="$PP_MAX_AGE"
fi

# check_inherited_verdict <run dir> — rc 0 when THAT bar's own record reads RED on an UNMOVED tree,
# its wall unfired, and every failed leg's attribution row reads `pass` in its ninth field, the
# runner's `blocks` under the value this hook handed it (TOOL-dWitnessedBar-3 S5), whatever its class
# or its age column reads, attributed against the remote's own sha, one attribution row per failed
# leg. Sets PP_LEGS, or PP_NOT naming the first condition that failed. It reads the record of the run
# id pinned above and no other.
check_inherited_verdict() {
  local d=$1 v tm fl wb n=0 bad="" leg ver rsha blk
  PP_LEGS=""; PP_NOT=""
  if [ ! -f "$d/verdict" ]; then
    PP_NOT="the bar left no verdict in its run record, so nothing says which legs failed"; return 1
  fi
  v=$(awk -F'\t' '$1=="verdict"{print $2}' "$d/verdict" 2>/dev/null)
  tm=$(awk -F'\t' '$1=="tree_moved"{print $2}' "$d/verdict" 2>/dev/null)
  fl=$(awk -F'\t' '$1=="failed"{print $2}' "$d/verdict" 2>/dev/null)
  wb=$(awk -F'\t' '$1=="wall_breach"{print $2}' "$d/verdict" 2>/dev/null)
  if [ "$tm" = yes ]; then
    PP_NOT="the tree moved while the bar ran, so no verdict describes the pushed commit"; return 1
  fi
  if [ -n "$wb" ]; then PP_NOT="the bar's wall fired, so a leg it killed was never graded"; return 1; fi
  if [ "$v" != RED ] || [ "$tm" != no ]; then
    PP_NOT="the bar's verdict reads '${v:-none}' with tree_moved '${tm:-none}', not a RED on an unmoved tree"; return 1
  fi
  if [ ! -f "$d/attribution" ]; then
    PP_NOT="the bar wrote no attribution record, so no red leg is shown to pass"; return 1
  fi
  while IFS=$'\t' read -r leg ver _ _ rsha _ _ _ blk _; do
    [ -n "$leg" ] || continue
    n=$((n + 1))
    PP_LEGS="$PP_LEGS${PP_LEGS:+, }$leg"
    if [ "$blk" != pass ]; then bad="$leg reads $ver and blocks"; break; fi
    if [ "$rsha" != "$main_remote" ]; then bad="$leg was attributed against ${rsha:0:8}, not the remote's ${main_remote:0:8}"; break; fi
  done < "$d/attribution"
  if [ -n "$bad" ]; then PP_NOT=$bad; return 1; fi
  if [ "$n" = 0 ] || [ "$n" != "${fl:-}" ]; then
    PP_NOT="the attribution names $n red leg(s) and the verdict counts ${fl:-none} failed"; return 1
  fi
  return 0
}

# check_verdict_record <run dir> — rc 0 when THAT bar's own record reads `verdict GREEN`, the
# honest-verdicts unit's boundary half of its no-silent-pass envelope (TOOL-dDerivedDocket-26 S6).
# Sets PP_NOT naming what was missing otherwise. The run dir is the id this hook pinned above and
# cleared before the bar started, so a record the runner did not write in THIS push cannot be read.
check_verdict_record() {
  local d=$1 v
  PP_NOT=""
  if [ ! -f "$d/verdict" ]; then
    PP_NOT="the bar exited 0 and left no verdict in its run record at $d"; return 1
  fi
  v=$(awk -F'\t' '$1=="verdict"{print $2; exit}' "$d/verdict" 2>/dev/null)
  [ "$v" = GREEN ] && return 0
  PP_NOT="the bar exited 0 and its run record reads verdict '${v:-none}', not GREEN"; return 1
}

# THE RUNNER'S ARM SEAMS DO NOT REACH THE BOUNDARY (TOOL-dDerivedDocket-26). `GATE_SPAWN_CMD`,
# `GATE_SPAWN_FLOOR` and `GATE_VERDICT_FAULT` exist so the runner's own suites can stage a HOST verdict
# or a refusal; inherited here, the environment of the push would choose how its own red is classified.
unset GATE_SPAWN_CMD GATE_SPAWN_FLOOR GATE_VERDICT_FAULT
# THE PUSHED RANGE, from git's own ref line and never from the environment (S5): the remote's sha for
# the default branch before this push, all zeros when the push creates it. An inherited value is
# OVERWRITTEN, so no caller can hand the bar a range. An adopter's bar may classify the range
# `$GATE_PUSH_BASE..HEAD` by its own policy; gov's runner does not read it.
export GATE_PUSH_BASE="$main_remote"
# THE VETTED BAR, for the lander to read rather than re-derive (H1), once every refusal is behind us.
{ printf '%s\t%s\t%s\n' "$RUNLOG_BAR" "$bar_path" "$bar_blob" > "$PUSH_BAR"; } 2>/dev/null
set -o noglob                  # run as vetted: the vetting split this value with globbing off (B1)
# THE BAR RUNS as a child this hook WAITS on, never in the foreground (TOOL-aSignalledHook-1). bash
# runs a trap only once a foreground child returns, so a signal sent mid-bar used to be handled an
# hour late, and `wait` returns the moment a trapped signal arrives. The status is the bar's, exactly
# as before. A non-interactive shell starts an async child with INT and QUIT ignored, so the runner
# cannot trap INT here; the handler at the top forwards TERM instead, which the runner does trap.
$gate </dev/null &
PP_BAR_PID=$!
wait "$PP_BAR_PID"
rc=$?
# The digest's view file, once the bar that read it has returned; the signal handler removes it too.
[ -z "$PP_VIEW" ] || rm -f "$PP_VIEW" 2>/dev/null
PP_BAR_PID=""
# AN EXIT 0 IS NOT A VERDICT UNTIL THE RECORD SAYS SO (TOOL-dDerivedDocket-26 S6). One push to the
# default branch proceeded with no bar run while this hook said it was forcing one
# (TOOL-aSurfacedLexicon-25), and the path that exited 0 was never found. Whatever it was, a runner
# that exits 0 without writing `verdict GREEN` into the record of the id pinned above is now RED here.
# The record is read, never stdout: a pipe waits for the last inherited write end, and the runner's
# wall watcher can outlive it holding one. It is checked whenever the RUNNER ran, whichever knob named
# it (`bar_record`, set where the bar was vetted). Only a bar that is not the runner goes unchecked,
# and it is announced: a declared GATE_CMD naming another script writes no record this hook can
# read, and the declared STUB is what every arm that stubs the bar uses.
# A BAR THAT HELD LEGS BY A SELECTION IS ADMITTED ONLY ON R's OWN (TOOL-dWitnessedBar-5 S7). A hold is a
# loosening, so the run record's `selection` is derived again at R by `verdict_flow.py select --check`
# before this hook admits that bar's verdict, green or a red that would land: a row R does not derive,
# or a check that cannot answer, is RED here. Read whatever bar ran: a record holding a selection is
# checked, and only the runner writes one. The check is `check_selection_at_r`, which the per-tree
# readers share (TOOL-dWitnessedBar-41 S2).
SEL_NOT=""
if [ -f "$gd/gate-run/$RUNLOG_GATE_RUN/selection" ]; then
  check_selection_at_r --run "$gd/gate-run/$RUNLOG_GATE_RUN"
  if [ -n "$SEL_NOT" ]; then echo "pre-push: $SEL_NOT — treating it as RED"; rc=1; fi
fi
if [ "$rc" -eq 0 ]; then
  case "$bar_record" in
    stub)
      echo "pre-push: the bar is the declared STUB (GOV_GATE_CMD_TEST), not this kit's runner, so its run record is not checked for an override command" ;;
    other)
      echo "pre-push: GOV_GATE_CMD runs the declared GATE_CMD '$bar_path', not this kit's runner, so its run record is not checked for an override command" ;;
    *)
      if ! check_verdict_record "$gd/gate-run/$RUNLOG_GATE_RUN"; then
        echo "pre-push: $PP_NOT — treating it as RED"
        rc=1
      fi ;;
  esac
fi
# A RED BAR LANDS ONLY WHEN EVERY RED PASSES under `verdict.blocks` at R (TOOL-dWitnessedBar-3 S5), at
# any age since ruling TOOL-dUnstuckLanding-22, and the check is asked under every value: under
# `every-red` no row reads `pass`. The exit that follows is still this hook's one exit, so the run
# log's decision stays the gate decision above; the landing is the printed line. An attended push
# lands over it too: the value is this repository's policy for every push, not an unattended
# exception, and the line says so.
if [ "$rc" -ne 0 ] && [ -z "$SEL_NOT" ]; then
  if check_inherited_verdict "$gd/gate-run/$RUNLOG_GATE_RUN"; then
    echo "pre-push: every red passes — landing under verdict.blocks $PP_POLICY: $PP_LEGS"
    rc=0
  else
    echo "pre-push: this red does not land under verdict.blocks $PP_POLICY — $PP_NOT"
  fi
fi
# THE FLOOR'S FIRST MEMBER (TOOL-dDeclaredLoop-2 S14): `floor.verdict-before-move`, read only on a red
# bar through the loop kit's floor.py, vetted by check_reviewed_file when it sits under the pushing
# tree. At `off` the bar's red is advisory: the push goes through with its allow record, and the runner's
# per-tree verdict of that bar reads RED, which this hook never adopts. Anything but `off`, a reader that does not answer or no loop kit, refuses as before.
if [ "$rc" -ne 0 ] && [ -z "$SEL_NOT" ] && _fl_py=$(resolve_python 2>/dev/null); then
  for _fl_tree in "$top" "$(cd "${0%/*}/.." && pwd)"; do
    if _fl_dir=$(resolve_kit_dir "$_fl_py" loop floor.py "$_fl_tree/${GOV_KITROOT:-.}" 2>/dev/null); then
      _fl_rel="${_fl_dir%$'\r'}/floor.py"
      [ "$_fl_tree" != "$top" ] || check_reviewed_file "$_fl_rel" "$main_local" "is read for floor.verdict-before-move"
      _fl_val=$(cd "$top" && "$_fl_py" "$_fl_tree/$_fl_rel" get verdict-before-move 2>/dev/null)
      if [ "${_fl_val%$'\r'}" = off ]; then
        echo "pre-push: floor: verdict-before-move off — the bar's red is advisory"
        rc=0
      fi
      break
    fi
  done
fi
if [ "$rc" -ne 0 ]; then
  why="pre-push: gate RED — push blocked (fix, or 'git push --no-verify' to override deliberately)."
  echo "$why"
  write_refusal gate-red "$why"
else
  # S4: THE GREEN MUST DESCRIBE THE PUSHED TREE. The bar runs for minutes to an hour, and anything
  # that commits during it (a formatter leg, another session in this tree) leaves a green earned on a
  # tree git is no longer pushing. The check at the top of this hook made before the bar is made again.
  _after=$(git rev-parse HEAD 2>/dev/null || true)
  if [ "$_after" != "$main_local" ]; then
    why="pre-push: refusing — HEAD moved from ${main_local:0:8} to ${_after:0:8} while the bar ran, so its green does not certify the tree being pushed."
    echo "$why" >&2
    write_refusal head-moved "$why"; RUNLOG_CLEAN=1; exit 1
  fi
  # THE ALLOW RECORD (TOOL-aSignalledHook-1), on this exit and no other: the bar's verdict let a
  # default-branch push through. push-main requires it to name the commit it pushed.
  [ -z "$PUSH_ALLOW" ] || { printf '%s\t%s\n' "$main_local" "$RUNLOG_GATE_RUN" > "$PUSH_ALLOW"; } 2>/dev/null
fi
RUNLOG_CLEAN=1; exit "$rc"
