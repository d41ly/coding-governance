  why="pre-push: the default branch resolves to a name that is no branch in this clone, so every pushed ref would classify as 'not the default branch' and skip the gate: $def"
  echo "$why" >&2
  echo "  Fix once: git remote set-head ${push_remote:-<remote>} -a   — or export GOV_DEFAULT_BRANCH=<a branch that exists>." >&2
  write_refusal default-branch "$why"; exit 1
