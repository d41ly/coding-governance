# TOOL-aRepatriatedFork-8 it is a function, because the branch bar is vetted by the same rule.
#
# So a bar command gets the treatment GOV_DEFAULT_BRANCH got above: the environment may REFUSE,
# never SELECT. There is no observed counterpart to prefer here, so the cross-check takes the other
# available form — the command must name a file THIS REPOSITORY TRACKS. That single property
# separates a reviewed bar script from `true`, from `bash /tmp/anything.sh`, and from anything a
# local untracked .githooks/gate-env.sh could set.
#
# TRACKED AT THE SHA THE CALLER NAMES. For the merge bar that is the pushed default-branch sha, never
# HEAD: a bar script that lands in this very push exists only on the branch being pushed, and the
# equality check below has already established that sha IS this working tree. A branch bar runs from
# the working tree whatever is being pushed, so it is vetted at HEAD.
#
# WHAT THIS DOES NOT CLOSE. `--no-verify` and a redirected `core.hooksPath` skip this file whole, and
# `BASH_ENV` runs an actor's own file inside this hook's interpreter before its first line; each needs
# an act of its own, and the unattended protocol lists that class as open. What this closes is the
# case where no such act is needed: the knob this hook documents, set to a four-letter word.
# The bar still INHERITS every other variable (TOOL-aRepatriatedFork-49 names what it clears): `PATH`,
# which chooses every launcher that is a bare word; the language runtimes' own variables, such as
# `PYTHONPATH`, `PYTHONHOME` and `NODE_OPTIONS`, which can load code into any leg; and the leg-level
# knobs an adopter's own legs read. Clearing the runtimes' variables would change the environment
# every adopter's legs receive from a hook that ships verbatim, and `PATH` stays inherited either
# way, so that class is open and is the owner's to decide.
bar_class=""
check_bar_command() { # knob name · command · sha its scripts must be tracked at · [declared] -> rc 0 with bar_class, bar_path and bar_blob, or rc 1 printed with its headline in `why`
  local knob=$1 cmd=$2 at=$3 _n=0
  bar_path=""; bar_blob=""
  if [ -n "${GOV_GATE_CMD_TEST:-}" ]; then
    # THE DECLARED ESCAPE, and it declares ITSELF: in the decision line, in the run log's `bar=stub`,
    # and by the lander marker push-main withholds. Every hook harness stubs the bar with an mktemp
    # script that is untracked by construction, so with no escape this hook could not be tested at
    # all. A SILENT waiver would be the defect wearing a test's name.
    bar_class=stub; return 0
  fi
  # EVERY path-shaped token has to be tracked, not merely the last one: "last token wins" accepts
  # `bash /tmp/evil.sh <tracked>`, because the tracked name trails the one that actually runs.
  #
  # AND THE EVERY-TOKEN RULE STILL DOES NOT CONSTRAIN WHAT RUNS. `gatepayload <tracked>` and
  # `bash -c gatepayload <tracked>` both landed over a RED bar at adopter nc: `gatepayload` is a PATH
  # command, it holds no `/` and does not end `.sh`, so no arm looked at it while the shell ran it.
  # So the word that EXECUTES is constrained by its POSITION: word 1, or word 2 when word 1 is one
  # of the two interpreters, and it has to be path-shaped, which routes it through the tracked and
  # working-copy checks below. Nothing else may sit between the interpreter and the script: an option
  # (`-c` turns the next word into the program and the tracked name into `$0`) or a bare word.
  # The first cut constrained only word 1 and enumerated dangerous SHAPES for the rest, so
  # `bash gatepayload <tracked>` passed as `bar=tracked` and bash ran `gatepayload` off PATH over a
  # RED bar (closing review round 1 B1): a shape list misses the shape nobody listed, and a
  # position does not.
  #
  # AND THE CONTENT, NOT ONLY THE NAME. `bash <tracked>` with that file rewritten in the working
  # tree also landed: the blob at the pushed tip is what the name check reads and the working copy
  # is what runs. push-main.sh refuses a dirty tree, but the boundary may not rest on a check one
  # layer up that a different lander need not make.
  #
  # AND THE VALUE, NOT ONLY ITS SCRIPT (closing review round 1 M1). Every check above passes any
  # tracked, clean script, and a library under the kit root that only defines a function is one: it
  # exits 0, so it is `true` with extra steps. With `declared`, the value has to be this kit's own runner or
  # the `GATE_CMD` that `.unattended.conf` declares AT `$at`, read in a subshell the way the unattended
  # driver sources that file, with an inherited `GATE_CMD` unset first so the environment cannot
  # declare its own bar. A branch bar passes no `declared`: it can only add a refusal.
  #
  # `.githooks/pre_push_bar_selftest.py` disables the program, option, working-copy and declared
  # arms in a copy of this file on every run and observes the evasions land. Its anchor is the
  # `set +f` line below, spelled exactly once in this file.
  _bar_tok=""; _bar_bad=""; _bar_first=""; _bar_opt=""; _bar_seen=""; _bar_dirty=""; _bar_prog=""
  _bar_decl=$cmd
  # THE ADVICE a refusal prints is a value this check ADMITS (closing review round 2 L2): the
  # declared GATE_CMD when there is one, else the kit's own runner. The self-test pushes it back.
  _bar_ok="bash ${GATE_RUNNER:-<the kit runner, once the kit root resolves>}"
  if [ "${4-}" = declared ] && { [ -z "$GATE_RUNNER" ] || [ "$cmd" != "bash $GATE_RUNNER" ]; }; then
    _bar_decl=$(unset GATE_CMD; eval "$(git show "$at:.unattended.conf" 2>/dev/null)" >/dev/null 2>&1 </dev/null; printf '%s' "${GATE_CMD-}")
    [ -n "$_bar_decl" ] && _bar_ok=$_bar_decl
  fi
  set -f                       # the value is a command line; glob-expanding it is never wanted
  for _w in $cmd; do
    _n=$((_n + 1))
    [ -z "$_bar_first" ] && _bar_first=$_w
    case "$_n:$_bar_first" in 1:*|2:bash|2:sh) _bar_prog=$_w ;; esac
    case "$_w" in
      */*|*.sh)
        _bar_tok=$_w; _bar_seen=1
        if [ -z "$_bar_bad" ] && ! git cat-file -e "$at:$_w" 2>/dev/null; then
          _bar_bad=$_w
        elif [ -z "$_bar_bad" ] && [ -z "$_bar_dirty" ]; then
          _wt=$(git hash-object -- "$_w" 2>/dev/null || true)
          _bl=$(git rev-parse "$at:$_w" 2>/dev/null || true)
          [ "$_wt" != "$_bl" ] && _bar_dirty=$_w
        fi
        ;;
      -*)
        # An option word BEFORE the script decides what the interpreter runs; after it, it is the
        # script's own argument and none of this hook's business.
        [ -z "$_bar_seen" ] && [ -z "$_bar_opt" ] && _bar_opt=$_w
        ;;
    esac
  done
  set +f
  if [ -z "$_bar_tok" ]; then
    why="pre-push: REFUSING - $knob names no script at all, so nothing here can tell the"
    echo "$why" >&2
    echo "  merge bar from a no-op: '$cmd'. A push gated by 'true' prints the same decision line" >&2
    echo "  as a push gated by every leg. Name a tracked script, or use --no-verify - which at" >&2
    echo "  least leaves no gate line behind for a later reader to misread as evidence." >&2
    return 1
  fi
  if [ -n "$_bar_opt" ]; then
    why="pre-push: REFUSING - $knob passes '$_bar_opt' to the interpreter before naming a"
    echo "$why" >&2
    echo "  script, so the tracked name need not be what runs at all ('-c' makes the next word the" >&2
    echo "  program and the script name its \$0). Full value: '$cmd'" >&2
    echo "  Name the script with no interpreter options. Sanctioned use: $knob='$_bar_ok'." >&2
    return 1
  fi
  case "$_bar_prog" in
    */*|*.sh) : ;;
    *)
      why="pre-push: REFUSING - $knob would RUN '$_bar_prog', which is not a script path this"
      echo "$why" >&2
      echo "  repository could track. The program that runs has to be a tracked, unmodified script at" >&2
      echo "  word 1, or at word 2 after bash or sh, with nothing between them: a tracked name later in" >&2
      echo "  the value does not make the executed word safe. Full value: '$cmd'" >&2
      echo "  Sanctioned use: $knob='$_bar_ok'. To test this hook," >&2
      echo "  export GOV_GATE_CMD_TEST=1, which waives this and marks the decision line 'bar: STUB'." >&2
      return 1
      ;;
  esac
  if [ -n "$_bar_bad" ]; then
    why="pre-push: REFUSING - $knob names '$_bar_bad', which this repository does not track"
    echo "$why" >&2
    echo "  at ${at:0:8}. The merge bar has to be a script the repo reviews;" >&2
    echo "  an untracked one is a bar nobody has read. Full value: '$cmd'" >&2
    echo "  Sanctioned use: $knob='$_bar_ok'. To test this hook," >&2
    echo "  export GOV_GATE_CMD_TEST=1, which waives this and marks the decision line 'bar: STUB'." >&2
    return 1
  fi
  if [ -n "$_bar_dirty" ]; then
    why="pre-push: REFUSING - $knob names '$_bar_dirty', which IS tracked at"
    echo "$why" >&2
    echo "  ${at:0:8} but whose working copy differs from it. The reviewed blob is what this" >&2
    echo "  check can vouch for and the working copy is what would run, so the two have to agree." >&2
    echo "  Commit the edit and push that, or point $knob at a bar you have not modified." >&2
    return 1
  fi
  if [ "$cmd" != "$_bar_decl" ]; then
    why="pre-push: REFUSING - $knob is '$cmd', which is neither this kit's own runner nor the"
    echo "$why" >&2
    echo "  GATE_CMD .unattended.conf declares at ${at:0:8} ('$_bar_decl'). Every tracked script that" >&2
    echo "  exits 0 passes the checks above, so an undeclared one is a bar nobody chose." >&2
    echo "  Declare it: GATE_CMD=\"$cmd\" in .unattended.conf, committed, then push that." >&2
    return 1
  fi
  bar_class=tracked; bar_path=$_bar_prog
  bar_blob=$(git rev-parse -q --verify "$at:$_bar_prog" 2>/dev/null || true)
}

# ---- THE BRANCH BAR — TOOL-aRepatriatedFork-8 S5 ------------------------------------------------
# A push that does not touch the default branch is ungated UNLESS the repository declares a branch
# bar, `GOV_BRANCH_GATE_CMD`, in its `.githooks/gate-env.sh`. It is the seam for an adopter policy that
# is not generic (adopter ic runs its docs hygiene on a branch push that moved `memory/`). Unset, nothing
# changes. Set, it is vetted by the rule above, at HEAD, and run with git's own ref lines on its
# stdin, since a branch push can carry several refs and one base sha cannot describe them; so
# `GATE_PUSH_BASE` is unset for it rather than inherited. A branch bar can only ADD a refusal to a
# push that is ungated without it.
if [ -z "$main_local" ] && [ -n "${GOV_BRANCH_GATE_CMD:-}" ]; then
  if ! check_bar_command GOV_BRANCH_GATE_CMD "$GOV_BRANCH_GATE_CMD" "$(git rev-parse HEAD 2>/dev/null)"; then
    write_refusal bar-refused "$why"; RUNLOG_CLEAN=1; exit 1
  fi
  RUNLOG_BAR=$bar_class; RUNLOG_DECISION=branch-gated
  bar_label=$GOV_BRANCH_GATE_CMD; [ "$bar_class" = stub ] && bar_label="STUB $bar_label"
  echo "pre-push: branch bar on a non-default push — bar: $bar_label"
  unset GATE_PUSH_BASE
  # RUN AS VETTED, with globbing off (closing review round 1 B1): the vetting split this value under
  # `set -f`, so a glob word expanding here would run words nobody vetted.
  set -o noglob
  printf '%s' "$push_refs" | $GOV_BRANCH_GATE_CMD
  rc=$?
  if [ "$rc" -ne 0 ]; then
    why="pre-push: branch bar RED — push blocked (fix, or 'git push --no-verify' to override deliberately)."
    echo "$why"
    write_refusal gate-red "$why"
  fi
  RUNLOG_CLEAN=1; exit "$rc"
fi

[ -z "$main_local" ] && { RUNLOG_DECISION=skip-nondefault; RUNLOG_CLEAN=1; exit 0; }   # no push to the default branch → nothing to gate
[ -z "${main_local//0/}" ] && { RUNLOG_DECISION=skip-delete; RUNLOG_CLEAN=1; exit 0; }   # all-zero local sha = a delete → nothing to gate

# THE RECEIPT AND THE RUNNER IT NAMES, VETTED BEFORE ANYTHING READS THE KIT ROOT (closing review
# round 1 B1, TOOL-aRepatriatedFork-24 S2c). The ladder above took the kit root, and the resolver the
# runner, from `.governance/install.json`, and neither had to be tracked: an ignored receipt naming
# a runner under `.git/`, beside a planted manifest, ran that runner over a RED tracked bar and
# landed with `git status` empty. Here, and not beside the ladder, because only a default-branch
# push reads what the ladder found; a feature push is not refused over a receipt it never uses.
# The runner is vetted for the DEFAULT bar only: a declared bar is vetted by `check_bar_command`.
[ -f "$top/.governance/install.json" ] \
  && check_reviewed_file .governance/install.json "$main_local" "names this hook's kit root and its default bar"
[ -z "${GOV_GATE_CMD:-}" ] && [ -n "$GATE_RUNNER" ] \
  && check_reviewed_file "$GATE_RUNNER" "$main_local" "is the default bar this hook would run"

# MOVED BELOW THE "NOTHING TO GATE" EXITS, and the move is the whole fix. This refusal used to
# sit beside the kit-root probe, ABOVE every question about which ref is being pushed — so an
# adopter installed at a third prefix (govkit accepts any, via `demand_safe_token`) had EVERY
# push refused, feature branches included, on a hook whose own header says "Other pushes do
# nothing". Reproduced by the closing review on a scratch remote: a `vendor/gov/` install
# refused `git push origin feature` with a message about forcing predicates and a green earned
# on a different leg set, neither of which applies to a push this hook never gates. There was no
# escape hatch either, so such an adopter had to hand-edit the hook or pass --no-verify on every
# branch push. The environment still cannot set `GOV_KITROOT`; the vetted `gate-env.sh` can.
#
# On a DEFAULT-BRANCH push the refusal is still exactly right, and that is where it now lives:
# their bar genuinely cannot run, and saying so at the one boundary that reads the manifest is
# the point. Ordering, not content.
# A PATH THAT RESOLVES TO NOTHING IS A REFUSAL, NEVER A NON-MATCH — but only where the tree actually
# HAS a manifest to find. Those two cases look identical from the outside and that is precisely what
# made the original failure silent: `git diff -- <unresolvable>` reports "no change here" and the
# push sails through. A repo with no manifest anywhere is a different and legitimate case (a fresh
# adopter, a project not using run-gates, this hook's own fixtures), and it is left alone.
# A LADDER MISS is the same case from the other side: nothing resolved, so nothing can be read.
if [ -z "$KITROOT_FROM" ] || [ ! -f "$top/${KP}gate-legs.json" ]; then
  _elsewhere=$(git ls-files --cached -- '*gate-legs.json' 2>/dev/null | head -1)
  if [ -n "$_elsewhere" ]; then
    why="pre-push: REFUSING — this tree tracks a leg manifest at '$_elsewhere', but this hook"
    echo "$why" >&2
    if [ -n "$KITROOT_FROM" ]; then
      echo "  resolved its kit root to '${GOV_KITROOT:-the repo root}' from $KITROOT_FROM and looked for '${KP}gate-legs.json'." >&2
    else
      echo "  resolved its kit root nowhere: $(print_kitroot_miss)." >&2
    fi
    echo "  Left alone, the two forcing predicates that read that path would match NOTHING and the" >&2
    echo "  push would be scoped against a green earned on a different leg set." >&2
    echo "  Deliberate override, as always: git push --no-verify" >&2
    write_refusal manifest "$why"; RUNLOG_CLEAN=1; exit 1
  fi
fi


# TOOL-aLeasedGauntlet-1: a default-branch push must go through <prefix>/push-main.sh, which reconciles
# origin BEFORE this full gate so it never runs on a stale tree. The lander sets this marker; a raw
# push lacks it and is refused (--no-verify bypasses). The kit hook has no code/docs split, so EVERY
# unmarked default-branch push is refused.
if [ ! -f "$(git rev-parse --git-dir)/push-main-active" ]; then
  why="pre-push: refusing a raw push to $def — land via ${KP}push-main.sh (it reconciles before the gate), or --no-verify to bypass."
  echo "$why" >&2
  write_refusal raw-push "$why"; RUNLOG_CLEAN=1; exit 1
fi

# The tree the hook validates must BE the pushed default-branch tip, else the gate certifies content
# that isn't what lands (a push issued from a feature worktree, or `git push <sha>:main`).
head=$(git rev-parse HEAD 2>/dev/null || true)
if [ "$main_local" != "$head" ]; then
  why="pre-push: refusing — pushing $def @ ${main_local:0:8} but this working tree is at ${head:0:8}."
  echo "$why"
  echo "  Push $def from the primary tree checked out at the pushed tip (playbook §3), or --no-verify."
  write_refusal head-mismatch "$why"; RUNLOG_CLEAN=1; exit 1
fi

# ---- THE TREE THE BAR CERTIFIES — TOOL-aRepatriatedFork-8 S3, from adopter ic's ARCH-dWaryGatepost-1 ----
# The bar reads the WORKING TREE and the push carries the COMMIT, so a dirty tree is a tree the green
# does not describe. ONE definition of dirty, spelled identically in push-main.sh:
# `--ignore-submodules=untracked` refuses an untracked superproject file, a moved submodule pointer
# and a tracked edit inside a submodule, and ignores a submodule's own untracked files, which no
# commit here can carry. `-uno`, push-main's old spelling, missed a brand-new source file; plain
# `--porcelain` refused a submodule holding a stranger's scratch file. MEASURED HERE, REFUSED BELOW:
# the refusal sits after the bar command is vetted, so a rewritten bar script is still named by the
# vetting's own sharper message; `.githooks/pre_push_bar_selftest.py` clears this value in its
# mutation too. A tree whose status cannot be read is refused as dirty, never passed as clean.
_tree_dirty=$(git status --porcelain --ignore-submodules=untracked 2>/dev/null) || _tree_dirty="(git status failed, so this tree's state is unknown)"

# ---- the boundary DECIDES, and the obligation it replaces is bounded rather than deleted --------
# This hook used to export GATE_FULL=1 unconditionally, which made every landing pay the whole bar
# — a records-only landing included. What that bought was a real property: a guard could only ever
# narrow a run that was not the deciding one, so a too-narrow guard cost an early signal rather than
# a wrong merge verdict. Deleting the force deletes that property, so it is REPLACED by a bounded,
# RECORDED obligation: the full bar still runs, just not on every push, and the record says when it
# last did. (The retired sentence is deliberately not quoted verbatim anywhere: a criterion greps the
# tracked tree for it, and a historical mention is indistinguishable from a live claim to a probe.)
#
# EVERY PREDICATE BELOW FORCES. There is no predicate that makes a run smaller — the decision is
# "is a scoped run good enough this time", and every way of not knowing the answer is a force. That
# asymmetry is the whole safety argument: this block can be wrong in one direction only.

# A SOURCE CONSTANT with its reasoning beside it, not an environment knob. How stale a recorded
# green may be before the boundary stops trusting it is a policy decision about this repository,
# and a policy that an environment variable can change at the moment it binds is not a policy.
# TEN: this repo took 13 commits between origin/main and the tip inside a single build, so 10
# forces roughly one full bar per build rather than one per push. The design pass recommended 1 —
# behaviourally today's bar — and that was refused on the record: the owner's stated goal is to
# stop paying the full bar per landing, and 1 defers essentially all of the saving. Lowering it
# later needs no code.
# COUNTED IN FIRST-PARENT LANDINGS (TOOL-aFrugalTurnstile-1 S1, design D1), the unit the runner's
# INHERITED_RED_MAX_AGE already counts in. Counting every commit charged a green earned on a branch
# tip for every commit each other build's landing carried in while that branch was open, so a
# multi-commit landing fell past the bound and paid a full bar at the push boundary.
# WHAT THE FIRST-PARENT COUNT DOES NOT CHECK: how many commits a landing's side branch carried. It
# trusts the recorded sha to speak for them, which predicates 2 and 5 constrain and the count does
# not; under a doc-only push, where predicate 5 is waived, a long doc branch now counts as one landing.
GATE_FULL_MAX_LAG=10

# ---- THE INHERITED-RED POLICY, READ AT R AND NEVER FROM THE PUSHED TREE — TOOL-dDerivedDocket-24 ---
# Two keys in that same file decide whether a push may land over a red the remote's own tip already
# carries: `INHERITED_RED=park|land` and `INHERITED_RED_MAX_AGE=<n>`, the second counted in
# first-parent landings. They are the one pair the vetted source above the non-default exit does
# NOT supply (it is sourced there since TOOL-aRepatriatedFork-8 S5). A branch that
# commits `INHERITED_RED=land` into its own copy would otherwise enable its own landing, so both are
# PARSED out of the file as committed at the remote sha git fed this hook — R, the landing base, which
# only a gated push can move — and R's bytes are never executed: one anchored match per key, a
# trailing comment and one pair of quotes stripped, then validated against `park land` or a positive
# integer. THE KIT DEFAULT IS `land` (ruling TOOL-dUnstuckLanding-22, superseding that part of
# TOOL-dDerivedDocket-24's D12-i4; built by TOOL-dUnstuckLanding-16): an absent or blank
# `INHERITED_RED`, and a file absent at R, read `land`, and `land` with no positive bound reads `land`
# with no bound. The bound decides no landing any more — an INHERITED red lands at any age, and the
# age only escalates the ask the unattended driver files. A value outside `park land` still reads
# `park`, because a typo must not land a red, and so does a remote with no tip, where nothing can read
# INHERITED. The policy line below ANNOUNCES which reading it took, on every gated push.
#
# THE RELATIVE PATH IS DERIVED from the one the source reads, so this hook spells the file once. The
# four names are cleared so neither a sourced assignment nor the caller's environment reaches the
# runner under a name only this block may set. `read_policy_key` below is byte-identical to the
# unattended driver's copy: this hook ships verbatim and sources no kit, so the one parse of this
# policy is spelled twice, and the two readers must never disagree about a line.
_gate_env_rel=${_gate_env#"$(git rev-parse --show-toplevel 2>/dev/null)"/}
unset INHERITED_RED INHERITED_RED_MAX_AGE GATE_INHERITED_RED GATE_INHERITED_RED_MAX_AGE

read_policy_key() { # file text · key -> the LAST `<key>=` line's value, cleaned; nothing when none assigns it
  local line v="" hit=""
  while IFS= read -r line || [ -n "$line" ]; do
    line=${line%$'\r'}
    case "$line" in "$2="*) v=${line#"$2="}; hit=1 ;; esac
  done <<< "$1"
  [ -n "$hit" ] || return 0
  v=${v%%[[:space:]]#*}
  while [ "${v% }" != "$v" ] || [ "${v%$'\t'}" != "$v" ]; do v=${v%?}; done
  while [ "${v# }" != "$v" ]; do v=${v# }; done
  case "$v" in
    \"*\") v=${v#\"}; v=${v%\"} ;;
    \'*\') v=${v#\'}; v=${v%\'} ;;
  esac
  printf '%s' "$v"
}

read_policy_at() { # sha -> PP_POLICY (park|land), PP_MAX_AGE (the positive bound declared, or empty) and PP_WHY
  local sha=$1 blob pol age bnd
  PP_POLICY=park; PP_MAX_AGE=""; PP_WHY=""
  if [ -z "$sha" ] || [ -z "${sha//0/}" ]; then
    PP_WHY="the remote holds no tip for $def yet, so there is no R to read a policy at"; return 0
  fi
  if ! blob=$(git show "$sha:$_gate_env_rel" 2>/dev/null); then
    PP_POLICY=land
    PP_WHY="$_gate_env_rel is absent at ${sha:0:8}, so the kit default land applies, with no age bound"; return 0
  fi
  pol=$(read_policy_key "$blob" INHERITED_RED)
  age=$(read_policy_key "$blob" INHERITED_RED_MAX_AGE)
  case "$age" in ''|0*|*[!0-9]*) age="" ;; esac
  if [ -n "$age" ]; then bnd="an age bound of $age first-parent landings, which escalates an aged leg's ask and lands it"
  else bnd="no age bound, so no leg is aged"; fi
  case "$pol" in
    land) PP_POLICY=land; PP_MAX_AGE=$age; PP_WHY="declared, with $bnd" ;;
    park) PP_MAX_AGE=$age; PP_WHY="declared" ;;
    '')   PP_POLICY=land; PP_MAX_AGE=$age
          PP_WHY="no INHERITED_RED is declared in $_gate_env_rel there, so the kit default land applies, with $bnd" ;;
    *)    PP_WHY="INHERITED_RED is '$pol' there, outside 'park land', which reads park" ;;
  esac
}

gd=$(git rev-parse --git-dir 2>/dev/null)
kitfp=""; [ -n "$GATE_RUNNER" ] && kitfp="$top/${GATE_RUNNER%/*}/gate-fingerprint.sh"
force=""; lag=0
rec_sha=""; rec_fp=""; rec_blob=""; rec_man=""; rec_st=""
read_green_file() { # path -> rec_sha rec_fp rec_blob rec_man rec_st, each empty when the file is absent
  rec_sha=""; rec_fp=""; rec_blob=""; rec_man=""; rec_st=""
  [ -f "$1" ] || return 0
  rec_sha=$(awk -F'\t' '$1=="sha"{print $2}' "$1" 2>/dev/null)
  rec_fp=$(awk -F'\t' '$1=="fingerprint"{print $2}' "$1" 2>/dev/null)
  rec_blob=$(awk -F'\t' '$1=="manifest_blob"{print $2}' "$1" 2>/dev/null)
  # WHICH MANIFEST THE BLOB BELONGS TO (TOOL-aFrugalTurnstile-1 S4). Absent reads as the kit sibling,
  # in check_green_record, because that is what every stamp written before the key existed ran.
  rec_man=$(awk -F'\t' '$1=="manifest"{print $2}' "$1" 2>/dev/null)
  # WHAT THE RECORDED GREEN COVERED. Absent reads as OFF, and that default is the migration: every
  # stamp written before TOOL-dUnstalledConvoy-26 lacks this key, and defaulting the missing case to
  # "covered everything" would make each of them certify legs it never ran.
  rec_st=$(awk -F'\t' '$1=="selftests"{print $2}' "$1" 2>/dev/null)
}

# THE CANDIDATE STAMPS (TOOL-dThriftyLanding-2). `--git-dir` is per WORKTREE, so a full green earned in
# a run's own worktree was invisible to the primary tree's push, which paid the whole bar again. The
# stamp is self-validating — predicates 2 to 8 check that its sha is an ancestor of the pushed tip,
# that its tree fingerprint reproduces AT that sha, and that the manifest it names is this one — so
# WHERE it was written does not change what it proves. Three candidates, in this order, each path once:
# this git dir's own stamp; the common dir's own, which is the primary tree's; and the common dir's
# `gate-full-green.shared`, which the runner writes from a LINKED worktree and never into the primary's
# file. The first that passes is adopted. ORDER is what keeps this strictly additive: a candidate is
# read only when every one before it would have forced the full bar, so sharing can turn a FULL
# decision scoped and can never turn a scoped one FULL.
_gcd=$(git rev-parse --git-common-dir 2>/dev/null) || _gcd=""
_gd_abs=$(cd "$gd" 2>/dev/null && pwd -P) || _gd_abs=""
_gcd_abs=""; [ -n "$_gcd" ] && _gcd_abs=$(cd "$_gcd" 2>/dev/null && pwd -P)
green_candidates=("$gd/gate-full-green")
if [ -n "$_gcd_abs" ]; then
  [ "$_gcd_abs" != "$_gd_abs" ] && green_candidates+=("$_gcd_abs/gate-full-green")
  green_candidates+=("$_gcd_abs/gate-full-green.shared")
fi
green_label() { # candidate index -> how the decision line names it
  case "$1" in
    0) printf 'this git dir' ;;
    *) case "${green_candidates[$1]}" in *.shared) printf "the common dir's gate-full-green.shared" ;;
                                          *) printf "the common dir's gate-full-green" ;; esac ;;
  esac
}
rec_from=""; rec_word="full green"; rec_base=""

# THE BAR'S OWN GREEN, BY TREE (TOOL-aFrugalTurnstile-2, design D3/D4). `gate-bar-green` is what
# `write_bar_green` below records when THIS hook's bar exits green, whichever bar it was, so a bar that
# is not the runner has a record too: the runner stamps above prove only the runner's legs. Three
# places, in the runner stamps' order and for their reason.
bar_candidates=("$gd/gate-bar-green"); bar_labels=("this git dir's gate-bar-green")
if [ -n "$_gcd_abs" ]; then
  if [ "$_gcd_abs" != "$_gd_abs" ]; then
    bar_candidates+=("$_gcd_abs/gate-bar-green"); bar_labels+=("the common dir's gate-bar-green")
  fi
  bar_candidates+=("$_gcd_abs/gate-bar-green.shared"); bar_labels+=("the common dir's gate-bar-green.shared")
fi
# read_bar_file <path> — every key a `gate-bar-green` record or a runner stamp carries, by builtins
# alone, so a candidate costs no process. Each is empty when the file or the key is absent.
read_bar_file() {
  local k v
  bg_sha=""; bg_tree=""; bg_bar=""; bg_kind=""; bg_base=""; bg_st=""; bg_run=""; bg_by=""
  bg_fp=""; bg_blob=""; bg_man=""
  [ -f "$1" ] || return 0
  while IFS=$'\t' read -r k v; do
    case "$k" in
      sha) bg_sha=$v ;; tree) bg_tree=$v ;; bar) bg_bar=$v ;; kind) bg_kind=$v ;; base) bg_base=$v ;;
      selftests) bg_st=$v ;; run_id) bg_run=$v ;; by) bg_by=$v ;;
      fingerprint) bg_fp=$v ;; manifest_blob) bg_blob=$v ;; manifest) bg_man=$v ;;
    esac
  done < "$1"
}

# check_green_manifest <manifest path> <label> — TOOL-aFrugalTurnstile-1's manifest rule, one copy
# for predicate 7 and the cover pass. Sets `force`, empty when the record ran this kit's manifest.
check_green_manifest() {
  force=""
  [ "${1:-${KP}gate-legs.json}" = "${KP}gate-legs.json" ] && return 0
  force="the recorded $2 was earned on the leg manifest $1, and the bar this push runs reads ${KP}gate-legs.json"
}

# PREDICATES 2 TO 8, ONE FUNCTION, TWO RECORDS (TOOL-dDerivedDocket-24). They were inline and read
# the full green's fields; the inherited green below must pass exactly the same seven, so the seven
# became one function over a record's five fields rather than a second copy of them. The label is the
# only thing that differs, and it is spelled `full green` for the full green, so every message that
# record printed before is byte-identical. Sets `force` to the first predicate the record fails, or
# empty, and `lag` to its distance behind the tip.
# A `gate-bar-green` record passes the same function with its tree and bar as two more arguments
# (TOOL-aFrugalTurnstile-2 S3b): predicate 4 then compares its `tree` with the tree at its sha, both
# non-empty, and predicate 7 its `bar` with the bar this push runs, byte for byte. 2, 3, 5, 6 and 8 hold
# unchanged, because they speak about the sha and the push, not about which program graded it.
check_green_record() { # sha · fingerprint · manifest blob · manifest path · selftests · label · [tree · bar]
  local r_sha=$1 r_fp=$2 r_blob=$3 r_man=${4:-${KP}gate-legs.json} r_st=$5 label=$6 p2 fresh now_blob
  local r_tree=${7-} r_bar=${8-} bar_mode="" now_tree
  [ $# -ge 8 ] && bar_mode=1
  force=""; lag=0
  # 2. the recorded green is not an ancestor of what is being pushed, so it describes another line of
  #    history entirely.
  if ! git merge-base --is-ancestor "$r_sha" "$main_local" 2>/dev/null; then
    force="the recorded $label ${r_sha:0:8} is not an ancestor of the pushed tip"; return 0
  fi
  # 3. the recorded green is further behind the tip than the bound allows, in first-parent landings.
  lag=$(git rev-list --first-parent --count "$r_sha..$main_local" 2>/dev/null || echo 0)
  if [ "${lag:-0}" -gt "$GATE_FULL_MAX_LAG" ]; then
    force="the recorded $label is $lag first-parent landings behind the tip (bound $GATE_FULL_MAX_LAG)"; return 0
  fi
  # 4. the record's TREE fingerprint does not reproduce AT THE SHA IT NAMES.
  #    AT THE RECORDED SHA, never at the tip. The digest is taken over the committed tree object, so
  #    it moves on every commit; joining it against a fresh fingerprint of the PUSHED TIP would fire
  #    on every push whose tree had moved, which is exactly the population predicates 2 and 3 already
  #    admit — it would force full forever while reading as caution. The helper is CALLED, never
  #    reimplemented: two implementations of one digest disagree silently and then force forever.
  if [ -n "$bar_mode" ]; then
    now_tree=$(git rev-parse -q --verify "$r_sha^{tree}" 2>/dev/null)
    if [ -z "$r_tree" ] || [ -z "$now_tree" ]; then
      force="the recorded $label's tree or the tree at ${r_sha:0:8} could not be read"; return 0
    fi
    if [ "$r_tree" != "$now_tree" ]; then
      force="the recorded $label names tree ${r_tree:0:8} and ${r_sha:0:8} holds ${now_tree:0:8}"; return 0
    fi
  elif [ -n "$r_fp" ] && [ -x "$kitfp" ]; then
    fresh=$(bash "$kitfp" "$r_sha" 2>/dev/null)
    if [ -n "$fresh" ] && [ "$fresh" != "$r_fp" ]; then
      force="the recorded tree fingerprint does not reproduce at ${r_sha:0:8}"; return 0
    fi
  fi
  # 5. the pushed tip is a MERGE whose second parent the record cannot speak for. Every build lands
  #    on the default branch here as a merge commit, so this row fires on any first-attempt landing
  #    whose recorded green was not earned on that exact second parent — not only on a retry. Kept at
  #    that width deliberately: a merge tip the record does not cover is precisely the case the record
  #    cannot speak for.
  #    WAIVED ON A DOC-ONLY PUSH (TOOL-dThriftyLanding-3). What the record cannot speak for here is
  #    the CODE the second parent brings in; on a doc-only push nothing outside the doc class moved,
  #    and every leg reading a doc that did move still runs. Predicates 2 to 4 and 6 to 8, the lag
  #    bound among them, still force.
  p2=$(git rev-parse -q --verify "$main_local^2" 2>/dev/null || true)
  if [ -z "$DOCS_ONLY" ] && [ -n "$p2" ] && ! git merge-base --is-ancestor "$p2" "$r_sha" 2>/dev/null; then
    force="the pushed tip is a merge whose second parent ${p2:0:8} the recorded green does not cover"; return 0
  fi
  # 6. the diff touches the LEG MANIFEST, so the scoping decision itself has changed. A guard added,
  #    widened or removed in this very push cannot be trusted to scope this very push.
  if ! git diff --quiet "$r_sha" "$main_local" -- "${KP}gate-legs.json" 2>/dev/null; then
    force="the pushed diff touches the leg manifest, so the scoping rules themselves moved"; return 0
  fi
  # 7. the recorded manifest blob differs from the one this tree holds — the same concern as 6, from
  #    the record's side, and it catches an uncommitted or differently-resolved manifest that a diff
  #    between two commits cannot see.
  #    A record earned on ANOTHER manifest is refused first (TOOL-aFrugalTurnstile-1 S5): a nested
  #    runner inside a wrapper bar stamps a green of its own subset, and only the blob kept it out.
  #    WHAT THE MANIFEST PATH DOES NOT CHECK: that the recorded path held these bytes when the stamp was
  #    written. The blob compare below checks that; the path only says which manifest the blob belongs to.
  if [ -n "$bar_mode" ]; then
    if [ "$r_bar" != "$gate" ]; then
      force="the recorded $label was earned by bar '$r_bar' and this push runs '$gate'"; return 0
    fi
  else
    check_green_manifest "$r_man" "$label"; [ -n "$force" ] && return 0
  fi
  if [ -n "$r_blob" ]; then
    now_blob=$(git hash-object -- "${KP}gate-legs.json" 2>/dev/null)
    if [ -n "$now_blob" ] && [ "$now_blob" != "$r_blob" ]; then
      force="the leg manifest differs from the one the recorded green was earned on"; return 0
    fi
  fi
  # 8. the recorded green was earned with the KIT-SUBJECT legs HELD, and this push would run them.
  #    COVERAGE, not equality. A record earned with the self-tests ON is strictly stronger evidence
  #    than a switch-off push needs, so it satisfies one — forcing there would cost every adopter the
  #    whole saving TOOL-dUnstalledConvoy-26 exists to give, at the one boundary it was measured for.
  #    The relation only bites in the other direction: a weaker record offered for a stronger push.
  #    Without this predicate the `selftests` field the stamp writes is a byte nobody consults, and
  #    the boundary trusts a partial bar as a whole one. TOOL-dUnstalledConvoy-27.
  if [ -n "${GATE_SELFTESTS:-}" ] && [ "$r_st" != "1" ]; then
    force="this push runs the kit self-tests and the recorded $label was earned with them HELD"; return 0
  fi
  return 0
}

# check_bar_record <path> — whether a `gate-bar-green` record is adoptable as this push's scoped
# base (TOOL-aFrugalTurnstile-2 S3b). Sets `force` to its first failure or empty, `lag`, and bg_* to
# that record. A `kind scoped` record at M is adoptable only on a base B that is itself a full green
# this push would adopt, and `lag` is then B's: M's own lag is checked too, which can only refuse more,
# so a chain of scoped records never stands further from a full green than the bound.
check_bar_record() {
  read_bar_file "$1"
  force=""; lag=0
  if [ -z "$bg_sha" ]; then force="it names no sha"; return 0; fi
  case "$bg_kind" in
    full|scoped) ;;
    *) force="its kind reads '${bg_kind:-none}', neither full nor scoped"; return 0 ;;
  esac
  check_green_record "$bg_sha" "" "" "" "$bg_st" "$bg_kind bar green" "$bg_tree" "$bg_bar"
  [ -z "$force" ] && [ "$bg_kind" = scoped ] && check_bar_base "$bg_base"
  return 0
}

# check_bar_base <sha> — `force` empty, and `lag` counted from <sha>, when a runner stamp (for the
# runner's bar only, TOOL-aFrugalTurnstile-1 S6) or a `kind full` bar record names exactly that sha and
# passes predicates 2 to 8. The readers write LOCAL copies here, so the caller's record is kept.
check_bar_base() {
  local want=$1 f found=""
  local bg_sha bg_tree bg_bar bg_kind bg_base bg_st bg_run bg_by bg_fp bg_blob bg_man
  if [ -z "$want" ]; then force="it is a scoped green that names no base"; return 0; fi
  if [ "$bar_record" = runner ]; then
    for f in "${green_candidates[@]}"; do
      read_bar_file "$f"
      [ "$bg_sha" = "$want" ] || continue
      check_green_record "$bg_sha" "$bg_fp" "$bg_blob" "$bg_man" "$bg_st" "full green"
      [ -z "$force" ] && return 0
      found=$force
    done
  fi
  for f in "${bar_candidates[@]}"; do
    read_bar_file "$f"
    [ "$bg_kind" = full ] && [ "$bg_sha" = "$want" ] || continue
    check_green_record "$bg_sha" "" "" "" "$bg_st" "full bar green" "$bg_tree" "$bg_bar"
    [ -z "$force" ] && return 0
    found=$force
  done
  force="its base ${want:0:8} is no full green this push can adopt${found:+: $found}"
}

# ---- THE DOC CLASS, READ AT R — TOOL-dThriftyLanding-3 -----------------------------------------
# Whether this push changes only non-code paths. Which paths are non-code is a per-repository answer,
# so it is DECLARED: `GATE_DOC_PATHS` in the gate-env file, a space-separated list of repo paths, each a
# file or a directory ending in `/`. It is PARSED at R exactly as the inherited-red keys are, and never
# read from the pushed tree, which could otherwise classify its own code as a doc. The push is doc-only
# when R is an ancestor of the pushed tip, something differs between them, and no path outside the class
# appears in their net diff OR in any commit between them: a code file added and removed again inside
# the range is still code a leg should have seen. That read is `--full-history` (TOOL-dThriftyLanding-9):
# git's default simplification drops a `--no-ff` merge's side branch that nets to nothing on the paths
# asked about, and every landing here is such a merge. Every failure, and every element that is not a plain
# repo path, reads as NOT doc-only, which is the decision this hook made before the class existed.
DOCS_ONLY=""; DOCS_N=0; DOCS_WHY=""
classify_docs() {
  local blob spec all nd nl
  local -a specs=() excl=()
  [ -n "$main_remote" ] && [ -n "${main_remote//0/}" ] && [ -n "$main_local" ] || return 0
  blob=$(git show "$main_remote:$_gate_env_rel" 2>/dev/null) || return 0
  read -ra specs <<<"$(read_policy_key "$blob" GATE_DOC_PATHS)"
  [ "${#specs[@]}" -gt 0 ] || return 0
  for spec in "${specs[@]}"; do
    case "$spec" in
      :*|/*|*'*'*|*'?'*|*'['*|..|../*|*/..|*/../*|.|./*)
        DOCS_WHY="GATE_DOC_PATHS at ${main_remote:0:8} holds '$spec', which is not a plain repo path, so no doc class applies"
        return 0 ;;
    esac
    excl+=(":(exclude,literal)$spec")
  done
  git merge-base --is-ancestor "$main_remote" "$main_local" 2>/dev/null || return 0
  all=$(git diff --no-renames --name-only "$main_remote" "$main_local" -- 2>/dev/null) || return 0
  [ -n "$all" ] || return 0
  nd=$(git diff --no-renames --name-only "$main_remote" "$main_local" -- . "${excl[@]}" 2>/dev/null) || return 0
  nl=$(git log --full-history --no-renames --format= --name-only "$main_remote..$main_local" -- . "${excl[@]}" 2>/dev/null) || return 0
  [ -z "$nd$nl" ] || return 0
  # ONLY UNDER `land` AT R (TOOL-dThriftyLanding-12, closing review M2). The docs mode grades against
  # R while the record it scopes from may sit below R, so a leg already red at an unproven R could be
  # docskipped and a push land over it. Under `land` that red lands anyway, as INHERITED; under `park`
  # it must not, so a park repository keeps today's decision for every push.
  read_policy_at "$main_remote"
  if [ "$PP_POLICY" != land ]; then
    DOCS_WHY="the push changes only GATE_DOC_PATHS, but the inherited-red policy at ${main_remote:0:8} reads $PP_POLICY, so it is not scoped as doc-only"
    return 0
  fi
  DOCS_ONLY=1; DOCS_N=$(printf '%s\n' "$all" | grep -c .)
}
classify_docs
[ -n "$DOCS_WHY" ] && echo "pre-push: $DOCS_WHY" >&2

# 1. no record at all — nothing has ever proven this bar here. Then predicates 2 to 8, per candidate
#    (TOOL-dThriftyLanding-2). The FIRST candidate's refusal keeps its exact wording, so a clone with
#    one git dir prints every message it printed before; a later candidate that EXISTS and is refused
#    appends its own, so no refusal is silent. A later candidate that is absent adds nothing.
_green_why=""
for _gi in "${!green_candidates[@]}"; do
  _gf=${green_candidates[$_gi]}
  [ "$_gi" -gt 0 ] && [ ! -f "$_gf" ] && continue
  read_green_file "$_gf"
  force=""
  [ -n "$rec_sha" ] || force="no recorded full green"
  [ -z "$force" ] && check_green_record "$rec_sha" "$rec_fp" "$rec_blob" "$rec_man" "$rec_st" "full green"
  if [ -z "$force" ]; then
    [ "$_gi" -gt 0 ] && rec_from=$(green_label "$_gi")
    break
  fi
  if [ "$_gi" = 0 ]; then _green_why=$force; else _green_why="$_green_why; $(green_label "$_gi"): $force"; fi
done
[ -n "$force" ] && force=$_green_why

# THE POLICY AT R, announced on every gated push whatever it reads, because the difference between
# the two answers is whether an inherited red lands.
read_policy_at "$main_remote"
echo "pre-push: inherited-red policy at ${main_remote:0:8} reads $PP_POLICY — $PP_WHY (read from $_gate_env_rel at that sha, never from the pushed tree)"

# THE INHERITED GREEN (KF2), looked for WHENEVER predicates 1 to 8 would force FULL: the full green
# absent, or present and refused by any of 2 to 8. Reading it only when the full green is ABSENT would
# force a FULL bar on every push from a git dir that ever earned a full green, for as long as the
# default branch holds an inherited red. It selects the scoped gate only when the policy at R is
# `land`, its `base` IS the remote sha on this hook's stdin, its `max_age` IS the bound parsed at that
# sha, and its `sha` passes predicates 2 to 8 exactly as a full green would. It never satisfies
# predicate 1 in the full green's place: it is a different file, read in a different branch, and a
# FULL force it does not lift still names why it was not used.
inh_sha=""; inh_why=""
if [ -n "$force" ] && [ -f "$gd/gate-inherited-green" ]; then
  _ig="$gd/gate-inherited-green"
  ig_sha=$(awk -F'\t' '$1=="sha"{print $2}' "$_ig" 2>/dev/null)
  ig_fp=$(awk -F'\t' '$1=="fingerprint"{print $2}' "$_ig" 2>/dev/null)
  ig_blob=$(awk -F'\t' '$1=="manifest_blob"{print $2}' "$_ig" 2>/dev/null)
  ig_man=$(awk -F'\t' '$1=="manifest"{print $2}' "$_ig" 2>/dev/null)
  ig_st=$(awk -F'\t' '$1=="selftests"{print $2}' "$_ig" 2>/dev/null)
  ig_base=$(awk -F'\t' '$1=="base"{print $2}' "$_ig" 2>/dev/null)
  ig_age=$(awk -F'\t' '$1=="max_age"{print $2}' "$_ig" 2>/dev/null)
  full_force=$force
  if [ "$PP_POLICY" != land ]; then
    inh_why="an inherited green is not read while the policy at R reads $PP_POLICY"
  elif [ -z "$ig_sha" ] || [ "$ig_base" != "$main_remote" ]; then
    inh_why="the inherited green was earned against base ${ig_base:0:8} and the remote holds ${main_remote:0:8}"
  elif [ "$ig_age" != "$PP_MAX_AGE" ]; then
    inh_why="the inherited green was written under max_age ${ig_age:-none} and the bound at ${main_remote:0:8} is $PP_MAX_AGE"
  else
    check_green_record "$ig_sha" "$ig_fp" "$ig_blob" "$ig_man" "$ig_st" "inherited green"
    if [ -z "$force" ]; then inh_sha=$ig_sha; else inh_why="the inherited green ${ig_sha:0:8} is refused too: $force"; fi
  fi
  [ -n "$inh_sha" ] || force=$full_force
fi

# ---- WHICH BAR RUNS: GOV_GATE_CMD, vetted by `check_bar_command` above, at the pushed tip -----
gate=${GOV_GATE_CMD:-bash $GATE_RUNNER}
bar_label="$gate"
# WHETHER THE BAR THAT RUNS WRITES A RUN RECORD, decided from WHAT RUNS and never from which knob named
# it (closing diff review round 1, F8). S6 below reads that record, and it used to be skipped whenever
# GOV_GATE_CMD was set. But the declared rule admits only this kit's runner or the committed GATE_CMD,
# and in this repository those are one script, so every admissible override IS the runner: exporting
# the very value the refusals above recommend switched the envelope off, which is the environment
# SELECTING. `runner` when the program is this kit's runner by path or by blob at the pushed sha;
# `other` for a declared GATE_CMD that names a different script; `stub` under the declared escape.
bar_record=runner
if [ -n "${GOV_GATE_CMD:-}" ]; then
  if ! check_bar_command GOV_GATE_CMD "$gate" "$main_local" declared; then
    write_refusal bar-refused "$why"; RUNLOG_CLEAN=1; exit 1
  fi
  RUNLOG_BAR=$bar_class
  [ "$bar_class" = stub ] && bar_label="STUB $gate"
  if [ "$bar_class" = stub ]; then
    bar_record=stub
  elif [ "${bar_path#./}" != "$GATE_RUNNER" ] &&
       [ "$bar_blob" != "$(git rev-parse -q --verify "$main_local:$GATE_RUNNER" 2>/dev/null || true)" ]; then
    bar_record=other
  fi
else
  bar_path=$GATE_RUNNER
  [ -n "$bar_path" ] && bar_blob=$(git rev-parse -q --verify "$main_local:$bar_path" 2>/dev/null || true)
fi
RUNLOG_BAR=${RUNLOG_BAR:-default}   # set only once the value is vetted, so a refusal records no bar
RUNLOG_BAR_PATH=$bar_path; RUNLOG_BAR_BLOB=$bar_blob

# NO RUNNER STAMP IS A CANDIDATE FOR A BAR THAT IS NOT THE RUNNER (TOOL-aFrugalTurnstile-1 S6, design
# D2). `gate-full-green` and `gate-inherited-green` prove the runner's legs; a declared GATE_CMD naming
# another script runs other legs, which no runner stamp has seen. Applied AFTER the candidate loop,
# whatever it concluded, because `bar_record` is only known here (spec F1 (a)); a `stub` bar keeps
# today's decision, since every decision arm of the hook's own suite runs under the declared stub.
if [ "$bar_record" = other ]; then
  force="the bar this push runs is not this kit's runner, so no runner stamp is a candidate (gate-full-green and gate-inherited-green prove the runner's legs, not this bar's)"
  inh_sha=""; inh_why=""
fi

# A BAR RECORD IS A CANDIDATE FOR THE SCOPED PATH TOO (TOOL-aFrugalTurnstile-2 S3b, design §6 rev
# D4/D11), so a bar that is not the runner has a candidate again. Read only when nothing above was
# adopted, so it can turn a FULL decision scoped and never the reverse, and only here, once the bar is
# vetted, because a record is compared with the bar this push runs. A STUB bar keeps today's decision:
# no record is ever written for one. The unattended in-place close commits its record on top of the
# merge its bar graded, so that landing is not covered; it scopes from this record instead.
if [ -n "$force" ] && [ -z "$inh_sha" ] && [ "$bar_record" != stub ]; then
  _bar_force=$force; _bar_why=""
  for _bi in "${!bar_candidates[@]}"; do
    [ -f "${bar_candidates[$_bi]}" ] || continue
    check_bar_record "${bar_candidates[$_bi]}"
    if [ -z "$force" ]; then
      rec_sha=$bg_sha; rec_from=${bar_labels[$_bi]}; rec_word="$bg_kind bar green"
      [ "$bg_kind" = scoped ] && rec_base=$bg_base
      _bar_force=""; _bar_why=""; break
    fi
    _bar_why="$_bar_why; ${bar_labels[$_bi]}: $force"
  done
  force=$_bar_force${_bar_force:+$_bar_why}
fi

# THE DEFAULT BAR WITH NO KIT ROOT — TOOL-aRepatriatedFork-24 S2, the owner's F1 (c). A commit hook
# skips on a miss, because its legs are an early signal. This is the merge bar, so a push that cannot
# find it and passes is the silent skip the unit exists to remove. It used to name the runner under
# a guessed prefix and fail on "no such file", which reads as a red bar rather than as a hook that
# never found one. Recorded as the default bar first, so the run log says
# which bar was refused.
if [ -z "${GOV_GATE_CMD:-}" ] && [ -z "$KITROOT_FROM" ]; then
  why="pre-push: REFUSING — the default bar is this tree's kit runner, and the kit root resolved nowhere"
  echo "$why" >&2
  echo "  ($(print_kitroot_miss))." >&2
  echo "  Declare GOV_KITROOT=<the directory holding the run-gates kit> in .githooks/gate-env.sh and" >&2
  echo "  commit it, or name a bar with GOV_GATE_CMD. Deliberate override, as always: git push --no-verify" >&2
  write_refusal bar-refused "$why"; RUNLOG_CLEAN=1; exit 1
fi
# ...and a kit root that resolved while the runner inside it did not (TOOL-aRepatriatedFork-46). The
# refusal above keys on the root; this one keys on the runner, so neither miss reaches the bar line
# with an empty runner to run.
if [ -z "${GOV_GATE_CMD:-}" ] && [ -z "$GATE_RUNNER" ]; then
  why="pre-push: REFUSING — the default bar is this tree's kit runner, and it resolved nowhere under the kit root"
  echo "$why" >&2
  echo "  (the kit root is '${GOV_KITROOT:-the repo root}', from $KITROOT_FROM; ${RUNNER_MISS:-no run-gates.sh found})." >&2
  echo "  Install the run-gates kit there, or name a bar with GOV_GATE_CMD. Deliberate override, as always: git push --no-verify" >&2
  write_refusal bar-refused "$why"; RUNLOG_CLEAN=1; exit 1
fi

# ---- WHAT THE BAR READS, NOT ONLY WHICH BAR — closing review round 2 H1, TOOL-aRepatriatedFork-49 ----
# The runner takes its leg manifest from `GATE_LEGS` and reuses a proven-green ledger row under
# `GATE_REUSE`, so either knob, exported, decided what a vetted runner checked: a manifest of one green
# leg outside the tree landed a RED tracked bar. They are cleared for every bar not labelled STUB. The
# label is the key, never `GOV_GATE_CMD_TEST` itself, which does not mark the DEFAULT bar and would
# leave a planted manifest under a `default` label that earns the lander marker. A STUB keeps them,
# because the hook's own fixtures drive a runner copy over a fixture manifest.
# The manifest the runner then reads, the sibling of its kit directory, is vetted as the runner is:
# an ignored one was read like a tracked one, and `git status` never reports it.
# The three ARM SEAMS dDerivedDocket gave the runner (TOOL-dDerivedDocket-26 S6) join them at the
# reconcile with aRepatriatedFork: `GATE_SPAWN_CMD` names what the host probe times, `GATE_SPAWN_FLOOR`
# its floor file, `GATE_VERDICT_FAULT` a verdict write that fails. Each exists for the runner's own
# suite, which drives it directly, so no bar this hook runs has any use for one.
BAR_SCRUBBED_KNOBS="GATE_LEGS GATE_REUSE GATE_SPAWN_CMD GATE_SPAWN_FLOOR GATE_VERDICT_FAULT"
if [ "$bar_class" != stub ]; then
  for _k in $BAR_SCRUBBED_KNOBS; do
    [ -n "${!_k+x}" ] && ENV_CLEARED+=" $_k"
    unset "$_k"
  done
  if [ -n "$GATE_RUNNER" ]; then
    _legs=${GATE_RUNNER%/*}
    case "$_legs" in */*) _legs=${_legs%/*}/gate-legs.json ;; *) _legs=gate-legs.json ;; esac
    [ -f "$top/$_legs" ] && check_reviewed_file "$_legs" "$main_local" "is the leg manifest the bar's runner reads"
  fi
fi
# THE DOCS KNOB IS THIS HOOK'S ALONE, for every bar a STUB included (TOOL-dThriftyLanding-3): it can
# only narrow a run, and the STUB exemption above exists for fixture manifests, which it has no part in.
# It is set again below, on a doc-only decision and nowhere else.
[ -n "${GATE_DOCS_BASE+x}" ] && ENV_CLEARED+=" GATE_DOCS_BASE"
unset GATE_DOCS_BASE
[ -n "$ENV_CLEARED" ] \
  && echo "pre-push: not honoured from the environment by this bar:$ENV_CLEARED" >&2

# S3's refusal, measured above the forcing predicates and refused here, once the bar is vetted.
if [ -n "$_tree_dirty" ]; then
  why="pre-push: refusing — the working tree is dirty, so the bar would certify files the push to $def does not carry."
  echo "$why" >&2
  while IFS= read -r _l; do echo "    $_l" >&2; done <<< "$_tree_dirty"
  echo "  Commit or remove them and land again, or --no-verify. A submodule's own untracked files are ignored; its moved pointer is not." >&2
  write_refusal dirty-tree "$why"; RUNLOG_CLEAN=1; exit 1
fi

# ---- THE COVER PASS — TOOL-aFrugalTurnstile-2 S3/S4, design D4 -----------------------------------
# A push whose tip TREE is the tree a recorded green graded, under this same bar, runs no bar at all:
# every leg that bar ran read that tree, and the push carries it. After every refusal, so a dirty tree,
# a refused bar and a head mismatch still refuse first; before the decision line, so a covered push
# prints the covered line INSTEAD of a decision. Candidates: the runner stamps, for the runner's bar
# only; then the bar records, for any bar but a STUB. The first that covers wins. A scoped record
# covers only a scoped decision from its own base (rev-3: or from the base of the scoped record the
# decision adopted). WHAT IT DOES NOT CHECK is the header's COVERED paragraph: legs that read history.
# check_cover_record <runner|bar> <path> — `cover_why` empty when that record covers this push, else
# its first failure; bg_* hold the record, and `_tip_tree` the pushed tree once read.
_tip_tree=""; _tip_fp=""
check_cover_record() {
  local tip_blob force=""   # a LOCAL force: check_green_manifest must not clear the decision's own
  read_bar_file "$2"
  cover_why=""
  [ -n "$_tip_tree" ] || _tip_tree=$(git rev-parse -q --verify "$main_local^{tree}" 2>/dev/null)
  if [ -z "$bg_sha" ] || ! git merge-base --is-ancestor "$bg_sha" "$main_local" 2>/dev/null; then
    cover_why="sha ${bg_sha:0:8} is not an ancestor of the pushed tip"; return 0
  fi
  if [ "$1" = bar ]; then
    if [ -z "$bg_tree" ] || [ -z "$_tip_tree" ]; then
      cover_why="its tree or the pushed tip's could not be read"; return 0
    fi
    if [ "$bg_tree" != "$_tip_tree" ]; then
      cover_why="it graded tree ${bg_tree:0:8} and the pushed tip holds ${_tip_tree:0:8}"; return 0
    fi
    if [ "$bg_bar" != "$gate" ]; then
      cover_why="it was earned by bar '$bg_bar' and this push runs '$gate'"; return 0
    fi
  else
    [ -n "$_tip_fp" ] || { [ -x "$kitfp" ] && _tip_fp=$(bash "$kitfp" "$main_local" 2>/dev/null); }
    if [ -z "$bg_fp" ] || [ -z "$_tip_fp" ]; then
      cover_why="its tree or the pushed tip's could not be read"; return 0
    fi
    if [ "$bg_fp" != "$_tip_fp" ]; then
      cover_why="it graded tree fingerprint ${bg_fp:0:8} and the pushed tip's is ${_tip_fp:0:8}"; return 0
    fi
    check_green_manifest "$bg_man" "full green"
    if [ -n "$force" ]; then cover_why=$force; return 0; fi
    tip_blob=$(git rev-parse -q --verify "$main_local:${KP}gate-legs.json" 2>/dev/null)
    if [ -z "$bg_blob" ] || [ "$bg_blob" != "$tip_blob" ]; then
      cover_why="its leg manifest blob ${bg_blob:0:8} is not the pushed tip's ${tip_blob:0:8}"; return 0
    fi
  fi
  if [ -n "${GATE_SELFTESTS:-}" ] && [ "$bg_st" != 1 ]; then
    cover_why="it was earned with the kit self-tests HELD and this push runs them"; return 0
  fi
  [ "$1" = bar ] && [ "$bg_kind" != full ] || return 0
  if [ "$bg_kind" != scoped ]; then
    cover_why="its kind reads '${bg_kind:-none}', neither full nor scoped"
  elif [ -z "$_dec_base" ]; then
    cover_why="it is a scoped green against base ${bg_base:0:8} and this push is FULL"
  elif [ "$bg_base" != "$_dec_base" ] && { [ -z "$rec_base" ] || [ "$bg_base" != "$rec_base" ]; }; then
    cover_why="it is a scoped green against base ${bg_base:0:8} and this push scopes from ${_dec_base:0:8}"
  fi
  return 0
}
_dec_base=""
if [ -n "$inh_sha" ]; then _dec_base=$inh_sha; elif [ -z "$force" ]; then _dec_base=$rec_sha; fi
_cov_from=""; _cov_why=""; _cov_bars=""
if [ "$bar_record" = runner ]; then
  for _gi in "${!green_candidates[@]}"; do
    [ -f "${green_candidates[$_gi]}" ] || continue
    check_cover_record runner "${green_candidates[$_gi]}"
    if [ -z "$cover_why" ]; then _cov_from=$(green_label "$_gi"); bg_kind=full; bg_by=run-gates; break; fi
    _cov_why="$_cov_why; $(green_label "$_gi"): $cover_why"
  done
fi
if [ -z "$_cov_from" ] && [ "$bar_record" != stub ]; then
  for _bi in "${!bar_candidates[@]}"; do
    [ -f "${bar_candidates[$_bi]}" ] || continue
    _cov_bars=1
    check_cover_record bar "${bar_candidates[$_bi]}"
    if [ -z "$cover_why" ]; then _cov_from=${bar_labels[$_bi]}; break; fi
    _cov_why="$_cov_why; ${bar_labels[$_bi]}: $cover_why"
  done
fi
if [ -n "$_cov_from" ]; then
  echo "pre-push: covered on $def push (${main_local:0:8}) — tree ${_tip_tree:0:8} already carries a $bg_kind green: $_cov_from sha ${bg_sha:0:8} run ${bg_run:-none} by ${bg_by:-none} — bar: $bar_label — no bar runs"
  { printf '%s\t%s\t%s\n' "$RUNLOG_BAR" "$bar_path" "$bar_blob" > "$PUSH_BAR"; } 2>/dev/null
  RUNLOG_DECISION=covered; RUNLOG_CLEAN=1; exit 0
fi
[ -n "$_cov_bars" ] && echo "pre-push: not covered — ${_cov_why#; }"

# THE DECISION AND ITS REASON, on one line, always. A boundary that silently chooses the cheap path
# is indistinguishable from one that is broken, and this line is the only place the choice is
# visible to the person whose push it is.
_docs_clause=""
[ -n "$DOCS_ONLY" ] && _docs_clause=" docs-only: $DOCS_N path(s) in GATE_DOC_PATHS at ${main_remote:0:8};"
if [ -n "$inh_sha" ]; then
  [ -n "$DOCS_ONLY" ] && export GATE_DOCS_BASE="$main_remote"
  echo "pre-push: scoped gate on $def push (${main_local:0:8}) —$_docs_clause inherited green ${inh_sha:0:8} at base ${main_remote:0:8} is ${lag:-0} first-parent landing(s) back, within $GATE_FULL_MAX_LAG; the full green was not usable: $full_force — bar: $bar_label"
  export GATE_BASE="$inh_sha"
  RUNLOG_DECISION=scoped
elif [ -n "$force" ]; then
  echo "pre-push: FULL gate on $def push (${main_local:0:8}) — ${DOCS_ONLY:+doc-only, but }$force${inh_why:+; $inh_why} — bar: $bar_label"
  export GATE_FULL=1
  RUNLOG_DECISION=full
else
  [ -n "$DOCS_ONLY" ] && export GATE_DOCS_BASE="$main_remote"
  echo "pre-push: scoped gate on $def push (${main_local:0:8}) —$_docs_clause $rec_word ${rec_sha:0:8}${rec_from:+ from $rec_from}${rec_base:+, counted from its base ${rec_base:0:8},} is ${lag:-0} first-parent landing(s) back, within $GATE_FULL_MAX_LAG — bar: $bar_label"
  export GATE_BASE="$rec_sha"
  RUNLOG_DECISION=scoped
fi
# THE BAR'S RUN ID, pinned so this push's END joins the bar's own run-log line by id. Set BEFORE the
# bar, like the decision, so a push killed mid-bar still names the bar it was waiting on.
# UNPREDICTABLE AND CLEARED FIRST (TOOL-dDerivedDocket-24, in the spelling the honest-verdicts unit
# specifies for its own pin): the id carries `$$` and `$RANDOM`, and any directory of that name under
# the run root is removed before the bar starts, because this hook READS that run's record after the
# bar and a record the runner never wrote must not be mistaken for one it did. `$RANDOM` rides the
# digit run, so the id keeps the `push-<digits>-<pid>` shape the run log joins on.
# THE REMOVAL EXECS ONLY WHEN THERE IS SOMETHING TO REMOVE. The existence test is a builtin, and an
# unconditional `rm` spent one process on every gated push, on a line the run-log line's no-exec
# arm (`.githooks/pre-push.runlog.test.sh` AC7) owns because it carries the pin: measured, that arm
# redded `1 rm` at the build's first bar. `-L` as well, so a dangling link of that name still goes.
if [ -n "${EPOCHREALTIME:-}" ]; then RUNLOG_GATE_RUN="push-${EPOCHREALTIME//[!0-9]/}${RANDOM}-$$"
else printf -v RUNLOG_GATE_RUN 'push-%(%s)T%s-%s' -1 "$RANDOM" "$$"; fi
[ -n "$gd" ] && { [ -e "$gd/gate-run/$RUNLOG_GATE_RUN" ] || [ -L "$gd/gate-run/$RUNLOG_GATE_RUN" ]; } \
  && rm -rf "$gd/gate-run/$RUNLOG_GATE_RUN" 2>/dev/null
export GATE_RUN_ID="$RUNLOG_GATE_RUN"
# A RED AT THE PUSH BOUNDARY IS ATTRIBUTED against the sha the REMOTE holds for the default branch —
# the one git fed this hook on stdin, which is the landing base and never this clone's own tip, so a
# red is re-run against the tree the push would land on rather than against the tree that has it.
# An all-zero sha is a branch the remote does not have yet, so there is no base to name. A runner
# older than the attribution ignores the variable. TOOL-dDerivedDocket-23. The policy read at R rides
# with it, and the age bound only under `land`, the one policy whose attribution lines show the age:
# under `park` nothing lands here, so the probe's extra leg runs would buy nothing.
if [ -n "$main_remote" ] && [ -n "${main_remote//0/}" ]; then
  export GATE_ATTRIBUTE="$main_remote"
  export GATE_INHERITED_RED="$PP_POLICY"
  [ "$PP_POLICY" = land ] && [ -n "$PP_MAX_AGE" ] && export GATE_INHERITED_RED_MAX_AGE="$PP_MAX_AGE"
fi

# check_inherited_verdict <run dir> — rc 0 when THAT bar's own record reads RED on an UNMOVED tree,
# its wall unfired, and every failed leg INHERITED, whatever its age column reads (a number, `aged`,
# or `-` for unproven: TOOL-dUnstuckLanding-16 S2), attributed against the remote's own sha, one
# attribution row per failed leg. Sets PP_LEGS, or PP_NOT naming the first condition that failed. It
# reads the record of the run id pinned above and no other.
check_inherited_verdict() {
  local d=$1 v tm fl wb n=0 bad="" leg ver rsha
  PP_LEGS=""; PP_NOT=""
  if [ ! -f "$d/verdict" ]; then
    PP_NOT="the bar left no verdict in its run record, so nothing says which legs failed"; return 1
  fi
  v=$(awk -F'\t' '$1=="verdict"{print $2}' "$d/verdict" 2>/dev/null)
  tm=$(awk -F'\t' '$1=="tree_moved"{print $2}' "$d/verdict" 2>/dev/null)
  fl=$(awk -F'\t' '$1=="failed"{print $2}' "$d/verdict" 2>/dev/null)
  wb=$(awk -F'\t' '$1=="wall_breach"{print $2}' "$d/verdict" 2>/dev/null)
  if [ "$tm" = yes ]; then
    PP_NOT="the tree moved while the bar ran, so no verdict describes the pushed commit"; return 1
  fi
  if [ -n "$wb" ]; then PP_NOT="the bar's wall fired, so a leg it killed was never graded"; return 1; fi
  if [ "$v" != RED ] || [ "$tm" != no ]; then
    PP_NOT="the bar's verdict reads '${v:-none}' with tree_moved '${tm:-none}', not a RED on an unmoved tree"; return 1
  fi
  if [ ! -f "$d/attribution" ]; then
    PP_NOT="the bar wrote no attribution record, so no red leg is shown to be inherited"; return 1
  fi
  while IFS=$'\t' read -r leg ver _ _ rsha _; do
    [ -n "$leg" ] || continue
    n=$((n + 1))
    PP_LEGS="$PP_LEGS${PP_LEGS:+, }$leg"
    if [ "$ver" != INHERITED ]; then bad="$leg reads $ver"; break; fi
    if [ "$rsha" != "$main_remote" ]; then bad="$leg was attributed against ${rsha:0:8}, not the remote's ${main_remote:0:8}"; break; fi
  done < "$d/attribution"
  if [ -n "$bad" ]; then PP_NOT=$bad; return 1; fi
  if [ "$n" = 0 ] || [ "$n" != "${fl:-}" ]; then
    PP_NOT="the attribution names $n red leg(s) and the verdict counts ${fl:-none} failed"; return 1
  fi
  return 0
}

# check_verdict_record <run dir> — rc 0 when THAT bar's own record reads `verdict GREEN`, the
# honest-verdicts unit's boundary half of its no-silent-pass envelope (TOOL-dDerivedDocket-26 S6).
# Sets PP_NOT naming what was missing otherwise. The run dir is the id this hook pinned above and
# cleared before the bar started, so a record the runner did not write in THIS push cannot be read.
check_verdict_record() {
  local d=$1 v
  PP_NOT=""
  if [ ! -f "$d/verdict" ]; then
    PP_NOT="the bar exited 0 and left no verdict in its run record at $d"; return 1
  fi
  v=$(awk -F'\t' '$1=="verdict"{print $2; exit}' "$d/verdict" 2>/dev/null)
  [ "$v" = GREEN ] && return 0
  PP_NOT="the bar exited 0 and its run record reads verdict '${v:-none}', not GREEN"; return 1
}

# write_bar_green <git dir> <head before> <rc> <kind> <base> <bar> <run id> — the bar's own green, by
# tree (TOOL-aFrugalTurnstile-2 S1, design D3). Writes `<git dir>/gate-bar-green` through a `.tmp`
# rename only when the bar's own rc is 0, the kind is `full` or `scoped`, HEAD is still <head before>,
# the tree is clean and its tree object reads; otherwise prints ONE line naming why and writes nothing.
# From a linked worktree it is also copied to the common dir's `gate-bar-green.shared`, as the runner
# shares its stamp. `bar_paths` is split with `read -ra`, never by toggling globbing: the bar self-test
# anchors on the one glob toggle `check_bar_command` holds. Self-contained, so a slice of it runs alone.
write_bar_green() {
  local g=$1 h=$2 rc=$3 kind=$4 base=$5 bar=$6 run=$7 tree dirty w paths="" cdir cdir_abs g_abs
  local -a words=()
  local no="pre-push: no gate-bar-green written —"
  if [ "$rc" != 0 ]; then echo "$no the bar's own verdict was red, and the push lands under INHERITED_RED=land"; return 0; fi
  case "$kind" in full|scoped) ;; *) echo "$no the decision kind '$kind' is neither full nor scoped"; return 0 ;; esac
  case "$bar" in *$'\t'*|*$'\n'*) echo "$no the bar's command holds a tab or a newline"; return 0 ;; esac
  if [ "$(git rev-parse HEAD 2>/dev/null)" != "$h" ]; then echo "$no HEAD moved"; return 0; fi
  if ! dirty=$(git status --porcelain --ignore-submodules=untracked 2>/dev/null) || [ -n "$dirty" ]; then
    echo "$no the tree is not clean"; return 0
  fi
  tree=$(git rev-parse -q --verify "$h^{tree}" 2>/dev/null)
  if [ -z "$tree" ]; then echo "$no the tree of ${h:0:8} could not be read"; return 0; fi
  read -ra words <<<"$bar"
  for w in "${words[@]}"; do case "$w" in */*|*.sh) paths="$paths${paths:+ }$w" ;; esac; done
  if ! { printf 'sha\t%s\ntree\t%s\nbar\t%s\nbar_paths\t%s\nkind\t%s\nbase\t%s\nselftests\t%s\nrun_id\t%s\nby\tpre-push\nstamped\t%s\n' \
           "$h" "$tree" "$bar" "$paths" "$kind" "$base" "${GATE_SELFTESTS:+1}" "$run" "$(date -u +%Y-%m-%dT%H:%M:%SZ)" \
           > "$g/gate-bar-green.tmp" && mv -f "$g/gate-bar-green.tmp" "$g/gate-bar-green"; } 2>/dev/null; then
    echo "$no $g/gate-bar-green could not be written"; return 0
  fi
  cdir=$(git rev-parse --git-common-dir 2>/dev/null) || cdir=""
  cdir_abs=""; [ -n "$cdir" ] && cdir_abs=$(cd "$cdir" 2>/dev/null && pwd -P)
  g_abs=$(cd "$g" 2>/dev/null && pwd -P) || g_abs=""
  if [ -n "$cdir_abs" ] && [ -n "$g_abs" ] && [ "$cdir_abs" != "$g_abs" ]; then
    cp "$g/gate-bar-green" "$cdir_abs/gate-bar-green.shared.tmp" 2>/dev/null \
      && mv -f "$cdir_abs/gate-bar-green.shared.tmp" "$cdir_abs/gate-bar-green.shared" 2>/dev/null
  fi
  echo "pre-push: recorded gate-bar-green for ${h:0:8} — kind $kind${base:+ base ${base:0:8}} — bar: $bar"
}

# THE RUNNER'S ARM SEAMS DO NOT REACH THE BOUNDARY (TOOL-dDerivedDocket-26). `GATE_SPAWN_CMD`,
# `GATE_SPAWN_FLOOR` and `GATE_VERDICT_FAULT` exist so the runner's own suites can stage a HOST verdict
# or a refusal; inherited here, the environment of the push would choose how its own red is classified.
unset GATE_SPAWN_CMD GATE_SPAWN_FLOOR GATE_VERDICT_FAULT
# THE PUSHED RANGE, from git's own ref line and never from the environment (S5): the remote's sha for
# the default branch before this push, all zeros when the push creates it. An inherited value is
# OVERWRITTEN, so no caller can hand the bar a range. An adopter's bar may classify the range
# `$GATE_PUSH_BASE..HEAD` by its own policy; gov's runner does not read it.
export GATE_PUSH_BASE="$main_remote"
# THE VETTED BAR, for the lander to read rather than re-derive (H1), once every refusal is behind us.
{ printf '%s\t%s\t%s\n' "$RUNLOG_BAR" "$bar_path" "$bar_blob" > "$PUSH_BAR"; } 2>/dev/null
set -o noglob                  # run as vetted: the vetting split this value with globbing off (B1)
$gate </dev/null
rc=$?
# AN EXIT 0 IS NOT A VERDICT UNTIL THE RECORD SAYS SO (TOOL-dDerivedDocket-26 S6). One push to the
# default branch proceeded with no bar run while this hook said it was forcing one
# (TOOL-aSurfacedLexicon-25), and the path that exited 0 was never found. Whatever it was, a runner
# that exits 0 without writing `verdict GREEN` into the record of the id pinned above is now RED here.
# The record is read, never stdout: a pipe waits for the last inherited write end, and the runner's
# wall watcher can outlive it holding one. It is checked whenever the RUNNER ran, whichever knob named
# it (`bar_record`, set where the bar was vetted). Only a bar that is not the runner goes unchecked,
# and it is announced: a declared GATE_CMD naming another script writes no record this hook can
# read, and the declared STUB is what every arm that stubs the bar uses.
if [ "$rc" -eq 0 ]; then
  case "$bar_record" in
    stub)
      echo "pre-push: the bar is the declared STUB (GOV_GATE_CMD_TEST), not this kit's runner, so its run record is not checked for an override command" ;;
    other)
      echo "pre-push: GOV_GATE_CMD runs the declared GATE_CMD '$bar_path', not this kit's runner, so its run record is not checked for an override command" ;;
    *)
      if ! check_verdict_record "$gd/gate-run/$RUNLOG_GATE_RUN"; then
        echo "pre-push: $PP_NOT — treating it as RED"
        rc=1
      fi ;;
  esac
fi
_own_rc=$rc   # the bar's OWN verdict, before the inherited-red arm below can land it as 0 (S2)
# A RED ON INHERITED LEGS ONLY LANDS UNDER `land`, and nowhere else (D12-i4), at any age since ruling
# TOOL-dUnstuckLanding-22. The exit that follows is
# still this hook's one exit, so the run log's decision stays the gate decision above; the landing is
# the printed line. An attended push lands over it too: `land` is this repository's policy for every
# push, not an unattended exception, and the line says so.
if [ "$rc" -ne 0 ] && [ "$PP_POLICY" = land ]; then
  if check_inherited_verdict "$gd/gate-run/$RUNLOG_GATE_RUN"; then
    echo "pre-push: red on inherited legs only — landing under INHERITED_RED=land: $PP_LEGS"
    rc=0
  else
    echo "pre-push: this red does not land under INHERITED_RED=land — $PP_NOT"
  fi
fi
if [ "$rc" -ne 0 ]; then
  why="pre-push: gate RED — push blocked (fix, or 'git push --no-verify' to override deliberately)."
  echo "$why"
  write_refusal gate-red "$why"
else
  # S4: THE GREEN MUST DESCRIBE THE PUSHED TREE. The bar runs for minutes to an hour, and anything
  # that commits during it (a formatter leg, another session in this tree) leaves a green earned on a
  # tree git is no longer pushing. The check at the top of this hook made before the bar is made again.
  _after=$(git rev-parse HEAD 2>/dev/null || true)
  if [ "$_after" != "$main_local" ]; then
    why="pre-push: refusing — HEAD moved from ${main_local:0:8} to ${_after:0:8} while the bar ran, so its green does not certify the tree being pushed."
    echo "$why" >&2
    write_refusal head-moved "$why"; RUNLOG_CLEAN=1; exit 1
  fi
  # THE GREEN IS RECORDED BY TREE (TOOL-aFrugalTurnstile-2 S2), on this hook's own green only. Never
  # for the STUB, and never on a doc-only scoped push: that bar ran fewer legs than a scoped bar from the
  # same base, which the record cannot say, so a later push of the same tree could be covered by more
  # than was graded. Declining costs a saving, never a verdict.
  if [ "$bar_record" = stub ]; then
    echo "pre-push: no gate-bar-green written — the bar is the declared STUB"
  elif [ -n "${GATE_DOCS_BASE:-}" ]; then
    echo "pre-push: no gate-bar-green written — this push was scoped doc-only"
  else
    _bg_base=""; [ "$RUNLOG_DECISION" = scoped ] && _bg_base=${GATE_BASE:-}
    write_bar_green "$gd" "$main_local" "$_own_rc" "$RUNLOG_DECISION" "$_bg_base" "$gate" "$RUNLOG_GATE_RUN"
  fi
fi
