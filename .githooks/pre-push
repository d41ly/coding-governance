#!/usr/bin/env bash
# coding-governance pre-push: the authoritative merge bar. On a push to the default branch it runs the
# FULL gate (tools/run-gates/run-gates.sh) once and BLOCKS the push if it reds. Other pushes are not
# gated. Every push this hook sees, gated or not, leaves its lines in the run log (see THE RUN LOG).
# Install once per clone: git config core.hooksPath .githooks. Override: git push --no-verify.
#
# Drift note: the ACTIVE hook is the TRACKED .githooks/ dir (core.hooksPath), and check-wiring.sh
# auto-wires an unset core.hooksPath. That is NOT the same as "tracked == active by construction",
# which this note used to claim. The shared `core.hooksPath` applies unless a worktree's config.worktree sets its own,
# and the value in effect decides which hook files run: an ABSOLUTE value runs the hooks of the
# checkout it names, the relative `.githooks` check-wiring writes runs each worktree's own — so under
# an absolute value the hook that gates YOUR push comes from the checkout it names, not from the tree
# you are pushing, and seven of nine live worktrees on node `d` carry such an override. Measured at TOOL-dUnstalledConvoy-26's
# landing: the primary tree was on a contrib branch, so the push ran that branch's pre-push — no
# gate-env sourcing, no predicate 8, and the boundary's coverage check absent. Nothing wrong shipped,
# because a separate full bar had verified the pushed tree; the BOUNDARY was not the one that shipped.
# check-wiring.sh check H now compares the resolved hooks against this tree's tracked blobs and
# REPORTS a divergence as a `note` (TOOL-aWeldedTribunal-7). It reports; it does not prevent.
# (The WIRE-INTO-PROJECT.md copy-install path reintroduces the drift a second way; the same check
# covers it, since it compares whatever core.hooksPath resolves to.)
set -u

# ---- S2 (TOOL-dScrubbedConduit-1): SCRUB THE ENVIRONMENT GIT INJECTS INTO THIS HOOK ---------------
# Git exports GIT_DIR whenever the repository is reached through a `.git` FILE rather than a `.git`
# directory — a LINKED WORKTREE as much as a submodule. A plain top-level clone exports nothing, which
# is why this went unseen here for so long while an adopter hit it head-on.
#
# The damage is done by any leg that creates a scratch repo: `git init` with GIT_DIR set does not make
# a repo at the cwd, it RE-INITIALISES the repo GIT_DIR names and re-derives core.bare from whether
# that path has a worktree of its own. For a worktree or submodule gitdir the answer is no, core.bare
# flips to true, and every later git call in the owning tree answers "must be run in a work tree".
# Two of this repo's own bar legs `git init` a scratch repo.
#
# GIT_EXEC_PATH is deliberately NOT scrubbed: it locates git's own helpers, and clearing it breaks git
# rather than protecting it.
unset GIT_DIR GIT_WORK_TREE GIT_INDEX_FILE GIT_OBJECT_DIRECTORY GIT_ALTERNATE_OBJECT_DIRECTORIES       GIT_COMMON_DIR GIT_NAMESPACE GIT_PREFIX

# ---- S5: A HOOK THAT CANNOT RESOLVE ITS REPO HAS NOT ESTABLISHED THAT THE PUSH IS SAFE -----------
# This was `|| exit 0`, and exit 0 from a pre-push hook means ALLOW. Measured end to end: with
# core.bare flipped, `git rev-parse --show-toplevel` exits 128, the early-exit fired, and a push
# LANDED ON THE REMOTE at rc=0 with the merge bar never having run. A gate that fails open is worse
# than no gate, because the green is reported.
if ! top=$(git rev-parse --show-toplevel 2>/dev/null); then
  echo "pre-push: REFUSING — cannot resolve this repository's work tree, so the merge bar cannot run" >&2
  echo "  and this hook cannot establish that the push is safe. This used to exit 0 (ALLOW)." >&2
  echo "  Most likely cause: core.bare=true in the shared config, which a leg that ran 'git init'" >&2
  echo "  under an inherited GIT_DIR can set. Check:" >&2
  echo "    git config --file \"\$(git rev-parse --git-common-dir)/config\" --get core.bare" >&2
  echo "  Deliberate override, as always: git push --no-verify" >&2
  exit 1
fi
if ! cd "$top"; then
  echo "pre-push: REFUSING — cannot enter the work tree at '$top'." >&2
  exit 1
fi

# ---- THE RUN LOG — TOOL-dLoggedFlight-4 ------------------------------------------------------------
# Every push this hook sees leaves lines in `pushes.log` under `runlog/` in the git COMMON dir, in the
# runlog kit's grammar, which that kit's README states; this block writes it and reads none of it. A
# push that reaches the ref loop writes a START after the loop and an END from the EXIT trap. The
# three default-branch refusals come BEFORE that loop, so each writes one `ev=once` line and no pair.
# The two refusals above this block write nothing: no journal root is known yet.
#
# A LINE RECORDS AN ATTEMPT, never a landing. Git fires this hook for a `--dry-run` and for a push the
# remote later rejects, and whether anything landed is git's answer. A `--no-verify` push runs no hook.
#
# THE URL IS NEVER WRITTEN, because it can carry credentials, and nor is any value that can hold one:
# a line carries `remote=<name>` or `remote_unnamed=1`, and `url_userinfo=1` where a URL held a
# `user@` part. `render_push_remote` below is the one place that decides which, and its comment states
# the rule, an `insteadOf` rewrite's typed URL included.
#
# EVIDENCE, NEVER AN INPUT. Nothing below branches on a line, and no gating decision, refusal or
# signal behaviour moved. A failed append prints ONE `pre-push: run log` line on stderr and changes
# neither the exit code nor stdout. `GOV_RUNLOG=0` in the environment writes nothing.
#
# NO SIGNAL TRAP, ON PURPOSE. A trapped TERM waits for the foreground child, and the child here is the
# merge bar, so a TERM trap would hold a killed push for as long as the bar runs. Every exit the hook
# CHOOSES after the trap sets RUNLOG_CLEAN=1 immediately before it, and the EXIT trap, which an
# untrapped TERM still runs, writes `exit=clean` or `exit=unclean` from that mark. A KILL runs no
# trap, so a START with no END is its signature. An unclean END's `rc` is whatever `$?` the trap saw,
# often 0: read `exit=` first. The run-log suite beside this file enumerates every `exit` in it.
#
# ZERO SPAWNS: builtin reads, parameter expansion, `EPOCHREALTIME` and one `printf >>` per line. A
# clone's first push pays one `mkdir` for the journal directory, and a clone that has one pays nothing.
#
# THE JOIN TO THE BAR. When this hook runs the bar it exports `GATE_RUN_ID` as `push-<digits>-<pid>`
# and writes the same value as `gate_run` on END, so the bar's own run-log line, which names its run,
# joins this push exactly. The runner removes the variable once read, so no leg inherits it.
#
# ROLLOUT. `core.hooksPath` is absolute, so a push from ANY worktree runs the PRIMARY tree's copy of
# this file: its lines appear once the primary tree has checked this change out, and not before.
#
# WHAT THIS DOES NOT CATCH. The two refusals above; a KILL; and an `exit`, or an EXIT trap of its own,
# inside the repository's `.githooks/gate-env.sh`, which is sourced below and is not this file. Every
# read in the EXIT trap is defaulted, because `set -u` holds there and a handler that aborts on an
# unset name writes nothing for exactly the push it exists to record.
RUNLOG_MAX_BYTES=2048   # the grammar's line cap, LF not counted
RUNLOG_REF_CAP=10       # ref.1 .. ref.10 on START; every ref line past them is counted into ref_more
RUNLOG_SWITCH=${GOV_RUNLOG:-}
RUNLOG_ARG1=${1-}; RUNLOG_ARG2=${2-}
RUNLOG_GITDIR=""; RUNLOG_DIR=""; RUNLOG_N=""; RUNLOG_DECISION=""; RUNLOG_GATE_RUN=""
RUNLOG_CLEAN=""; RUNLOG_WARNED=""; RUNLOG_MKDIR=""; RUNLOG_REF_MORE=0
RUNLOG_REFS=(); RUNLOG_REMOTE=()

# The two directories, with no `git` process: this tree's git dir holds the lander's marker, and the
# COMMON dir holds the journal. `.git` is a directory in a primary tree and a `gitdir:` file in a
# linked worktree, whose `commondir` names the common dir relative to it; `../` is folded so a path
# this prints is the one git would print. A primary tree has no `commondir` and its git dir IS the
# common dir. Never `.git/worktrees/<name>/runlog`, which would split one clone's journal in two.
resolve_push_dirs() { # work tree -> sets RUNLOG_GITDIR and RUNLOG_DIR; rc 1 when no git dir resolves
  local g="${1:-.}/.git" l="" c=""
  if [ -f "$g" ]; then
    { IFS= read -r l < "$g"; } 2>/dev/null || [ -n "$l" ] || return 1
    l=${l%$'\r'}
    case "$l" in "gitdir: "?*) g=${l#gitdir: } ;; *) return 1 ;; esac
    case "$g" in /*|[A-Za-z]:[/\\]*) ;; *) g="${1:-.}/$g" ;; esac
  elif [ ! -d "$g" ]; then
    return 1
  fi
  RUNLOG_GITDIR=$g
  if [ -f "$g/commondir" ]; then
    { IFS= read -r c < "$g/commondir"; } 2>/dev/null || [ -n "$c" ] || return 1
    c=${c%$'\r'}
    case "$c" in
      /*|[A-Za-z]:[/\\]*) ;;
      *) while :; do
           case "$c" in
             ..)   g=${g%/*}; c=""; break ;;
             ../*) g=${g%/*}; c=${c#../} ;;
             *)    break ;;
           esac
         done
         c="$g${c:+/$c}" ;;
    esac
  else
    c=$g
  fi
  RUNLOG_DIR="$c/runlog"
  return 0
}

# S3's fields, rendered ONCE for both lines that carry them, so the refusal line cannot carry a weaker
# guard than START. The URL never leaves this function; only two facts about it do.
#
# A NAME HOLDS NONE OF `/`, `\`, `:` OR `@`, and every URL form git takes holds one of them, the
# scp-like `user@host:path` and a drive-letter path included, save a bare directory name in the
# current directory. The shape test is what keeps a typed URL out: under an `insteadOf` rewrite $1 is
# that URL and differs from $2, which the first cut read as a name and wrote whole, userinfo and all
# (L1 of the closing diff review, round 1). The difference test stays for that bare directory name,
# which git passes as both. Builtin tests only, so the hook's exec count does not move.
#
# USERINFO IS READ OFF BOTH ARGUMENTS, since the rewrite that puts a typed URL in $1 leaves $2 a plain
# path. An authority is the part after `://` up to the next `/`, or for scp-like `user@host:path` the
# part before the colon; a plain path, a drive-letter one included, has neither and holds no userinfo.
render_push_remote() { # remote name · url -> sets RUNLOG_REMOTE to its key/value pairs
  local a="" u n="${1-}"
  RUNLOG_REMOTE=()
  case "$n" in
    ""|*[/\\:@]*) RUNLOG_REMOTE+=(remote_unnamed 1) ;;
    *) if [ "$n" != "${2-}" ]; then RUNLOG_REMOTE+=(remote "$n"); else RUNLOG_REMOTE+=(remote_unnamed 1); fi ;;
  esac
  for u in "$n" "${2-}"; do
    a=""
    case "$u" in
      *://*) a=${u#*://}; a=${a%%/*} ;;
      *:*)   a=${u%%:*}; case "$a" in */*) a="" ;; esac ;;
    esac
    case "$a" in *@*) RUNLOG_REMOTE+=(url_userinfo 1); break ;; esac
  done
  return 0
}

# THE ONE APPEND, in the grammar's own bytes. Each value is escaped backslash FIRST, then TAB, LF and
# CR, so the first pass cannot re-escape the others. A line over the cap is fitted by the runlog kit's
# REFERENCE rule, and the run-log suite compares the result with that kit's `render_line`: drop whole
# indexed fields, highest index first, counting each into its `_more`; only when none is left, cut the
# longest value outside `v n t p ev` and the `_more` counts from its end, never inside a UTF-8
# character and never inside an escape, and measure again. `LC_ALL=C` for this function alone, so
# `${#v}` counts BYTES, which is what the cap counts.
write_push_line() { # key value [key value ...] -> one line appended to the push journal
  [ "${RUNLOG_SWITCH:-}" != 0 ] || return 0
  local LC_ALL=C bs='\' tab=$'\t' line="" v i nm f size=0 best blen top cut b need
  local -a key=() val=()
  while [ "$#" -ge 2 ]; do
    v=${2//"$bs"/"$bs$bs"}; v=${v//$'\t'/'\t'}; v=${v//$'\n'/'\n'}; v=${v//$'\r'/'\r'}
    key+=("$1"); val+=("$v"); shift 2
  done
  for i in "${!key[@]}"; do size=$(( size + ${#key[i]} + ${#val[i]} + 2 )); done
  size=$(( size - 1 ))
  # STEP ONE: whole indexed fields, the highest index first, a tie going to the later field.
  while [ "$size" -gt "$RUNLOG_MAX_BYTES" ]; do
    best=-1; top=-1
    for i in "${!key[@]}"; do
      case "${key[i]}" in
        *.*) nm=${key[i]#*.}
             case "$nm" in ""|*[!0-9]*) ;; *) [ "$((10#$nm))" -ge "$top" ] && { best=$i; top=$((10#$nm)); } ;; esac ;;
      esac
    done
    [ "$best" -ge 0 ] || break
    nm="${key[best]%%.*}_more"
    size=$(( size - ${#key[best]} - ${#val[best]} - 2 ))
    key=("${key[@]:0:best}" "${key[@]:best+1}"); val=("${val[@]:0:best}" "${val[@]:best+1}")
    f=-1
    for i in "${!key[@]}"; do [ "${key[i]}" = "$nm" ] && { f=$i; break; }; done
    if [ "$f" -ge 0 ]; then
      size=$(( size - ${#val[f]} )); val[f]=$(( ${val[f]} + 1 )); size=$(( size + ${#val[f]} ))
    else
      key+=("$nm"); val+=(1); size=$(( size + ${#nm} + 3 ))
    fi
  done
  # STEP TWO: cut the longest value outside the protected keys, the first of equals, from its end.
  while [ "$size" -gt "$RUNLOG_MAX_BYTES" ]; do
    best=-1; blen=0
    for i in "${!key[@]}"; do
      case "${key[i]}" in v|n|t|p|ev|*_more) continue ;; esac
      [ "${#val[i]}" -gt "$blen" ] && { best=$i; blen=${#val[i]}; }
    done
    [ "$best" -ge 0 ] || break
    b=$(( blen - (size - RUNLOG_MAX_BYTES) )); [ "$b" -gt 0 ] || b=0
    cut=${val[best]:0:b}
    # A character cut in half is dropped whole, as the reference's decode drops it: count the
    # continuation bytes that end the value, then ask the lead byte before them how many it needed.
    b=0
    while [ "$b" -lt "${#cut}" ] && [ "$b" -lt 3 ]; do
      case "${cut:$(( ${#cut} - b - 1 )):1}" in [$'\x80'-$'\xbf']) b=$((b + 1)) ;; *) break ;; esac
    done
    if [ "$b" -lt "${#cut}" ]; then
      case "${cut:$(( ${#cut} - b - 1 )):1}" in
        [$'\xc0'-$'\xdf']) need=1 ;;
        [$'\xe0'-$'\xef']) need=2 ;;
        [$'\xf0'-$'\xf7']) need=3 ;;
        *)                 need=0 ;;
      esac
      [ "$b" -lt "$need" ] && cut=${cut:0:$(( ${#cut} - b - 1 ))}
    fi
    # ...and an escape cut in half leaves an ODD run of trailing backslashes: drop one.
    b=0
    while [ "$b" -lt "${#cut}" ] && [ "${cut:$(( ${#cut} - b - 1 )):1}" = "$bs" ]; do b=$((b + 1)); done
    [ $(( b % 2 )) -eq 1 ] && cut=${cut%?}
    size=$(( size - blen + ${#cut} )); val[best]=$cut
  done
  for i in "${!key[@]}"; do line+="${line:+$tab}${key[i]}=${val[i]}"; done
  if [ -n "$RUNLOG_DIR" ] && [ ! -d "$RUNLOG_DIR" ] && [ -z "$RUNLOG_MKDIR" ]; then
    RUNLOG_MKDIR=1; mkdir "$RUNLOG_DIR" 2>/dev/null
  fi
  [ -n "$RUNLOG_DIR" ] && { printf '%s\n' "$line" >> "$RUNLOG_DIR/pushes.log"; } 2>/dev/null && return 0
  if [ -z "$RUNLOG_WARNED" ]; then
    RUNLOG_WARNED=1
    printf 'pre-push: run log — cannot append to %s, so this push is not recorded there; its gate, its output and its exit code are unaffected\n' \
      "${RUNLOG_DIR:-(no git dir resolved)}/pushes.log" >&2
  fi
  return 0
}

# A default-branch refusal that comes before the ref loop: one unpaired line, since no START exists.
write_push_once() { # decision -> one ev=once line
  local t lander=0
  if [ -n "${EPOCHREALTIME:-}" ]; then t=${EPOCHREALTIME/,/.}; else printf -v t '%(%s)T' -1; fi
  [ -n "$RUNLOG_GITDIR" ] && [ -f "$RUNLOG_GITDIR/push-main-active" ] && lander=1
  render_push_remote "$RUNLOG_ARG1" "$RUNLOG_ARG2"
  write_push_line v 1 t "$t" p pushes ev once decision "${1:-}" "${RUNLOG_REMOTE[@]}" \
    lander "$lander" wt "${top:-}"
}

# After the ref loop: every ref line up to the count cap, the lander's marker, and the nonce END pairs on.
write_push_start() { # -> the START line, and the nonce END reads
  local t d r i=0 lander=0
  local -a f=()
  if [ -n "${EPOCHREALTIME:-}" ]; then t=${EPOCHREALTIME/,/.}; d=${t//[!0-9]/}
  else printf -v t '%(%s)T' -1; d="${t}000000"; fi
  RUNLOG_N="$$.$d"
  [ -n "$RUNLOG_GITDIR" ] && [ -f "$RUNLOG_GITDIR/push-main-active" ] && lander=1
  render_push_remote "$RUNLOG_ARG1" "$RUNLOG_ARG2"
  f=(v 1 t "$t" p pushes ev start n "$RUNLOG_N" "${RUNLOG_REMOTE[@]}" lander "$lander" wt "${top:-}")
  for r in ${RUNLOG_REFS[@]+"${RUNLOG_REFS[@]}"}; do i=$((i + 1)); f+=("ref.$i" "$r"); done
  [ "$RUNLOG_REF_MORE" -gt 0 ] && f+=(ref_more "$RUNLOG_REF_MORE")
  write_push_line "${f[@]}"
}

# Called by the EXIT trap and nothing else. EVERY read is defaulted: `set -u` holds inside a trap, and
# a trap that aborts on an unset name writes nothing for exactly the push it exists to record.
write_push_end() { # the status the EXIT trap saw -> the END line
  local rc="${1:-}" ex=unclean t
  local -a f=()
  [ "${RUNLOG_CLEAN:-}" = 1 ] && ex=clean
  if [ -n "${EPOCHREALTIME:-}" ]; then t=${EPOCHREALTIME/,/.}; else printf -v t '%(%s)T' -1; fi
  f=(v 1 t "$t" p pushes ev end n "${RUNLOG_N:-}" rc "$rc" exit "$ex" decision "${RUNLOG_DECISION:-}")
  [ -n "${RUNLOG_GATE_RUN:-}" ] && f+=(gate_run "$RUNLOG_GATE_RUN")
  write_push_line "${f[@]}"
}

resolve_push_dirs "$top" || { RUNLOG_GITDIR=""; RUNLOG_DIR=""; }

# ---- WHERE THIS TREE KEEPS ITS KITS — TOOL-dRetiredFork-11 ---------------------------------------
# This hook ships VERBATIM to every push-main adopter, so a hardcoded prefix ships too. It spelled
# `tools/` at five functional sites; at an adopter installed anywhere else the fingerprint helper and
# the leg-manifest diff resolved to NOTHING and the bar command named a script that does not exist.
# Forcing predicates 6 and 7 then matched nothing and did not fire, so a manifest-wide change landed
# scoped against a green earned on a DIFFERENT leg set — green-by-absence, in the hook that decides
# whether the authoritative bar is owed at all. TOOL-aBoundedCeiling-7; NicoCares carries the fix by
# hand as its carve-out 14/20.
#
# PROBED ON THE LEG MANIFEST, not on the run-gates directory. The manifest is what predicates 6 and 7
# actually read, and the two are not interchangeable: this repo's own pre-push fixtures write a
# `gate-legs.json` and never create a `run-gates/` directory at all, so a probe keyed on the
# directory falls through and takes twenty arms with it. Measured, on the first cut of this change.
#
# `tools` FIRST, because it is this kit's default and gov's tree must resolve unchanged; the fallback
# is only consulted when this tree shows no sign of `tools` at all. NicoCares probes `scripts` first
# for the mirror-image reason — the order is a default, never a rule.
GOV_KITROOT=tools
if [ ! -f "$top/tools/gate-legs.json" ] && [ ! -d "$top/tools/run-gates" ]; then
  if [ -f "$top/scripts/gate-legs.json" ] || [ -d "$top/scripts/run-gates" ]; then
    GOV_KITROOT=scripts
  fi
fi

# $def decides which pushed ref gets gated, so whoever supplies $def decides whether the gate runs AT
# ALL. GOV_DEFAULT_BRANCH used to outrank the observed default and was never checked for meaning, which
# made it a fail-OPEN over every leg on the bar, not just this hook's own refusals.
#
# Reproduced 2026-08-11 with a live control, one variable changed between the two runs: with
# GOV_DEFAULT_BRANCH=main a raw push to main was refused (rc 1, remote unmoved); with
# GOV_DEFAULT_BRANCH naming a branch nobody was pushing, the SAME commit landed at rc 0 with the gate
# stubbed RED and no lander marker. The loop below simply never matched, main_local stayed empty, and
# the hook exited 0 down the "nothing to gate" path.
#
# So the observed default WINS, and the environment value is a CROSS-CHECK that can only refuse, never
# select. Where nothing is observable (a fresh `git init` + `remote add`, which is what this hook's own
# test builds) the environment is the only source and must at least name a branch that exists.
obs=$(git symbolic-ref --short refs/remotes/origin/HEAD 2>/dev/null); obs=${obs#origin/}
env_def=${GOV_DEFAULT_BRANCH:-}
if [ -n "$obs" ] && [ -n "$env_def" ] && [ "$obs" != "$env_def" ]; then
  echo "pre-push: GOV_DEFAULT_BRANCH names a branch this clone does not observe as the default, and the pushed ref is classified by that name — so an unrecognised one skips the bar entirely: env '$env_def' against observed '$obs'." >&2
  write_push_once refuse-default-branch; exit 1
fi
def=${obs:-$env_def}
if [ -z "$def" ]; then
  echo "pre-push: can't determine the default branch (origin/HEAD unset and GOV_DEFAULT_BRANCH unset)." >&2
  echo "  Refusing to guess — silently assuming 'main' would BYPASS this gate on a non-main default." >&2
  echo "  Fix once: git remote set-head origin -a   — or export GOV_DEFAULT_BRANCH=<branch>." >&2
  write_push_once refuse-default-branch; exit 1
fi
if ! git rev-parse --verify --quiet "refs/heads/$def" >/dev/null 2>&1 \
   && ! git rev-parse --verify --quiet "refs/remotes/origin/$def" >/dev/null 2>&1; then
  echo "pre-push: the default branch resolves to a name that is no branch in this clone, so every pushed ref would classify as 'not the default branch' and skip the gate: $def" >&2
  echo "  Fix once: git remote set-head origin -a   — or export GOV_DEFAULT_BRANCH=<a branch that exists>." >&2
  write_push_once refuse-default-branch; exit 1
fi

# git feeds one line per pushed ref on stdin: <local ref> <local sha> <remote ref> <remote sha>.
# Classify on the 3rd field (remote_ref) — `git push origin feat:refs/heads/main` updates the default
# branch from a differently-named local ref. Read ALL lines here; run the gate ONCE after the loop.
# The run log keeps each line too, rejoined with git's single spaces, up to its count cap.
main_local=""
main_remote=""
_pushed=""
while read -r _localref localsha remoteref _remotesha; do
  [ "$remoteref" = "refs/heads/$def" ] && { main_local=$localsha; main_remote=$_remotesha; }
  _pushed="$_pushed$localsha $remoteref
"
  if [ "${#RUNLOG_REFS[@]}" -lt "$RUNLOG_REF_CAP" ]; then
    RUNLOG_REFS+=("$_localref $localsha $remoteref $_remotesha")
  else
    RUNLOG_REF_MORE=$((RUNLOG_REF_MORE + 1))
  fi
done
write_push_start
trap 'write_push_end "$?"' EXIT
# FROM HERE ON, every exit sets its decision and RUNLOG_CLEAN=1 immediately before it.

# ---- the shards-to-builds STRAGGLER layer, PER PUSHED REF (TOOL-dDerivedDocket-13) ---------------
# ABOVE the "nothing to gate" exits, and the placement is the whole of it: those exits fire on every
# feature-branch push, so a block below them would never run for the refs this one is about.
#
# INERT WITHOUT THE LIBRARY. `straggler-guard.sh` is gov-only; this hook ships VERBATIM through the
# push-main kit, so in every adopter that took the hook and not the library nothing below runs. The
# source is guarded and the entry point is checked by name for that reason: an unguarded source, or
# a predicate called with the library's functions undefined, would refuse every push in every one of
# those trees — a path this hook positively asserts is inert.
#
# WHAT IT DOES, per pushed ref that is not the default branch and not a delete:
#   * A PRE-FLIP tip that still owes a relocation gets the recipe as a NOTICE and is NEVER blocked.
#     Refusing a feature push would strand the straggler's only off-node copy, which is worse than
#     the merge it is being warned about.
#   * A tip that has INTEGRATED the flip and still carries shards-mode row changes is handed to the
#     memory-tree kit's transition audit AT THAT SHA — never over HEAD, since a push may name any
#     ref — because a squash on the far side can erase the transition this is the last boundary able
#     to see. Exit 1 refuses and names the merge and the repair verb; exit 2 is a DEAD PROBE, which
#     PRINTS and allows, because these layers instruct and the merge bar is what guarantees.
#   * Neither the module nor a launcher resolving prints one skip line naming the ref, never silence.
#
# It runs BELOW the run log's START and EXIT trap, so its one refusal names its decision and sets the
# clean-exit mark like every exit after them: `refuse-straggler`.
_sg="$(cd "$(dirname "$0")" && pwd)/straggler-guard.sh"
if [ -f "$_sg" ] && . "$_sg" && command -v init_straggler_guard >/dev/null 2>&1 &&
   init_straggler_guard; then
  # The kit directory as a VALUE, and the kit ROOT from this hook's own probe above. The fallback is
  # the hook directory's own tree: under an absolute `core.hooksPath` the hook that runs comes from
  # another checkout, and that checkout is where a kit this tree lacks may still be.
  _sg_kit=memory-tree
  _sg_hooktree=$(cd "$(dirname "$0")/.." && pwd)
  _sg_module=""
  for _c in "$top/$GOV_KITROOT/$_sg_kit/transition_audit.py" \
            "$_sg_hooktree/$GOV_KITROOT/$_sg_kit/transition_audit.py"; do
    if [ -f "$_c" ]; then _sg_module="$_c"; break; fi
  done
  _sg_py=""
  for _c in "$top/$GOV_KITROOT/lib/resolve-python.sh" \
            "$_sg_hooktree/$GOV_KITROOT/lib/resolve-python.sh"; do
    if [ -f "$_c" ]; then
      # shellcheck source=/dev/null
      . "$_c" && _sg_py=$(resolve_python 2>/dev/null || true)
      break
    fi
  done
  while read -r _sha _ref; do
    [ -n "$_ref" ] || continue
    [ "$_ref" = "refs/heads/$def" ] && continue
    [ -z "${_sha//0/}" ] && continue
    check_has_delta "$_sha" || continue
    if check_preflip "$_sha"; then
      echo "pre-push: note — $_ref predates the per-build backlog and still owes a relocation of its"
      echo "  backlog rows. This push is NOT blocked; relocate before it merges:"
      print_recipe "  "
      continue
    fi
    if [ -z "$_sg_module" ]; then
      echo "pre-push: the transition audit did NOT run over $_ref — the memory-tree kit is installed neither under '$top' nor beside this hook, so the straggler question was not asked. Check 25 still binds at the merge bar."
      continue
    fi
    if [ -z "$_sg_py" ]; then
      echo "pre-push: the transition audit did NOT run over $_ref — no usable python launcher resolved, so the straggler question was not asked. Check 25 still binds at the merge bar."
      continue
    fi
    _sg_out=$("$_sg_py" "$_sg_module" --at "$_sha" --expect-builds 2>&1); _sg_rc=$?
    if [ "$_sg_rc" = 2 ]; then
      echo "pre-push: DEAD PROBE — the transition audit could not answer for $_ref, so this push is ALLOWED on a signal that did not measure:"
      printf '%s\n' "$_sg_out" | sed 's/^/  /'
    elif [ "$_sg_rc" != 0 ]; then
      echo "pre-push: REFUSING — $_ref carries a transition merge whose row changes are unaccounted:"
      printf '%s\n' "$_sg_out" | sed 's/^/  /'
      echo "  Repair it forward with the '--repair <merge-sha>' the lines above name, then push again."
      echo "  Deliberate override, as always: git push --no-verify"
      RUNLOG_DECISION=refuse-straggler; RUNLOG_CLEAN=1; exit 1
    fi
  done <<< "$_pushed"
fi

[ -z "$main_local" ] && { RUNLOG_DECISION=skip-nondefault; RUNLOG_CLEAN=1; exit 0; }   # no push to the default branch → nothing to gate
[ -z "${main_local//0/}" ] && { RUNLOG_DECISION=skip-delete; RUNLOG_CLEAN=1; exit 0; }   # all-zero local sha = a delete → nothing to gate

# MOVED BELOW THE "NOTHING TO GATE" EXITS, and the move is the whole fix. This refusal used to
# sit beside the kit-root probe, ABOVE every question about which ref is being pushed — so an
# adopter installed at a third prefix (govkit accepts any, via `demand_safe_token`) had EVERY
# push refused, feature branches included, on a hook whose own header says "Other pushes do
# nothing". Reproduced by the closing review on a scratch remote: a `vendor/gov/` install
# refused `git push origin feature` with a message about forcing predicates and a green earned
# on a different leg set, neither of which applies to a push this hook never gates. There is no
# escape hatch either — `GOV_KITROOT` is assigned, not defaulted from the environment — so such
# an adopter had to hand-edit the hook or pass --no-verify on every branch push.
#
# On a DEFAULT-BRANCH push the refusal is still exactly right, and that is where it now lives:
# their bar genuinely cannot run, and saying so at the one boundary that reads the manifest is
# the point. Ordering, not content.
# A PATH THAT RESOLVES TO NOTHING IS A REFUSAL, NEVER A NON-MATCH — but only where the tree actually
# HAS a manifest to find. Those two cases look identical from the outside and that is precisely what
# made the original failure silent: `git diff -- <unresolvable>` reports "no change here" and the
# push sails through. A repo with no manifest anywhere is a different and legitimate case (a fresh
# adopter, a project not using run-gates, this hook's own fixtures), and it is left alone.
if [ ! -f "$top/$GOV_KITROOT/gate-legs.json" ]; then
  _elsewhere=$(git ls-files --cached -- '*gate-legs.json' 2>/dev/null | head -1)
  if [ -n "$_elsewhere" ]; then
    echo "pre-push: REFUSING — this tree tracks a leg manifest at '$_elsewhere', but this hook" >&2
    echo "  resolved its kit root to '$GOV_KITROOT' and looked for '$GOV_KITROOT/gate-legs.json'." >&2
    echo "  Left alone, the two forcing predicates that read that path would match NOTHING and the" >&2
    echo "  push would be scoped against a green earned on a different leg set." >&2
    echo "  Deliberate override, as always: git push --no-verify" >&2
    RUNLOG_DECISION=refuse-manifest; RUNLOG_CLEAN=1; exit 1
  fi
fi


# TOOL-aLeasedGauntlet-1: a default-branch push must go through tools/push-main.sh, which reconciles
# origin BEFORE this full gate so it never runs on a stale tree. The lander sets this marker; a raw
# push lacks it and is refused (--no-verify bypasses). The kit hook has no code/docs split, so EVERY
# unmarked default-branch push is refused.
if [ ! -f "$(git rev-parse --git-dir)/push-main-active" ]; then
  echo "pre-push: refusing a raw push to $def — land via $GOV_KITROOT/push-main.sh (it reconciles before the gate), or --no-verify to bypass." >&2
  RUNLOG_DECISION=refuse-raw; RUNLOG_CLEAN=1; exit 1
fi

# The tree the hook validates must BE the pushed default-branch tip, else the gate certifies content
# that isn't what lands (a push issued from a feature worktree, or `git push <sha>:main`).
head=$(git rev-parse HEAD 2>/dev/null || true)
if [ "$main_local" != "$head" ]; then
  echo "pre-push: refusing — pushing $def @ ${main_local:0:8} but this working tree is at ${head:0:8}."
  echo "  Push $def from the primary tree checked out at the pushed tip (playbook §3), or --no-verify."
  RUNLOG_DECISION=refuse-head; RUNLOG_CLEAN=1; exit 1
fi

# ---- the boundary DECIDES, and the obligation it replaces is bounded rather than deleted --------
# This hook used to export GATE_FULL=1 unconditionally, which made every landing pay the whole bar
# — a records-only landing included. What that bought was a real property: a guard could only ever
# narrow a run that was not the deciding one, so a too-narrow guard cost an early signal rather than
# a wrong merge verdict. Deleting the force deletes that property, so it is REPLACED by a bounded,
# RECORDED obligation: the full bar still runs, just not on every push, and the record says when it
# last did. (The retired sentence is deliberately not quoted verbatim anywhere: a criterion greps the
# tracked tree for it, and a historical mention is indistinguishable from a live claim to a probe.)
#
# EVERY PREDICATE BELOW FORCES. There is no predicate that makes a run smaller — the decision is
# "is a scoped run good enough this time", and every way of not knowing the answer is a force. That
# asymmetry is the whole safety argument: this block can be wrong in one direction only.

# A SOURCE CONSTANT with its reasoning beside it, not an environment knob. How stale a recorded
# green may be before the boundary stops trusting it is a policy decision about this repository,
# and a policy that an environment variable can change at the moment it binds is not a policy.
# TEN: this repo took 13 commits between origin/main and the tip inside a single build, so 10
# forces roughly one full bar per build rather than one per push. The design pass recommended 1 —
# behaviourally today's bar — and that was refused on the record: the owner's stated goal is to
# stop paying the full bar per landing, and 1 defers essentially all of the saving. Lowering it
# later needs no code.
GATE_FULL_MAX_LAG=10

# THE REPOSITORY'S OWN GATE POLICY, if it has one. This hook is shipped VERBATIM to every push-main
# adopter, so anything decided IN it is decided FOR them; anything decided in a file they do not
# receive is not. The mechanism travels, the choice does not. An adopter with no such file runs with
# whatever their environment carries, which is the documented default. TOOL-dUnstalledConvoy-28.
_gate_env="$(git rev-parse --show-toplevel 2>/dev/null)/.githooks/gate-env.sh"
# shellcheck source=/dev/null
[ -f "$_gate_env" ] && . "$_gate_env"

# ---- THE INHERITED-RED POLICY, READ AT R AND NEVER FROM THE PUSHED TREE — TOOL-dDerivedDocket-24 ---
# Two keys in that same file decide whether a push may land over a red the remote's own tip already
# carries: `INHERITED_RED=park|land` and `INHERITED_RED_MAX_AGE=<n>`, the second counted in
# first-parent landings. They are the one pair the source above does NOT supply. A branch that
# commits `INHERITED_RED=land` into its own copy would otherwise enable its own landing, so both are
# PARSED out of the file as committed at the remote sha git fed this hook — R, the landing base, which
# only a gated push can move — and R's bytes are never executed: one anchored match per key, a
# trailing comment and one pair of quotes stripped, then validated against `park land` or a positive
# integer. Absent, blank or malformed reads `park`, and so does `land` with no positive bound; the
# policy line below ANNOUNCES which, on every gated push. An adopter with no such file reads `park`,
# which is exactly the behaviour this hook had before the two keys existed.
#
# THE RELATIVE PATH IS DERIVED from the one the source reads, so this hook spells the file once. The
# four names are cleared so neither a sourced assignment nor the caller's environment reaches the
# runner under a name only this block may set. `read_policy_key` below is byte-identical to the
# unattended driver's copy: this hook ships verbatim and sources no kit, so the one parse of this
# policy is spelled twice, and the two readers must never disagree about a line.
_gate_env_rel=${_gate_env#"$(git rev-parse --show-toplevel 2>/dev/null)"/}
unset INHERITED_RED INHERITED_RED_MAX_AGE GATE_INHERITED_RED GATE_INHERITED_RED_MAX_AGE

read_policy_key() { # file text · key -> the LAST `<key>=` line's value, cleaned; nothing when none assigns it
  local line v="" hit=""
  while IFS= read -r line || [ -n "$line" ]; do
    line=${line%$'\r'}
    case "$line" in "$2="*) v=${line#"$2="}; hit=1 ;; esac
  done <<< "$1"
  [ -n "$hit" ] || return 0
  v=${v%%[[:space:]]#*}
  while [ "${v% }" != "$v" ] || [ "${v%$'\t'}" != "$v" ]; do v=${v%?}; done
  while [ "${v# }" != "$v" ]; do v=${v# }; done
  case "$v" in
    \"*\") v=${v#\"}; v=${v%\"} ;;
    \'*\') v=${v#\'}; v=${v%\'} ;;
  esac
  printf '%s' "$v"
}

read_policy_at() { # sha -> PP_POLICY (park|land), PP_MAX_AGE (set under land only) and PP_WHY
  local sha=$1 blob pol age
  PP_POLICY=park; PP_MAX_AGE=""; PP_WHY=""
  if [ -z "$sha" ] || [ -z "${sha//0/}" ]; then
    PP_WHY="the remote holds no tip for $def yet, so there is no R to read a policy at"; return 0
  fi
  if ! blob=$(git show "$sha:$_gate_env_rel" 2>/dev/null); then
    PP_WHY="$_gate_env_rel is absent at ${sha:0:8}, so no policy is adopted there"; return 0
  fi
  pol=$(read_policy_key "$blob" INHERITED_RED)
  age=$(read_policy_key "$blob" INHERITED_RED_MAX_AGE)
  case "$age" in ''|0*|*[!0-9]*) age="" ;; esac
  case "$pol" in
    land) if [ -n "$age" ]; then
            PP_POLICY=land; PP_MAX_AGE=$age; PP_WHY="declared, with an age bound of $age first-parent landings"
          else
            PP_WHY="INHERITED_RED=land with no positive INHERITED_RED_MAX_AGE beside it, which reads park"
          fi ;;
    park) PP_WHY="declared" ;;
    '')   PP_WHY="no INHERITED_RED is declared in $_gate_env_rel there" ;;
    *)    PP_WHY="INHERITED_RED is '$pol' there, outside 'park land', which reads park" ;;
  esac
}

gd=$(git rev-parse --git-dir 2>/dev/null)
kitfp="$top/$GOV_KITROOT/run-gates/gate-fingerprint.sh"
rec="$gd/gate-full-green"
force=""; lag=0
rec_sha=""; rec_fp=""; rec_blob=""; rec_st=""
if [ -f "$rec" ]; then
  rec_sha=$(awk -F'\t' '$1=="sha"{print $2}' "$rec" 2>/dev/null)
  rec_fp=$(awk -F'\t' '$1=="fingerprint"{print $2}' "$rec" 2>/dev/null)
  rec_blob=$(awk -F'\t' '$1=="manifest_blob"{print $2}' "$rec" 2>/dev/null)
  # WHAT THE RECORDED GREEN COVERED. Absent reads as OFF, and that default is the migration: every
  # stamp written before TOOL-dUnstalledConvoy-26 lacks this key, and defaulting the missing case to
  # "covered everything" would make each of them certify legs it never ran.
  rec_st=$(awk -F'\t' '$1=="selftests"{print $2}' "$rec" 2>/dev/null)
fi

# PREDICATES 2 TO 8, ONE FUNCTION, TWO RECORDS (TOOL-dDerivedDocket-24). They were inline and read
# the full green's fields; the inherited green below must pass exactly the same seven, so the seven
# became one function over a record's four fields rather than a second copy of them. The label is the
# only thing that differs, and it is spelled `full green` for the full green, so every message that
# record printed before is byte-identical. Sets `force` to the first predicate the record fails, or
# empty, and `lag` to its distance behind the tip.
check_green_record() { # sha · fingerprint · manifest blob · selftests · label
  local r_sha=$1 r_fp=$2 r_blob=$3 r_st=$4 label=$5 p2 fresh now_blob
  force=""; lag=0
  # 2. the recorded green is not an ancestor of what is being pushed, so it describes another line of
  #    history entirely.
  if ! git merge-base --is-ancestor "$r_sha" "$main_local" 2>/dev/null; then
    force="the recorded $label ${r_sha:0:8} is not an ancestor of the pushed tip"; return 0
  fi
  # 3. the recorded green is further behind the tip than the bound allows.
  lag=$(git rev-list --count "$r_sha..$main_local" 2>/dev/null || echo 0)
  if [ "${lag:-0}" -gt "$GATE_FULL_MAX_LAG" ]; then
    force="the recorded $label is $lag commits behind the tip (bound $GATE_FULL_MAX_LAG)"; return 0
  fi
  # 4. the record's TREE fingerprint does not reproduce AT THE SHA IT NAMES.
  #    AT THE RECORDED SHA, never at the tip. The digest is taken over the committed tree object, so
  #    it moves on every commit; joining it against a fresh fingerprint of the PUSHED TIP would fire
  #    on every push whose tree had moved, which is exactly the population predicates 2 and 3 already
  #    admit — it would force full forever while reading as caution. The helper is CALLED, never
  #    reimplemented: two implementations of one digest disagree silently and then force forever.
  if [ -n "$r_fp" ] && [ -x "$kitfp" ]; then
    fresh=$(bash "$kitfp" "$r_sha" 2>/dev/null)
    if [ -n "$fresh" ] && [ "$fresh" != "$r_fp" ]; then
      force="the recorded tree fingerprint does not reproduce at ${r_sha:0:8}"; return 0
    fi
  fi
  # 5. the pushed tip is a MERGE whose second parent the record cannot speak for. Every build lands
  #    on the default branch here as a merge commit, so this row fires on any first-attempt landing
  #    whose recorded green was not earned on that exact second parent — not only on a retry. Kept at
  #    that width deliberately: a merge tip the record does not cover is precisely the case the record
  #    cannot speak for.
  p2=$(git rev-parse -q --verify "$main_local^2" 2>/dev/null || true)
  if [ -n "$p2" ] && ! git merge-base --is-ancestor "$p2" "$r_sha" 2>/dev/null; then
    force="the pushed tip is a merge whose second parent ${p2:0:8} the recorded green does not cover"; return 0
  fi
  # 6. the diff touches the LEG MANIFEST, so the scoping decision itself has changed. A guard added,
  #    widened or removed in this very push cannot be trusted to scope this very push.
  if ! git diff --quiet "$r_sha" "$main_local" -- "$GOV_KITROOT/gate-legs.json" 2>/dev/null; then
    force="the pushed diff touches the leg manifest, so the scoping rules themselves moved"; return 0
  fi
  # 7. the recorded manifest blob differs from the one this tree holds — the same concern as 6, from
  #    the record's side, and it catches an uncommitted or differently-resolved manifest that a diff
  #    between two commits cannot see.
  if [ -n "$r_blob" ]; then
    now_blob=$(git hash-object -- "$GOV_KITROOT/gate-legs.json" 2>/dev/null)
    if [ -n "$now_blob" ] && [ "$now_blob" != "$r_blob" ]; then
      force="the leg manifest differs from the one the recorded green was earned on"; return 0
    fi
  fi
  # 8. the recorded green was earned with the KIT-SUBJECT legs HELD, and this push would run them.
  #    COVERAGE, not equality. A record earned with the self-tests ON is strictly stronger evidence
  #    than a switch-off push needs, so it satisfies one — forcing there would cost every adopter the
  #    whole saving TOOL-dUnstalledConvoy-26 exists to give, at the one boundary it was measured for.
  #    The relation only bites in the other direction: a weaker record offered for a stronger push.
  #    Without this predicate the `selftests` field the stamp writes is a byte nobody consults, and
  #    the boundary trusts a partial bar as a whole one. TOOL-dUnstalledConvoy-27.
  if [ -n "${GATE_SELFTESTS:-}" ] && [ "$r_st" != "1" ]; then
    force="this push runs the kit self-tests and the recorded $label was earned with them HELD"; return 0
  fi
  return 0
}

# 1. no record at all — nothing has ever proven this bar here.
[ -n "$rec_sha" ] || force="no recorded full green"
[ -z "$force" ] && check_green_record "$rec_sha" "$rec_fp" "$rec_blob" "$rec_st" "full green"

# THE POLICY AT R, announced on every gated push whatever it reads, because the difference between
# the two answers is whether an inherited red lands.
read_policy_at "$main_remote"
echo "pre-push: inherited-red policy at ${main_remote:0:8} reads $PP_POLICY — $PP_WHY (read from $_gate_env_rel at that sha, never from the pushed tree)"

# THE INHERITED GREEN (KF2), looked for WHENEVER predicates 1 to 8 would force FULL: the full green
# absent, or present and refused by any of 2 to 8. Reading it only when the full green is ABSENT would
# force a FULL bar on every push from a git dir that ever earned a full green, for as long as the
# default branch holds an inherited red. It selects the scoped gate only when the policy at R is
# `land`, its `base` IS the remote sha on this hook's stdin, its `max_age` IS the bound parsed at that
# sha, and its `sha` passes predicates 2 to 8 exactly as a full green would. It never satisfies
# predicate 1 in the full green's place: it is a different file, read in a different branch, and a
# FULL force it does not lift still names why it was not used.
inh_sha=""; inh_why=""
if [ -n "$force" ] && [ -f "$gd/gate-inherited-green" ]; then
  _ig="$gd/gate-inherited-green"
  ig_sha=$(awk -F'\t' '$1=="sha"{print $2}' "$_ig" 2>/dev/null)
  ig_fp=$(awk -F'\t' '$1=="fingerprint"{print $2}' "$_ig" 2>/dev/null)
  ig_blob=$(awk -F'\t' '$1=="manifest_blob"{print $2}' "$_ig" 2>/dev/null)
  ig_st=$(awk -F'\t' '$1=="selftests"{print $2}' "$_ig" 2>/dev/null)
  ig_base=$(awk -F'\t' '$1=="base"{print $2}' "$_ig" 2>/dev/null)
  ig_age=$(awk -F'\t' '$1=="max_age"{print $2}' "$_ig" 2>/dev/null)
  full_force=$force
  if [ "$PP_POLICY" != land ]; then
    inh_why="an inherited green is not read while the policy at R reads $PP_POLICY"
  elif [ -z "$ig_sha" ] || [ "$ig_base" != "$main_remote" ]; then
    inh_why="the inherited green was earned against base ${ig_base:0:8} and the remote holds ${main_remote:0:8}"
  elif [ "$ig_age" != "$PP_MAX_AGE" ]; then
    inh_why="the inherited green was written under max_age ${ig_age:-none} and the bound at ${main_remote:0:8} is $PP_MAX_AGE"
  else
    check_green_record "$ig_sha" "$ig_fp" "$ig_blob" "$ig_st" "inherited green"
    if [ -z "$force" ]; then inh_sha=$ig_sha; else inh_why="the inherited green ${ig_sha:0:8} is refused too: $force"; fi
  fi
  [ -n "$inh_sha" ] || force=$full_force
fi

# THE DECISION AND ITS REASON, on one line, always. A boundary that silently chooses the cheap path
# is indistinguishable from one that is broken, and this line is the only place the choice is
# visible to the person whose push it is.
if [ -n "$inh_sha" ]; then
  echo "pre-push: scoped gate on $def push (${main_local:0:8}) — inherited green ${inh_sha:0:8} at base ${main_remote:0:8} is ${lag:-0} commit(s) back, within $GATE_FULL_MAX_LAG; the full green was not usable: $full_force"
  export GATE_BASE="$inh_sha"
  RUNLOG_DECISION=scoped
elif [ -n "$force" ]; then
  echo "pre-push: FULL gate on $def push (${main_local:0:8}) — $force${inh_why:+; $inh_why}"
  export GATE_FULL=1
  RUNLOG_DECISION=full
else
  echo "pre-push: scoped gate on $def push (${main_local:0:8}) — full green ${rec_sha:0:8} is ${lag:-0} commit(s) back, within $GATE_FULL_MAX_LAG"
  export GATE_BASE="$rec_sha"
  RUNLOG_DECISION=scoped
fi
# THE BAR'S RUN ID, pinned so this push's END joins the bar's own run-log line by id. Set BEFORE the
# bar, like the decision, so a push killed mid-bar still names the bar it was waiting on.
# UNPREDICTABLE AND CLEARED FIRST (TOOL-dDerivedDocket-24, in the spelling the honest-verdicts unit
# specifies for its own pin): the id carries `$$` and `$RANDOM`, and any directory of that name under
# the run root is removed before the bar starts, because this hook READS that run's record after the
# bar and a record the runner never wrote must not be mistaken for one it did. `$RANDOM` rides the
# digit run, so the id keeps the `push-<digits>-<pid>` shape the run log joins on.
if [ -n "${EPOCHREALTIME:-}" ]; then RUNLOG_GATE_RUN="push-${EPOCHREALTIME//[!0-9]/}${RANDOM}-$$"
else printf -v RUNLOG_GATE_RUN 'push-%(%s)T%s-%s' -1 "$RANDOM" "$$"; fi
[ -n "$gd" ] && rm -rf "$gd/gate-run/$RUNLOG_GATE_RUN" 2>/dev/null
export GATE_RUN_ID="$RUNLOG_GATE_RUN"
# A RED AT THE PUSH BOUNDARY IS ATTRIBUTED against the sha the REMOTE holds for the default branch —
# the one git fed this hook on stdin, which is the landing base and never this clone's own tip, so a
# red is re-run against the tree the push would land on rather than against the tree that has it.
# An all-zero sha is a branch the remote does not have yet, so there is no base to name. A runner
# older than the attribution ignores the variable. TOOL-dDerivedDocket-23. The policy read at R rides
# with it, and the age bound only under `land`, the one policy that reads the age.
if [ -n "$main_remote" ] && [ -n "${main_remote//0/}" ]; then
  export GATE_ATTRIBUTE="$main_remote"
  export GATE_INHERITED_RED="$PP_POLICY"
  [ -n "$PP_MAX_AGE" ] && export GATE_INHERITED_RED_MAX_AGE="$PP_MAX_AGE"
fi

# check_inherited_verdict <run dir> — rc 0 when THAT bar's own record reads RED on an UNMOVED tree,
# its wall unfired, and every failed leg INHERITED with a proven age inside the bound, attributed
# against the remote's own sha, one attribution row per failed leg. Sets PP_LEGS, or PP_NOT naming
# the first condition that failed. It reads the record of the run id pinned above and no other.
check_inherited_verdict() {
  local d=$1 v tm fl wb n=0 bad="" leg ver rsha age
  PP_LEGS=""; PP_NOT=""
  if [ ! -f "$d/verdict" ]; then
    PP_NOT="the bar left no verdict in its run record, so nothing says which legs failed"; return 1
  fi
  v=$(awk -F'\t' '$1=="verdict"{print $2}' "$d/verdict" 2>/dev/null)
  tm=$(awk -F'\t' '$1=="tree_moved"{print $2}' "$d/verdict" 2>/dev/null)
  fl=$(awk -F'\t' '$1=="failed"{print $2}' "$d/verdict" 2>/dev/null)
  wb=$(awk -F'\t' '$1=="wall_breach"{print $2}' "$d/verdict" 2>/dev/null)
  if [ "$tm" = yes ]; then
    PP_NOT="the tree moved while the bar ran, so no verdict describes the pushed commit"; return 1
  fi
  if [ -n "$wb" ]; then PP_NOT="the bar's wall fired, so a leg it killed was never graded"; return 1; fi
  if [ "$v" != RED ] || [ "$tm" != no ]; then
    PP_NOT="the bar's verdict reads '${v:-none}' with tree_moved '${tm:-none}', not a RED on an unmoved tree"; return 1
  fi
  if [ ! -f "$d/attribution" ]; then
    PP_NOT="the bar wrote no attribution record, so no red leg is shown to be inherited"; return 1
  fi
  while IFS=$'\t' read -r leg ver _ _ rsha age _; do
    [ -n "$leg" ] || continue
    n=$((n + 1))
    PP_LEGS="$PP_LEGS${PP_LEGS:+, }$leg"
    if [ "$ver" != INHERITED ]; then bad="$leg reads $ver"; break; fi
    case "$age" in
      ''|-|*[!0-9]*) bad="$leg reads INHERITED with age '${age:-none}', not a proven age inside the bound"; break ;;
    esac
    if [ "$rsha" != "$main_remote" ]; then bad="$leg was attributed against ${rsha:0:8}, not the remote's ${main_remote:0:8}"; break; fi
  done < "$d/attribution"
  if [ -n "$bad" ]; then PP_NOT=$bad; return 1; fi
  if [ "$n" = 0 ] || [ "$n" != "${fl:-}" ]; then
    PP_NOT="the attribution names $n red leg(s) and the verdict counts ${fl:-none} failed"; return 1
  fi
  return 0
}

# check_verdict_record <run dir> — rc 0 when THAT bar's own record reads `verdict GREEN`, the
# honest-verdicts unit's boundary half of its no-silent-pass envelope (TOOL-dDerivedDocket-26 S6).
# Sets PP_NOT naming what was missing otherwise. The run dir is the id this hook pinned above and
# cleared before the bar started, so a record the runner did not write in THIS push cannot be read.
check_verdict_record() {
  local d=$1 v
  PP_NOT=""
  if [ ! -f "$d/verdict" ]; then
    PP_NOT="the bar exited 0 and left no verdict in its run record at $d"; return 1
  fi
  v=$(awk -F'\t' '$1=="verdict"{print $2; exit}' "$d/verdict" 2>/dev/null)
  [ "$v" = GREEN ] && return 0
  PP_NOT="the bar exited 0 and its run record reads verdict '${v:-none}', not GREEN"; return 1
}

gate=${GOV_GATE_CMD:-bash $GOV_KITROOT/run-gates/run-gates.sh}
$gate </dev/null
rc=$?
# AN EXIT 0 IS NOT A VERDICT UNTIL THE RECORD SAYS SO (TOOL-dDerivedDocket-26 S6). One push to the
# default branch proceeded with no bar run while this hook said it was forcing one
# (TOOL-aSurfacedLexicon-25), and the path that exited 0 was never found. Whatever it was, a runner
# that exits 0 without writing `verdict GREEN` into the record of the id pinned above is now RED here.
# The record is read, never stdout: a pipe waits for the last inherited write end, and the runner's
# wall watcher can outlive it holding one. An override command is not the runner and writes no
# record, so it is announced and not checked -- which is also what every arm that stubs the bar uses.
if [ "$rc" -eq 0 ]; then
  if [ -n "${GOV_GATE_CMD:-}" ]; then
    echo "pre-push: GOV_GATE_CMD overrides the bar, so its run record is not checked for an override command"
  elif ! check_verdict_record "$gd/gate-run/$RUNLOG_GATE_RUN"; then
    echo "pre-push: $PP_NOT — treating it as RED"
    rc=1
  fi
fi
# A RED ON INHERITED LEGS ONLY LANDS UNDER `land`, and nowhere else (D12-i4). The exit that follows is
# still this hook's one exit, so the run log's decision stays the gate decision above; the landing is
# the printed line. An attended push lands over it too: `land` is this repository's policy for every
# push, not an unattended exception, and the line says so.
if [ "$rc" -ne 0 ] && [ "$PP_POLICY" = land ]; then
  if check_inherited_verdict "$gd/gate-run/$RUNLOG_GATE_RUN"; then
    echo "pre-push: red on inherited legs only — landing under INHERITED_RED=land: $PP_LEGS"
    rc=0
  else
    echo "pre-push: this red does not land under INHERITED_RED=land — $PP_NOT"
  fi
fi
[ "$rc" -eq 0 ] || echo "pre-push: gate RED — push blocked (fix, or 'git push --no-verify' to override deliberately)."
RUNLOG_CLEAN=1; exit "$rc"
