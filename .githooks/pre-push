# `git init` already lives by. WHAT IS A NAME is decided once, by `resolve_remote_name`, which
# `render_push_remote` also calls to keep a URL out of the run log. `.githooks/gate-env.sh` is not
# sourced until after this, on purpose: a tracked file that could set the default could choose which
# branch escapes the bar.
resolve_remote_name "${1-}" "${2-}"
push_remote=$REMOTE_NAME
obs=""
if [ -n "$push_remote" ]; then
  obs=$(git symbolic-ref --short "refs/remotes/$push_remote/HEAD" 2>/dev/null); obs=${obs#"$push_remote"/}
fi
env_def=${GOV_DEFAULT_BRANCH:-}
if [ -n "$obs" ] && [ -n "$env_def" ] && [ "$obs" != "$env_def" ]; then
  why="pre-push: GOV_DEFAULT_BRANCH names a branch this clone does not observe as the default, and the pushed ref is classified by that name — so an unrecognised one skips the bar entirely: env '$env_def' against observed '$obs'."
  echo "$why" >&2
