# written once the bar is vetted and before it runs, cleared here first. push-main writes its lander
# marker only when this reads `default` or `tracked`. It used to re-derive "was the bar a stub?" from
# ITS OWN environment, so a sourced gate-env.sh setting the escape gave a stub-gated push the marker:
# one decision, two processes, two inputs. Now the lander reads the answer the hook acted on.
PUSH_BAR="${PUSH_REFUSAL%/*}/pre-push-bar"
# THE ALLOW RECORD, the third of the set (TOOL-aSignalledHook-1): `<pushed sha><TAB><gate run id>`,
# written ONLY at this hook's one success exit on a default-branch push, at the bottom of this file,
# and cleared here first. Git's exit 0 cannot say a hook allowed a push, because on Git for Windows a
# hook killed by a signal reads as 0 too; push-main reads this record before it calls a push landed.
PUSH_ALLOW="${PUSH_REFUSAL%/*}/pre-push-allow"
# --decide writes none of the three files, so every name is emptied and every writer below is guarded
# on the name.
[ -z "$DECIDE" ] || { PUSH_REFUSAL=""; PUSH_BAR=""; PUSH_ALLOW=""; }
[ -z "$PUSH_REFUSAL" ] || rm -f "$PUSH_REFUSAL" "$PUSH_BAR" "$PUSH_ALLOW"
bar_path=""; bar_blob=""
why=""
write_refusal() { # token · one-line message -> the refusal file, and the run-log decision the token pairs with
  local dec=""
  [ -n "$PUSH_REFUSAL" ] || return 0
  case "$1" in
    default-branch) dec=refuse-default-branch ;;
    manifest)       dec=refuse-manifest ;;
    raw-push)       dec=refuse-raw ;;
    head-mismatch)  dec=refuse-head ;;
    dirty-tree)     dec=refuse-dirty ;;
    bar-refused)    dec=refuse-bar ;;
    merge-loss)     dec=refuse-merge-loss ;;
    signalled)      dec=refuse-signal ;;
    bypass-refused) dec=refuse-bypass ;;
  esac
  { printf '%s\t%s\n' "$1" "${2-}" > "$PUSH_REFUSAL"; } 2>/dev/null
