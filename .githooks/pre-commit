#!/usr/bin/env bash
# coding-governance pre-commit fast leg. Install once per clone: git config core.hooksPath .githooks
# Runs only the cheap staged-scoped gates so a scripts-less checkout stays green.
set -u
# >>> refuse_wrong_shell — canonical copy: refuse-wrong-shell.sh in gov's lib dir (byte-identical; gated)
wrong_shell_at() {   # <abs path> <wsl 0|1>; returns 0 when the path is a Windows checkout under WSL
  [ "$2" = 1 ] || return 1
  case "$1" in /mnt/[a-z]/*) return 0 ;; esac
  return 1
}
refuse_wrong_shell() {
  _rws_wsl=0
  { [ -n "${WSL_DISTRO_NAME:-}" ] || [ -e /proc/sys/fs/binfmt_misc/WSLInterop ]; } && _rws_wsl=1
  _rws_p=${BASH_SOURCE[0]:-$0}
  case "$_rws_p" in /*) ;; *) _rws_p=$PWD/$_rws_p ;; esac
  wrong_shell_at "$_rws_p" "$_rws_wsl" || return 0
  echo "refuse_wrong_shell: WSL's bash is running $_rws_p from a Windows checkout under /mnt/;" >&2
  echo "refuse_wrong_shell: run it with Git's bash (C:/Program Files/Git/bin/bash.exe)." >&2
  return 1
}
# <<< refuse_wrong_shell
refuse_wrong_shell || exit 2
# Above: the wrong-shell refusal, inline and ahead of every leg (TOOL-dWitnessedBar-50 S3). The
# hook's one source of resolve-python.sh sits in resolve_hook_python, which a commit needing no
# python never reaches, so the refusal cannot wait for it. Git starts a hook at the work tree's top.

# The index git handed this hook, saved before the unset below (TOOL-dGroundRules-72). Under
# `git commit -a` or `git commit <path>` it is a temporary index, and a staged read of the real one
# sees nothing staged. Relative, it is relative to the work tree top, where git starts a hook.
hook_index=${GIT_INDEX_FILE:-}
case $hook_index in ""|/*|[A-Za-z]:*) ;; *) hook_index=$PWD/$hook_index ;; esac
with_hook_index() { if [ -n "$hook_index" ]; then GIT_INDEX_FILE=$hook_index "$@"; else "$@"; fi; }

# S2/S5 (TOOL-dScrubbedConduit-1), same two fixes as .githooks/pre-push and for the same reasons.
# GIT_EXEC_PATH is deliberately kept.
unset GIT_DIR GIT_WORK_TREE GIT_INDEX_FILE GIT_OBJECT_DIRECTORY GIT_ALTERNATE_OBJECT_DIRECTORIES       GIT_COMMON_DIR GIT_NAMESPACE GIT_PREFIX

if ! top=$(git rev-parse --show-toplevel 2>/dev/null); then
  echo "pre-commit: REFUSING — cannot resolve this repository's work tree, so the staged gates" >&2
  echo "  cannot run. This used to exit 0 (ALLOW). Override: git commit --no-verify" >&2
  exit 1
fi
cd "$top" || exit 1
rc=0

# govkit:branch-guard
# The remote ladder (TOOL-dLadderedRemote-2), INLINED byte-identically from the canonical copy
# named on its marker line and gated by the resolve-python self-test.
# >>> remote_ladder_sh -- canonical copy: resolve-remote.sh in the gov lib dir (byte-identical; gated)
# resolve_remote_sh -> RR_REMOTE RR_BRANCH RR_OBSERVED RR_WHY, rc 0; rc 1 with RR_WHY on a refusal.
# The ladder, row for row, is resolve_remote.py in the gov lib dir: GOV_REMOTE, else the current
# branch remote unless it is ".", else the ONLY remote; several and none chosen, or a name that is
# no remote here, refuses naming GOV_REMOTE; no remote at all is RR_REMOTE="" and rc 0. RR_OBSERVED
# is what <remote>/HEAD names; RR_BRANCH is GOV_DEFAULT_BRANCH, else RR_OBSERVED. Fetches nothing.
# RR_GIT names the git command, so a caller holding a pinned wrapper function passes it.
resolve_remote_sh() {
  local _rr_git=${RR_GIT:-git} _rr_names _rr_n _rr_list _rr_cur _rr_where _rr_how=GOV_REMOTE _rr_head _rr_bad
  RR_REMOTE=${GOV_REMOTE:-}; RR_BRANCH=""; RR_OBSERVED=""; RR_WHY=""
  _rr_names=$("$_rr_git" remote 2>/dev/null) || _rr_names=""
  _rr_n=$(printf "%s" "$_rr_names" | grep -c . || true)
  _rr_list=$(printf "%s" "$_rr_names" | tr "\n" " ")
  [ -n "$_rr_list" ] || _rr_list=none
  # FULL refs, never `--short`: a tag or branch sharing the name makes the short form ambiguous.
  _rr_cur=$("$_rr_git" symbolic-ref --quiet HEAD 2>/dev/null) || _rr_cur=""
  case "$_rr_cur" in refs/heads/?*) _rr_cur=${_rr_cur#refs/heads/} ;; *) _rr_cur="" ;; esac
  if [ -z "$RR_REMOTE" ] && [ -n "$_rr_cur" ]; then
    RR_REMOTE=$("$_rr_git" config "branch.$_rr_cur.remote" 2>/dev/null) || RR_REMOTE=""
    _rr_how="branch.$_rr_cur.remote"
    [ "$RR_REMOTE" != . ] || RR_REMOTE=""
  fi
  if [ -z "$RR_REMOTE" ] && [ "$_rr_n" -eq 1 ]; then RR_REMOTE=$_rr_names; fi
  if [ -z "$RR_REMOTE" ] && [ "$_rr_n" -gt 1 ]; then
    _rr_where="a detached HEAD"; [ -z "$_rr_cur" ] || _rr_where="branch $_rr_cur"
    RR_WHY="cannot choose a remote: GOV_REMOTE is unset, $_rr_where has no configured remote, and this repository has $_rr_n remotes ($_rr_list). Name it: export GOV_REMOTE=<remote>."
    return 1
  fi
  # A name holding whitespace is no remote: `grep -F` would split it into several patterns.
  case "$RR_REMOTE" in *[[:space:]]*) _rr_bad=1 ;; *) _rr_bad=0 ;; esac
  if [ -n "$RR_REMOTE" ] && { [ "$_rr_bad" = 1 ] || ! printf "%s\n" "$_rr_names" | grep -qxF -- "$RR_REMOTE"; }; then
    RR_WHY="$_rr_how names $RR_REMOTE, which is no remote of this repository ($_rr_list). Name one that is: export GOV_REMOTE=<remote>."
    RR_REMOTE=""
    return 1
  fi
  if [ -n "$RR_REMOTE" ]; then
    _rr_head=$("$_rr_git" symbolic-ref --quiet "refs/remotes/$RR_REMOTE/HEAD" 2>/dev/null) || _rr_head=""
    case "$_rr_head" in "refs/remotes/$RR_REMOTE"/?*) RR_OBSERVED=${_rr_head#"refs/remotes/$RR_REMOTE"/} ;; esac
  fi
  RR_BRANCH=${GOV_DEFAULT_BRANCH:-$RR_OBSERVED}
  return 0
}
# <<< remote_ladder_sh
# Branch guard — refuse a commit in the PRIMARY tree while parked off the default branch.
# Feature work belongs in a sibling worktree, not by stranding the primary tree on a branch
# (charter [isolate]). Default branch: GOV_DEFAULT_BRANCH, else the HEAD of the remote the
# ladder above resolves (TOOL-dLadderedRemote-2), else main. Override: --no-verify.
gd=$(git rev-parse --path-format=absolute --git-dir 2>/dev/null)
gc=$(git rev-parse --path-format=absolute --git-common-dir 2>/dev/null)
if [ -n "$gd" ] && [ "$gd" = "$gc" ]; then          # primary tree, not a linked worktree
  # GOV_DEFAULT_BRANCH FIRST and independent of the ladder: a ladder refusal returns before it sets
  # RR_BRANCH, and the pin must still hold there. The refusal is announced whenever no pin decides.
  # The refusal is announced only where it decides something: with GOV_DEFAULT_BRANCH set the pin
  # decides, and printing it on every commit would be noise nobody acts on.
  if ! resolve_remote_sh && [ -z "${GOV_DEFAULT_BRANCH:-}" ]; then
    echo "pre-commit: branch guard: $RR_WHY The default branch falls back to main." >&2
  fi
  def=${GOV_DEFAULT_BRANCH:-${RR_BRANCH:-main}}
  # The FULL ref, never `--short`: a tag named like the branch makes the short form `heads/<b>`.
  branch=$(git symbolic-ref --quiet HEAD 2>/dev/null || true); branch=${branch#refs/heads/}
  if [ -n "$branch" ] && [ "$branch" != "$def" ]; then
    echo "pre-commit: refusing a commit in the primary tree while on '$branch' (default: '$def')."
    echo "  Feature work belongs in a sibling worktree (charter [isolate]), not on the primary tree."
    rc=1
  fi
fi
# /govkit:branch-guard


# ---- the shards-to-builds STRAGGLER guard (TOOL-dDerivedDocket-13) -------------------------------
# Refuse a commit that stages an authored backlog shard or a family-named backlog archive on a
# branch that predates the per-build backlog, once the DEFAULT branch has flipped to it. Such an
# edit is not mergeable: the builds side no longer authors the file, so a clean three-way merge
# takes a side and neither outcome is a conflict. The recipe printed here is how it is relocated.
#
# SOURCED THROUGH THIS HOOK'S OWN DIRECTORY, never through the committing tree — a pre-flip branch
# carries the old kit and no straggler rule, so a rule resolved through `$top` could never reach the
# branch it is about. Absent, every line below is skipped: that is the state of every adopter that
# took the hooks and not the gov-only library, and of every repository before the flip.
#
# IT SITS ABOVE THE LEGS deliberately. An operator who is about to be told to relocate should be
# told before paying for three gates. Nothing here unpins an install-prefix waiver: the `gate_at`
# probe below carries an in-line `gov:root-fixture` marker as of this unit, not a position-keyed row.
_sg="$(cd "$(dirname "$0")" && pwd)/straggler-guard.sh"
if [ -f "$_sg" ] && . "$_sg" && command -v init_straggler_guard >/dev/null 2>&1 &&
   init_straggler_guard; then
  _sg_head=$(git rev-parse --verify --quiet HEAD 2>/dev/null || true)
  if [ -n "$_sg_head" ] && check_preflip "$_sg_head"; then
    if check_staged_backlog; then
      # The RELOCATION MERGE is this shape too — restored views staged on a pre-flip branch — and it
      # carries a builds-mode MERGE_HEAD, which is what tells the two apart. Refusing it would make
      # the recipe's own last step impossible; `commit-msg` audits that merge instead.
      if ! check_merge_head_builds; then
        echo "pre-commit: REFUSING — this branch predates the per-build backlog and this commit stages an"
        echo "  authored backlog shard or a family-named backlog archive. Merged later, that edit can drop"
        echo "  a row with nothing able to say which one. Relocate it instead:"
        print_recipe "  "
        echo "  Deliberate override, as always: git commit --no-verify"
        rc=1
      fi
    elif check_has_delta "$_sg_head"; then
      echo "pre-commit: note — this branch still owes a relocation of its backlog rows before it merges; the memory-tree kit's migrate_backlog.py --recipe prints the three commands."
    else
      echo "pre-commit: note — the default branch has moved to the per-build backlog; merge it before filing a new ask, so the ask lands in this build's own BACKLOG.md."
    fi
  fi
fi


# Locate a gate whose kit prefix is not fixed. A leg guarded on ONE literal path silently vanishes in
# any tree that installs the kit elsewhere, and the hook still exits 0 — measured: a repo that copies
# .githooks/ per the runbook but installs its kits at another prefix got a pre-commit where all three
# legs skipped and reported success. Finding nothing is a real skip; finding it somewhere else and
# doing nothing is not.
#
# THE LADDER — TOOL-aRepatriatedFork-24 S1. The fix above was a candidate LIST, gov's prefix then the
# root, so `scripts/` or `vendor/gov/` still skipped every leg silently. Each gate is now resolved by
# the ladder `.githooks/pre-push` walks, and `check-wiring.sh` before both:
#   1. the install receipt: the `.governance/install.json` row whose source ends in <kit>/<file>, the
#      only record of a prefix nobody could guess;
#   2. `resolve_kit_dir`'s probe from the repo root: <home>/<file>, then <kit>/<file>, the root install;
#   3. `GOV_KITROOT`, declared in `.githooks/gate-env.sh`: <GOV_KITROOT>/<kit>/<file>.
# That file is READ for its one assignment and never sourced. This hook does not vet it the way
# pre-push does, so running it here would run whatever an untracked copy says.
# A MISS IS AN ANNOUNCED SKIP here (owner, F1 (c)): these legs are an early signal, and a commit hook
# that blocked on an absent kit would stop ordinary work. The push boundary is where a miss refuses.
kitroot_declared=""
if [ -f .githooks/gate-env.sh ]; then
  kitroot_declared=$(grep -E '^[[:space:]]*(export[[:space:]]+)?GOV_KITROOT=' .githooks/gate-env.sh | tail -n 1 |
                     sed 's/^[^=]*=//; s/[[:space:]]*#.*$//' | tr -d "\"'\r")
  kitroot_declared=${kitroot_declared%/}
  case "$kitroot_declared" in /*|*..*|*[!A-Za-z0-9._/-]*) kitroot_declared="" ;; esac
fi
read_receipt_path() { # <kit dir, or ""> <file> -> the repo-relative path the install receipt records ("" if none)
  [ -f .governance/install.json ] || return 0
  awk -v want="${1:+$1/}$2" '
    function val(l) { sub(/^[^:]*:[[:space:]]*"/, "", l); sub(/".*$/, "", l); return l }
    /^[[:space:]]*\{[[:space:]]*$/          { p = ""; s = ""; next }
    /^[[:space:]]*"path"[[:space:]]*:/      { p = val($0); next }
    /^[[:space:]]*"source"[[:space:]]*:/    { s = val($0); next }
    /^[[:space:]]*\}[[:space:]]*,?[[:space:]]*$/ {
      if (p != "" && (s == want || (length(s) > length(want) && substr(s, length(s) - length(want)) == "/" want)) \
          && p !~ /^\// && p !~ /^[A-Za-z]:/ && p !~ /(^|\/)\.\.(\/|$)/) { print p; exit }
      p = ""; s = ""
    }' .governance/install.json 2>/dev/null
}
resolve_kit_gate() { # <kit dir, or "" for a file at the tool root> <file> [home] -> the gate's path, or rc 1
  local rel=${1:+$1/}$2 c
  c=$(read_receipt_path "$1" "$2"); [ -n "$c" ] && [ -f "$c" ] && { echo "$c"; return 0; }
  for c in ${3:+"$3/$2"} "$rel"; do [ -f "$c" ] && { echo "$c"; return 0; }; done
  [ -n "$kitroot_declared" ] && [ -f "$kitroot_declared/$rel" ] && { echo "$kitroot_declared/$rel"; return 0; }
  return 1
}
print_kit_miss() { # <leg> <kit dir, or ""> <file> [home] -> the announced skip, naming every rung that missed
  local rel=${2:+$2/}$3
  echo "pre-commit: $1 leg SKIPPED — no kit root: no install-receipt row for $rel, no ${4:+$4/$3 or }$rel at the root, and ${kitroot_declared:+no $rel under GOV_KITROOT=$kitroot_declared}${kitroot_declared:-no GOV_KITROOT declared in .githooks/gate-env.sh}."
}

# ONE staged read and ONE python resolution per hook run (TOOL-aMeasuredDrag-10). Each leg below
# tests a flag set here from one read of the REAL index, with the pattern its own pathspec used:
# `--no-renames` lists a rename as D plus A, which is what a pathspec, applied before rename pairing,
# saw. Git C-quotes a non-ASCII name, so a trigger matches the name with its quotes stripped, and
# `st_names` keeps git's spelling for the policy guard's `grep -xF`. The guard reads the index git
# HANDED the hook: on a plain commit that is the real index under another spelling (an 8.3 short
# path), so `-ef` and not a string compare decides it, and under `commit -a` or `commit <path>` it is
# a temporary index the guard reads itself. Only a resolved launcher is kept, so a failed resolution
# runs again at the next leg and prints its diagnosis there as it did.
st_list=$(git diff --cached --name-status --no-renames)
st_names="" st_memory=""
while IFS=$'\t' read -r st_status st_path; do
  [ -n "$st_path" ] || continue
  st_names+=$st_path$'\n'
  st_bare=$st_path; case $st_bare in \"*\") st_bare=${st_bare#\"}; st_bare=${st_bare%\"} ;; esac
  case $st_status:$st_bare in [AM]:memory/*) st_memory=1 ;; esac
done <<< "$st_list"
read_hook_staged() { # the names staged in the index git handed this hook (TOOL-dGroundRules-72)
  if [ -z "$hook_index" ] || [ "$hook_index" -ef "${gd:-}/index" ]; then printf '%s' "$st_names"
  else with_hook_index git diff --cached --name-only --no-renames; fi
}
hook_py=""
resolve_hook_python() { # -> py; rc 1 when no tracked resolver or no usable launcher
  local r p
  if [ -z "$hook_py" ]; then
    r=$(git ls-files -- '*resolve-python.sh' | head -n 1)
    [ -n "$r" ] && . "./$r" && p=$(resolve_python) || return 1
    hook_py=$p
  fi
  py=$hook_py
}

# policy guard (TOOL-dGroundRules-6) — the guard over the paths the policy kit's guarded-paths.txt
# lists at HEAD. The verdict it runs is the loop kit's guard.py --staged wherever that resolves
# (TOOL-dDeclaredLoop-2 S11): it reads policy-file.guard and the floor at the landed revision, asks a
# change record of every change, and wraps the minimal guard below, whose admitted shapes, a cap raised,
# the mirror's render and a live run's branch, it keeps. Where the loop kit does not resolve, the
# minimal guard runs alone, as it did before the loop kit's guard landed.
# Git sends a hook's stdout to stderr and leaves stderr as the committer's, so `[ -t 2 ]` reads
# whether a person sits at a terminal, which an agent's shell does not. It stops forgetting, not
# evasion: the guard's header names what passes it. The guard runs only when a listed path is
# staged, so an ordinary commit spawns no Python; a kit that resolves nowhere has no list to guard,
# and the block prints nothing. ABOVE THE LEGS, so a refused commit is told before paying for them.
# A MISSING LAUNCHER REFUSES, unlike the legs' announced skip: this block is the enforcement, not
# an early signal. SO DOES A MISSING GUARD (TOOL-dGroundRules-21 S21): a `guard.py` no rung resolves,
# while the list at HEAD under the declared GOV_KITROOT names a staged path, prints the rungs that
# missed and refuses, so a deleted guard never reads as a clean commit.
lg_kit=loop     # the loop kit, named once as pg_kit names the policy kit (TOOL-dDeclaredLoop-2 S11)
lg=$(resolve_kit_gate "$lg_kit" guard.py) || lg=""
pg_kit=policy   # named once, so no guard path below spells the kit's directory (TOOL-dGroundRules-84)
if g=$(resolve_kit_gate "$pg_kit" guard.py); then
  pg_list=$(git show "HEAD:${g%guard.py}guarded-paths.txt" 2>/dev/null | tr -d '\r' |
            sed -e 's/^[[:space:]]*//' -e 's/[[:space:]]*$//' | grep -vE '^(#|$)' || true)
  pg_hit=""
  [ -z "$pg_list" ] || pg_hit=$(read_hook_staged | grep -xF -- "$pg_list" || true)
  if [ -n "$pg_hit" ]; then
    pg_names="${pg_hit//$'\n'/ } "
    if [ -t 2 ]; then
      echo "pre-commit: policy guard — ${pg_names}staged, admitted on the owner's terminal proof."
    elif ! resolve_hook_python; then
      echo "pre-commit: policy guard REFUSING — ${pg_names}staged and no python launcher to judge them."
      rc=1
    elif ! with_hook_index "$py" "${lg:-$g}" --staged; then
      rc=1
    fi
  fi
else
  pg_list=$(git show "HEAD:${kitroot_declared:+$kitroot_declared/}$pg_kit/guarded-paths.txt" 2>/dev/null | tr -d '\r' |
            sed -e 's/^[[:space:]]*//' -e 's/[[:space:]]*$//' | grep -vE '^(#|$)' || true)
  if [ -n "$pg_list" ] && read_hook_staged | grep -qxF -- "$pg_list"; then
    print_kit_miss "policy guard" "$pg_kit" guard.py
    echo "pre-commit: policy guard REFUSING — a guarded path is staged and no guard.py resolves to judge it."
    rc=1
  fi
fi

# memory-tree hygiene, staged leg — only when memory/ is touched
if [ -n "$st_memory" ]; then
  if g=$(resolve_kit_gate memory-tree check-memory-hygiene.sh); then
    # A CHECK 9 REFUSAL RENDERS ITSELF (TOOL-aTrimmedWait-3): the leg's output is captured, and when it
    # failed on a `HYGIENE check 9 FAILED` line the generator's `--write-staged` renders the moved index
    # artifacts into the index git handed this hook. Its 0 means it staged one, and the leg grades
    # again; that run decides. memory.staged-render off, a declined render, any other failure or a
    # generator or launcher that does not resolve refuses as before. The output prints after the run.
    hy_out=$(bash "$g" --staged); hy_rc=$?
    [ -z "$hy_out" ] || printf '%s\n' "$hy_out"
    if [ "$hy_rc" != 0 ]; then
      if [[ $'\n'$hy_out == *$'\n''HYGIENE check 9 FAILED'* ]] \
          && gb=$(resolve_kit_gate memory-tree gen_build_index.py) \
          && resolve_hook_python \
          && with_hook_index "$py" "$gb" --write-staged; then
        echo "pre-commit: the build index was rendered and staged; grading the memory hygiene leg again."
        bash "$g" --staged || rc=1
      else
        rc=1
      fi
    fi
  else
    print_kit_miss "memory-tree hygiene" memory-tree check-memory-hygiene.sh
  fi
else
  # THE RED-FIX JOIN'S STAGED FORM, on a commit that stages NO memory path (TOOL-aNimbleMend-15 S12).
  # The hygiene leg above runs the join as its check 31, and only beside a staged memory path, so a
  # product-only commit on top of an unrecorded `Red-fix:` commit was not refused and the fix sat
  # below HEAD until the next full hygiene run. The join grades HEAD alone here: one `git log -1`.
  # The launcher is the tracked resolver the policy guard above sources. A kit or a launcher that
  # does not resolve is an announced skip, as for every leg of this hook.
  if g=$(resolve_kit_gate memory-tree build_records.py); then
    if ! resolve_hook_python; then
      echo "pre-commit: red-fix join leg SKIPPED — no tracked python resolver, or no usable launcher, to run $g."
    elif ! "$py" "$g" join red-fix --staged; then
      rc=1
    fi
  else
    print_kit_miss "red-fix join" memory-tree build_records.py
  fi
fi

# THE DERIVED LEGS (TOOL-dWitnessedBar-10 S4). No leg is named here: every row of the leg manifest
# carrying `precommit` runs through the run-gates kit's `--precommit`, when a staged path trips the
# row's `guard` or at every commit when it has none, so a leg declares its own commit-time argv beside
# its bar argv and reaches this hook with no edit to it (memory/gotchas/hand-named-gate-list-green-
# while-the-bar-reds.md). The memory hygiene block above stays hand-named: its commit-time form is a
# grade, a check-9 render and a regrade that no one argv states. It runs outside `with_hook_index`, as
# the legs it replaced did, and a runner no rung resolves is an announced skip, as for every leg here.
if g=$(resolve_kit_gate run-gates run-gates.sh); then
  bash "$g" --precommit || rc=1
else
  print_kit_miss "derived pre-commit" run-gates run-gates.sh
fi

[ "$rc" = 0 ] || echo "pre-commit: a gate failed — fix or 'git commit --no-verify' to override deliberately."
exit "$rc"
