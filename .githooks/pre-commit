#!/usr/bin/env bash
# coding-governance pre-commit fast leg. Install once per clone: git config core.hooksPath .githooks
# Runs only the cheap staged-scoped gates so a scripts-less checkout stays green.
set -u

# S2/S5 (TOOL-dScrubbedConduit-1), same two fixes as .githooks/pre-push and for the same reasons.
# GIT_EXEC_PATH is deliberately kept.
unset GIT_DIR GIT_WORK_TREE GIT_INDEX_FILE GIT_OBJECT_DIRECTORY GIT_ALTERNATE_OBJECT_DIRECTORIES       GIT_COMMON_DIR GIT_NAMESPACE GIT_PREFIX

if ! top=$(git rev-parse --show-toplevel 2>/dev/null); then
  echo "pre-commit: REFUSING — cannot resolve this repository's work tree, so the staged gates" >&2
  echo "  cannot run. This used to exit 0 (ALLOW). Override: git commit --no-verify" >&2
  exit 1
fi
cd "$top" || exit 1
rc=0

# govkit:branch-guard
# Branch guard — refuse a commit in the PRIMARY tree while parked off the default branch.
# Feature work belongs in a sibling worktree, not by stranding the primary tree on a branch
# (playbook §3). Default branch: origin/HEAD, else main; pin with GOV_DEFAULT_BRANCH. Override: --no-verify.
gd=$(git rev-parse --path-format=absolute --git-dir 2>/dev/null)
gc=$(git rev-parse --path-format=absolute --git-common-dir 2>/dev/null)
if [ -n "$gd" ] && [ "$gd" = "$gc" ]; then          # primary tree, not a linked worktree
  def=$(git symbolic-ref --short refs/remotes/origin/HEAD 2>/dev/null); def=${def#origin/}
  def=${GOV_DEFAULT_BRANCH:-${def:-main}}
  branch=$(git symbolic-ref --short HEAD 2>/dev/null || true)
  if [ -n "$branch" ] && [ "$branch" != "$def" ]; then
    echo "pre-commit: refusing a commit in the primary tree while on '$branch' (default: '$def')."
    echo "  Feature work belongs in a sibling worktree (playbook §3), not on the primary tree."
    rc=1
  fi
fi
# /govkit:branch-guard


# Locate a gate whose kit prefix is not fixed. A leg guarded on ONE literal path silently vanishes in
# any tree that installs the kit elsewhere, and the hook still exits 0 — measured: a repo that copies
# .githooks/ per the runbook but installs its kits at another prefix got a pre-commit where all three
# legs skipped and reported success. Finding nothing is a real skip; finding it somewhere else and
# doing nothing is not.
gate_at() { # $1... candidate paths, most-likely first
  for c in "$@"; do [ -f "$c" ] && { echo "$c"; return 0; }; done
  return 1
}

# memory-tree hygiene, staged leg — only when memory/ is touched
if g=$(gate_at tools/memory-tree/check-memory-hygiene.sh memory-tree/check-memory-hygiene.sh) &&
   git diff --cached --name-only --diff-filter=ACMR -- 'memory/**' | grep -q .; then
  bash "$g" --staged || rc=1
fi

# kickoff-manifest ratchet, staged leg — only when a watched file is staged
if g=$(gate_at tools/manifest-check.sh skills/session-kickoff/manifest-check.sh scripts/manifest-check.sh); then
  bash "$g" --staged || rc=1
fi

# template size — only when the template is staged
if g=$(gate_at tools/check-template-size.sh check-template-size.sh) &&
   git diff --cached --name-only -- coding-governance-agents.template.md | grep -q .; then
  bash "$g" || rc=1
fi

# codebase-map coverage + freshness — only when .codebase-map.conf exists and a staged path is a .py
# or .js file. The bar runs this same gate on every run (its leg in the gate manifest has no guard) and
# nothing before the push boundary did, so a module-level def committed without a regen travelled
# until a closing review found it. memory/gotchas/hand-named-gate-list-green-while-the-bar-reds.md
# records the builds it hit, and the rest of the class this leg does not reach. About 1.5 s. Quiet on
# a pass except for the gate's lines that are not `ok`, so its UNGRADED and skipped-tier announcements
# stay visible.
# EVERY PATH IS DERIVED. This file is carried into adopters, where a kit-path literal resolves to
# nothing at another prefix. The gate and the map root come from the conf, sourced the way the kit
# documents bash reads it; the python resolver comes from the tracked tree. An empty derivation refuses.
# WHAT THIS LEG DOES NOT CHECK:
# - Only .py and .js trigger it, the two populations the symbol tier reads. The map's other
#   inventories and a dossier claim edit move its artifacts too, and a commit staging only those
#   still reds first at the bar.
# - It grades the WORKTREE, not the index, so an unstaged edit to a mapped file can move the verdict
#   either way. The one mismatch it closes is its own remedy's: artifacts regenerated and not staged.
if [ -f .codebase-map.conf ] && git diff --cached --name-only -- '*.py' '*.js' | grep -q .; then
  g=$(. ./.codebase-map.conf >/dev/null 2>&1; printf '%s' "${GATE_FILE:-}")
  r=$(git ls-files -- '*resolve-python.sh' | head -n 1)
  if [ -z "$g" ] || [ ! -f "$g" ]; then
    echo "pre-commit: codebase-map leg REFUSING — GATE_FILE in .codebase-map.conf names no file: '$g'."
    rc=1
  elif [ -z "$r" ] || ! . "./$r" || ! py=$(resolve_python); then
    echo "pre-commit: codebase-map leg cannot run $g — no tracked python resolver, or no usable launcher."
    rc=1
  elif ! out=$("$py" "$g" 2>&1); then
    printf '%s\n' "$out"
    echo "pre-commit: codebase-map gate failed. STALE artifact: run the regen its STALE line names"
    echo "  (gen_map.py --write), then stage what it rewrote. UNCLAIMED key: claim it in a dossier."
    rc=1
  else
    printf '%s\n' "$out" | grep -v '^ok ' || true
    mr=$(. ./.codebase-map.conf >/dev/null 2>&1; printf '%s' "${MAP_ROOT:-}")
    if [ -z "$mr" ] || [ ! -d "$mr/generated" ]; then
      echo "pre-commit: codebase-map leg did NOT check for unstaged regenerated artifacts —"
      echo "  .codebase-map.conf names no MAP_ROOT with a generated/ directory."
    elif unstaged=$(git diff --name-only -- "$mr/generated/") && [ -n "$unstaged" ]; then
      echo "pre-commit: the codebase-map artifacts are fresh in the worktree but NOT staged, so this commit"
      echo "  carries the stale copies. Stage them:"
      printf '%s\n' "$unstaged" | sed 's/^/    /'
      rc=1
    fi
  fi
fi

[ "$rc" = 0 ] || echo "pre-commit: a gate failed — fix or 'git commit --no-verify' to override deliberately."
exit "$rc"
